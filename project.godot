; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="강남드림"
config/description="대한민국 현대를 배경으로 한 인터랙티브 드라마 / 라이프 시뮬레이션"
run/main_scene="res://scenes/SplashScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/logos/gangnam_dream_logo_concept.png"
config/icon="res://icon.png"

[autoload]

UIStyle="*res://autoloads/UIStyle.gd"
LocaleManager="*res://autoloads/LocaleManager.gd"
DataRegistry="*res://autoloads/DataRegistry.gd"
GameState="*res://autoloads/GameState.gd"
ImageRegistry="*res://autoloads/ImageRegistry.gd"
EventManager="*res://autoloads/EventManager.gd"
NewsManager="*res://autoloads/NewsManager.gd"
MetaProgression="*res://autoloads/MetaProgression.gd"
SaveManager="*res://autoloads/SaveManager.gd"
AudioManager="*res://autoloads/AudioManager.gd"
BGMPlayer="*res://autoloads/BGMPlayer.gd"
SceneTransition="*res://autoloads/SceneTransition.gd"
DisplayManager="*res://autoloads/DisplayManager.gd"
ControllerHints="*res://autoloads/ControllerHints.gd"
EndingSystem="*res://systems/EndingSystem.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

