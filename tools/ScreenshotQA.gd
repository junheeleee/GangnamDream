	await _save("i18n_layout_%s" % lang.replace("-", "_"), 0.0)
	var normalized_lang := LocaleManager.normalize_language(lang)
	if normalized_lang in ["ko", "en", "ja", "zh-CN", "zh-TW"]:
		var probe := _order97_i18n_format_probe(normalized_lang)
