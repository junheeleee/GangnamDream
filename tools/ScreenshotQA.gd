func _prepare_father_peak_qa_state() -> void:
	_prepare_main_game_state()
	GameState.mental = 60
	GameState.intelligence = 40
	GameState.moral_tint = 0.0
	for flag in [
		"saw_father_medical", "father_passed", "visited_father", "father_visit_deferred",
	]:
