; ORDER-103 staging-only project. The product project.godot is never overwritten.
config_version=5

[application]

config/name="GangnamDream-ORDER103-M01M06-ChoicePlaytest"
config/description="Gangnam Dream ORDER-103 standalone M01-M06 choice playtest"
config/version="0.1.0-dev"
run/main_scene="res://order103/Entry.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="GangnamDream_ORDER103_M01M06_v1"
boot_splash/show_image=false

[autoload]

AudioManager="*res://order103/AudioManagerStub.gd"
UIStyle="*res://autoloads/UIStyle.gd"

[debug]

file_logging/enable_file_logging=false

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
