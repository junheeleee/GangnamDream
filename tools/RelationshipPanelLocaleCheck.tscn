[sub_resource type="GDScript" id="GDScript_check"]
script/source = "extends Node\n## ORDER-240: actual-node/function regression; no rendered/native/full-play claim.\n## Pre-code source/roster SHA 752a161a87cc53316f89badfa1731169d6c2eb74c15861dfae04cad3d5058544.\n## Approved target table SHA e15b3ac750de17740d616033ce89ece5c32c57b4062fb778cb86b1954aea1c01.\n## Table EN 'Bond / Connection' is a reference only; callers freeze Bond and Connection separately.\n## Language approval is not engine/run approval; use the coordinated isolated wrapper lane.\nconst FIXTURE_APPROVED := true\nconst MAIN_GAME := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES = [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst ROWS = [\n\t{\"ko\":\"관계\",\"en\":\"Relations\",\"ja\":\"人間関係\",\"zh-CN\":\"人际关系\",\"zh-TW\":\"人際關係\"},\n\t{\"ko\":\"내 사람들\",\"en\":\"Relationships\",\"ja\":\"関わりのある人たち\",\"zh-CN\":\"我身边的人\",\"zh-TW\":\"我身邊的人\"},\n\t{\"ko\":\"아직 기록된 인연이 없습니다. 이야기를 진행하며 맺은 인연이 여기에 표시됩니다.\",\"en\":\"No connections recorded yet. Connections formed through the story appear here.\",\"ja\":\"まだ記録された縁はありません。物語を進める中で結んだ縁が、ここに表示されます。\",\"zh-CN\":\"还没有记录下来的人际关系。故事中结下的缘分会显示在这里。\",\"zh-TW\":\"目前還沒有記錄下來的人際關係。隨著故事發展結下的緣分，會顯示在這裡。\"},\n\t{\"ko\":\"호감\",\"en\":\"Aff.\",\"ja\":\"好感度\",\"zh-CN\":\"好感\",\"zh-TW\":\"好感\"},\n\t{\"ko\":\"신뢰\",\"en\":\"Trust\",\"ja\":\"信頼\",\"zh-CN\":\"信任\",\"zh-TW\":\"信任\"},\n\t{\"ko\":\"연애 관련\",\"en\":\"Romance\",\"ja\":\"恋愛関連\",\"zh-CN\":\"恋爱相关\",\"zh-TW\":\"戀愛相關\"},\n\t{\"ko\":\"멘토\",\"en\":\"Mentor\",\"ja\":\"メンター\",\"zh-CN\":\"导师\",\"zh-TW\":\"導師\"},\n\t{\"ko\":\"비즈니스\",\"en\":\"Business\",\"ja\":\"ビジネス\",\"zh-CN\":\"商业往来\",\"zh-TW\":\"商務往來\"},\n\t{\"ko\":\"친구\",\"en\":\"Friend\",\"ja\":\"友達\",\"zh-CN\":\"朋友\",\"zh-TW\":\"朋友\"},\n\t{\"ko\":\"인연\",\"en\":\"Bond / Connection\",\"ja\":\"縁\",\"zh-CN\":\"缘分\",\"zh-TW\":\"緣分\"},\n\t{\"ko\":\"힘든 밤과 생활비를 함께 상의하는 사이\",\"en\":\"Someone who shares hard nights and talks through living costs\",\"ja\":\"つらい夜と生活費のことを一緒に相談できる間柄\",\"zh-CN\":\"能一起聊难熬的夜晚，也能商量生活开销的人\",\"zh-TW\":\"能一起聊難熬的夜晚、商量生活開銷的人\"},\n\t{\"ko\":\"지친 날 먼저 안부를 묻는 사이\",\"en\":\"Someone who asks first on exhausting days\",\"ja\":\"疲れた日に先に近況を尋ねてくれる間柄\",\"zh-CN\":\"在疲惫的日子里，会主动问候的人\",\"zh-TW\":\"疲憊時會主動問候的人\"},\n\t{\"ko\":\"가끔 먼저 연락이 오는 사이\",\"en\":\"Someone who sometimes reaches out first\",\"ja\":\"ときどき向こうから連絡が来る間柄\",\"zh-CN\":\"偶尔会主动联系你的人\",\"zh-TW\":\"偶爾會主動聯絡你的人\"},\n\t{\"ko\":\"다음 투자를 함께 읽고 이유까지 묻는 사람\",\"en\":\"Someone who reads the next investment with you and asks why\",\"ja\":\"次の投資を一緒に検討し、理由まで尋ねる人\",\"zh-CN\":\"会一起分析下一笔投资，还会追问理由的人\",\"zh-TW\":\"會一起研究下一項投資，也會追問理由的人\"},\n\t{\"ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\",\"en\":\"Someone you can ask about what you have studied\",\"ja\":\"学んだことをもう一度質問できる相手\",\"zh-CN\":\"能再次请教所学内容的人\",\"zh-TW\":\"能再請教學過內容的人\"},\n\t{\"ko\":\"읽어 볼 것을 가끔 건네는 사람\",\"en\":\"Someone who occasionally sends something worth reading\",\"ja\":\"ときどき読み物を送ってくれる人\",\"zh-CN\":\"偶尔会递来一些读物的人\",\"zh-TW\":\"偶爾會遞來一些讀物的人\"},\n\t{\"ko\":\"이름을 걸고 수익 기회를 함께 검토하는 사이\",\"en\":\"Someone willing to put a name beside yours on an opportunity\",\"ja\":\"自分の名を懸けて、収益の機会を一緒に検討する間柄\",\"zh-CN\":\"愿意押上名声，一起评估获利机会的人\",\"zh-TW\":\"願意賭上自己的名聲，一起評估獲利機會的人\"},\n\t{\"ko\":\"작은 일거리를 먼저 묻는 사이\",\"en\":\"Someone who asks you first about a small piece of work\",\"ja\":\"小さな仕事のことを先に尋ねてくる間柄\",\"zh-CN\":\"会主动问起小活儿的人\",\"zh-TW\":\"會主動問起零星工作的人\"},\n\t{\"ko\":\"새 소식을 가끔 건네는 사이\",\"en\":\"Someone who occasionally passes along a lead\",\"ja\":\"ときどき新しい知らせを送ってくれる間柄\",\"zh-CN\":\"偶尔会带来新消息的人\",\"zh-TW\":\"偶爾會帶來新消息的人\"},\n\t{\"ko\":\"위기 때 먼저 전화하고 실제 비용도 함께 드는 가족\",\"en\":\"Family who call first in a crisis and share its real cost\",\"ja\":\"危機のときに先に電話をくれ、現実の費用も一緒に負担する家族\",\"zh-CN\":\"遇到危机时会主动打电话，也会分担实际开销的家人\",\"zh-TW\":\"遇上危機會先打電話，也會分擔實際開銷的家人\"},\n\t{\"ko\":\"말이 끊겨도 전화를 바로 끊지 않는 가족\",\"en\":\"Family who do not hang up when the words run out\",\"ja\":\"会話が途切れても、すぐには電話を切らない家族\",\"zh-CN\":\"话题断了也不会马上挂电话的家人\",\"zh-TW\":\"就算話接不下去，也不會立刻掛電話的家人\"},\n\t{\"ko\":\"먼저 연락하고 새로운 자리에 함께 가는 친구\",\"en\":\"A friend who reaches out first and goes somewhere new with you\",\"ja\":\"先に連絡して、新しい場にも一緒に行く友人\",\"zh-CN\":\"会主动联系你，一起去新场合的朋友\",\"zh-TW\":\"會主動聯絡你，也會一起去新場合的朋友\"},\n\t{\"ko\":\"늦은 답장도 기다려 주는 친구\",\"en\":\"A friend who waits through a late reply\",\"ja\":\"返信が遅れても待ってくれる友人\",\"zh-CN\":\"就算回复晚了也愿意等你的朋友\",\"zh-TW\":\"即使回覆得晚，也願意等你的朋友\"},\n\t{\"ko\":\"운명 공동체\",\"en\":\"Fate-bound\",\"ja\":\"運命共同体\",\"zh-CN\":\"命运共同体\",\"zh-TW\":\"命運共同體\"},\n\t{\"ko\":\"가까운 사이\",\"en\":\"Close\",\"ja\":\"親しい間柄\",\"zh-CN\":\"关系亲近\",\"zh-TW\":\"關係親近\"},\n\t{\"ko\":\"느슨한 인연\",\"en\":\"Loose Bond\",\"ja\":\"ゆるやかな縁\",\"zh-CN\":\"淡淡的交情\",\"zh-TW\":\"淡淡的交情\"},\n\t{\"ko\":\"불안한 관계\",\"en\":\"Unsteady\",\"ja\":\"不安定な関係\",\"zh-CN\":\"不稳的关系\",\"zh-TW\":\"不穩定的關係\"},\n\t{\"ko\":\"멀어진 관계\",\"en\":\"Distant\",\"ja\":\"遠ざかった関係\",\"zh-CN\":\"疏远的关系\",\"zh-TW\":\"疏遠的關係\"},\n\t{\"ko\":\"누군가\",\"en\":\"someone\",\"ja\":\"誰か\",\"zh-CN\":\"某人\",\"zh-TW\":\"某個人\"},\n\t{\"ko\":\"VIP 모임의 낯선 얼굴들 사이에서 먼저 인사를 건넸다. 떠날 때 한 사람이 다음 약속을 물었다.\",\"en\":\"Among unfamiliar faces at the VIP gathering, I introduced myself first. As I left, one person asked about meeting again.\",\"ja\":\"VIPの集まりで見知らぬ顔に囲まれながら、自分から挨拶した。帰り際、一人が次に会う予定を尋ねてきた。\",\"zh-CN\":\"在VIP聚会的陌生人中，我主动打了招呼。离开时，有个人问起了下次见面的事。\",\"zh-TW\":\"在VIP聚會的陌生面孔間，我先打了招呼。離開時，有個人問起下次見面的事。\"},\n]\nconst PREVIOUS_ROWS = [\n\t{\"ko\":\"가족\",\"en\":\"Family\",\"ja\":\"家族\",\"zh-CN\":\"家人\",\"zh-TW\":\"家人\"},\n\t{\"ko\":\"강남 인맥\",\"en\":\"Gangnam Contact\",\"ja\":\"カンナムの知り合い\",\"zh-CN\":\"江南人脉\",\"zh-TW\":\"江南人脈\"},\n\t{\"ko\":\"부모님\",\"en\":\"Parents\",\"ja\":\"両親\",\"zh-CN\":\"父母\",\"zh-TW\":\"父母\"},\n\t{\"ko\":\"사업 파트너\",\"en\":\"Business Partner\",\"ja\":\"ビジネスパートナー\",\"zh-CN\":\"生意伙伴\",\"zh-TW\":\"事業夥伴\"},\n\t{\"ko\":\"새벽 통화 친구\",\"en\":\"Late-night Phone Friend\",\"ja\":\"深夜に電話する友人\",\"zh-CN\":\"深夜通话的朋友\",\"zh-TW\":\"深夜通話的朋友\"},\n\t{\"ko\":\"소개팅 상대\",\"en\":\"Blind Date\",\"ja\":\"紹介された相手\",\"zh-CN\":\"介绍认识的约会对象\",\"zh-TW\":\"介紹認識的約會對象\"},\n\t{\"ko\":\"썸 상대\",\"en\":\"Romantic Interest\",\"ja\":\"気になる相手\",\"zh-CN\":\"暧昧对象\",\"zh-TW\":\"曖昧對象\"},\n\t{\"ko\":\"업계 지인\",\"en\":\"Industry Acquaintance\",\"ja\":\"業界の知り合い\",\"zh-CN\":\"业内熟人\",\"zh-TW\":\"業界熟人\"},\n\t{\"ko\":\"옆방 이웃\",\"en\":\"Next-door Neighbor\",\"ja\":\"隣の部屋の住人\",\"zh-CN\":\"隔壁房间的邻居\",\"zh-TW\":\"隔壁房間的鄰居\"},\n\t{\"ko\":\"인생 멘토\",\"en\":\"Life Mentor\",\"ja\":\"人生の師\",\"zh-CN\":\"人生导师\",\"zh-TW\":\"人生導師\"},\n\t{\"ko\":\"전 연인\",\"en\":\"Former Romantic Partner\",\"ja\":\"かつての恋人\",\"zh-CN\":\"前任恋人\",\"zh-TW\":\"前任戀人\"},\n\t{\"ko\":\"직장 선배\",\"en\":\"Senior Colleague\",\"ja\":\"職場の先輩\",\"zh-CN\":\"职场前辈\",\"zh-TW\":\"職場前輩\"},\n\t{\"ko\":\"친한 친구\",\"en\":\"Close Friend\",\"ja\":\"親しい友人\",\"zh-CN\":\"好友\",\"zh-TW\":\"好友\"},\n\t{\"ko\":\"카페 단골 친구\",\"en\":\"Friend at My Usual Café\",\"ja\":\"行きつけのカフェの友人\",\"zh-CN\":\"常去的咖啡店里认识的朋友\",\"zh-TW\":\"常去的咖啡店裡認識的朋友\"},\n\t{\"ko\":\"%s와의 관계가 끊어졌다.\",\"en\":\"Relationship with %s ended.\",\"ja\":\"%s との関係が断たれた。\",\"zh-CN\":\"与%s的关系断了。\",\"zh-TW\":\"與%s的關係斷了。\"},\n\t{\"ko\":\"%s: 생활비 분담 효과 +10만원\",\"en\":\"%s: shared living cost effect +100,000 won\",\"ja\":\"%s: 生活費分担効果 +10万ウォン\",\"zh-CN\":\"%s：分担生活费的效果 +10万韩元\",\"zh-TW\":\"%s：分攤生活費的效果 +10萬韓元\"},\n\t{\"ko\":\"%s 멘토: 투자 인사이트 +20만원 가치\",\"en\":\"%s mentor: investment insight worth 200,000 won\",\"ja\":\"%s メンター: 投資インサイト +20万ウォンの価値\",\"zh-CN\":\"%s导师：投资见解价值 +20万韩元\",\"zh-TW\":\"%s導師：投資見解價值 +20萬韓元\"},\n\t{\"ko\":\"%s: 비즈니스 파트너 수익 공유 +15만원\",\"en\":\"%s: business partner profit share +150,000 won\",\"ja\":\"%s: ビジネスパートナー利益共有 +15万ウォン\",\"zh-CN\":\"%s：生意伙伴分享收益 +15万韩元\",\"zh-TW\":\"%s：事業夥伴分享收益 +15萬韓元\"},\n\t{\"ko\":\"%s: 가족 지원금 +30만원\",\"en\":\"%s: family support +300,000 won\",\"ja\":\"%s: 家族支援金 +30万ウォン\",\"zh-CN\":\"%s：家人资助 +30万韩元\",\"zh-TW\":\"%s：家人資助 +30萬韓元\"},\n\t{\"ko\":\"VIP 모임에서 먼저 이름을 불러 준 사람들이 생겼다. 그 자리에 있던 사람: %s.\",\"en\":\"At the VIP gathering, people began greeting me by name. People there: %s.\",\"ja\":\"VIPの集まりで、先に名前を呼んでくれる人たちが現れた。その場にいた人：%s。\",\"zh-CN\":\"在VIP聚会上，有人开始主动叫我的名字。在场的人：%s。\",\"zh-TW\":\"在VIP聚會上，有人開始主動叫我的名字。在場的人：%s。\"},\n]\nconst HINT_CASES = [\n\t{\"kind\":\"romantic\",\"affection\":-1,\"trust\":80,\"helper_ko\":\"가끔 먼저 연락이 오는 사이\",\"card_ko\":\"\"},\n\t{\"kind\":\"romantic\",\"affection\":44,\"trust\":80,\"helper_ko\":\"가끔 먼저 연락이 오는 사이\",\"card_ko\":\"\"},\n\t{\"kind\":\"romantic\",\"affection\":45,\"trust\":80,\"helper_ko\":\"가끔 먼저 연락이 오는 사이\",\"card_ko\":\"가끔 먼저 연락이 오는 사이\"},\n\t{\"kind\":\"romantic\",\"affection\":59,\"trust\":80,\"helper_ko\":\"가끔 먼저 연락이 오는 사이\",\"card_ko\":\"가끔 먼저 연락이 오는 사이\"},\n\t{\"kind\":\"romantic\",\"affection\":60,\"trust\":80,\"helper_ko\":\"지친 날 먼저 안부를 묻는 사이\",\"card_ko\":\"지친 날 먼저 안부를 묻는 사이\"},\n\t{\"kind\":\"romantic\",\"affection\":79,\"trust\":80,\"helper_ko\":\"지친 날 먼저 안부를 묻는 사이\",\"card_ko\":\"지친 날 먼저 안부를 묻는 사이\"},\n\t{\"kind\":\"romantic\",\"affection\":80,\"trust\":80,\"helper_ko\":\"힘든 밤과 생활비를 함께 상의하는 사이\",\"card_ko\":\"힘든 밤과 생활비를 함께 상의하는 사이\"},\n\t{\"kind\":\"mentor\",\"affection\":-1,\"trust\":80,\"helper_ko\":\"읽어 볼 것을 가끔 건네는 사람\",\"card_ko\":\"\"},\n\t{\"kind\":\"mentor\",\"affection\":44,\"trust\":80,\"helper_ko\":\"읽어 볼 것을 가끔 건네는 사람\",\"card_ko\":\"\"},\n\t{\"kind\":\"mentor\",\"affection\":45,\"trust\":80,\"helper_ko\":\"읽어 볼 것을 가끔 건네는 사람\",\"card_ko\":\"읽어 볼 것을 가끔 건네는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":54,\"trust\":60,\"helper_ko\":\"읽어 볼 것을 가끔 건네는 사람\",\"card_ko\":\"읽어 볼 것을 가끔 건네는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":55,\"trust\":59,\"helper_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\",\"card_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":74,\"trust\":60,\"helper_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\",\"card_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":75,\"trust\":59,\"helper_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\",\"card_ko\":\"공부한 내용을 다시 물어볼 수 있는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":75,\"trust\":60,\"helper_ko\":\"다음 투자를 함께 읽고 이유까지 묻는 사람\",\"card_ko\":\"다음 투자를 함께 읽고 이유까지 묻는 사람\"},\n\t{\"kind\":\"mentor\",\"affection\":100,\"trust\":-1,\"helper_ko\":\"공부한 내용을 다시 물어볼 수 있