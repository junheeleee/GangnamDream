:80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"friends\",\"affection\":44,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"friends\",\"affection\":45,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"friends\",\"affection\":49,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"friends\",\"affection\":50,\"trust\":80,\"helper_ko\":\"늦은 답장도 기다려 주는 친구\",\"card_ko\":\"늦은 답장도 기다려 주는 친구\"},\n\t{\"kind\":\"friends\",\"affection\":69,\"trust\":80,\"helper_ko\":\"늦은 답장도 기다려 주는 친구\",\"card_ko\":\"늦은 답장도 기다려 주는 친구\"},\n\t{\"kind\":\"friends\",\"affection\":70,\"trust\":80,\"helper_ko\":\"먼저 연락하고 새로운 자리에 함께 가는 친구\",\"card_ko\":\"먼저 연락하고 새로운 자리에 함께 가는 친구\"},\n\t{\"kind\":\"\",\"affection\":85,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"unknown\",\"affection\":85,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"Romantic\",\"affection\":85,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n\t{\"kind\":\"romantic \",\"affection\":85,\"trust\":80,\"helper_ko\":\"\",\"card_ko\":\"\"},\n]\nconst METRIC_CASES = [\n\t{\"affection\":-5,\"trust\":-7,\"affinity_ko\":\"멀어진 관계\",\"display_affection\":\"-5\",\"display_trust\":\"-7\",\"bar_affection\":0,\"bar_trust\":0},\n\t{\"affection\":0,\"trust\":0,\"affinity_ko\":\"멀어진 관계\",\"display_affection\":\"0\",\"display_trust\":\"0\",\"bar_affection\":0,\"bar_trust\":0},\n\t{\"affection\":24,\"trust\":123,\"affinity_ko\":\"멀어진 관계\",\"display_affection\":\"24\",\"display_trust\":\"123\",\"bar_affection\":0.24,\"bar_trust\":1},\n\t{\"affection\":25,\"trust\":40,\"affinity_ko\":\"불안한 관계\",\"display_affection\":\"25\",\"display_trust\":\"40\",\"bar_affection\":0.25,\"bar_trust\":0.4},\n\t{\"affection\":44,\"trust\":40,\"affinity_ko\":\"불안한 관계\",\"display_affection\":\"44\",\"display_trust\":\"40\",\"bar_affection\":0.44,\"bar_trust\":0.4},\n\t{\"affection\":45,\"trust\":40,\"affinity_ko\":\"느슨한 인연\",\"display_affection\":\"45\",\"display_trust\":\"40\",\"bar_affection\":0.45,\"bar_trust\":0.4},\n\t{\"affection\":64,\"trust\":40,\"affinity_ko\":\"느슨한 인연\",\"display_affection\":\"64\",\"display_trust\":\"40\",\"bar_affection\":0.64,\"bar_trust\":0.4},\n\t{\"affection\":65,\"trust\":40,\"affinity_ko\":\"가까운 사이\",\"display_affection\":\"65\",\"display_trust\":\"40\",\"bar_affection\":0.65,\"bar_trust\":0.4},\n\t{\"affection\":84,\"trust\":40,\"affinity_ko\":\"가까운 사이\",\"display_affection\":\"84\",\"display_trust\":\"40\",\"bar_affection\":0.84,\"bar_trust\":0.4},\n\t{\"affection\":85,\"trust\":40,\"affinity_ko\":\"운명 공동체\",\"display_affection\":\"85\",\"display_trust\":\"40\",\"bar_affection\":0.85,\"bar_trust\":0.4},\n\t{\"affection\":100,\"trust\":100,\"affinity_ko\":\"운명 공동체\",\"display_affection\":\"100\",\"display_trust\":\"100\",\"bar_affection\":1,\"bar_trust\":1},\n\t{\"affection\":105,\"trust\":123,\"affinity_ko\":\"운명 공동체\",\"display_affection\":\"105\",\"display_trust\":\"123\",\"bar_affection\":1,\"bar_trust\":1},\n]\nconst TYPE_CASES = [\n\t[\"romantic\",\"연애 관련\",\"Romance\"],\n\t[\"mentor\",\"멘토\",\"Mentor\"],\n\t[\"business\",\"비즈니스\",\"Business\"],\n\t[\"family\",\"가족\",\"Family\"],\n\t[\"friends\",\"친구\",\"Friend\"],\n\t[\"unknown\",\"인연\",\"Bond\"],\n\t[\"\",\"인연\",\"Bond\"],\n]\nconst ROMANTIC_STAGES = [\n\t{\"id\":\"blind_date_match\",\"name\":\"소개팅 상대\",\"type\":\"romantic\",\"affection\":30,\"trust\":20},\n\t{\"id\":\"romantic_interest\",\"name\":\"썸 상대\",\"type\":\"romantic\",\"affection\":25,\"trust\":15},\n\t{\"id\":\"ex_partner\",\"name\":\"전 연인\",\"type\":\"romantic\",\"affection\":20,\"trust\":10},\n]\n\nvar _game: Control\nvar _system: Node\nvar _baseline: Dictionary = {}\nvar _case_count: int = 0\nvar _failures: Array[String] = []\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _run() -> void:\n\tif not _isolation() or not FIXTURE_APPROVED or ROWS.size() != 30:\n\t\tpush_error(\"RELATIONSHIP_PANEL_CHECK_FAIL isolation or reviewed fixture required\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tEngine.max_fps = 60\n\tawait _frames(3)\n\tGameState.start_new_game(\"QA Custom Player\", \"지방_상경\", \"none\", \"알바\", \"자유런\", \"현실\")\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_baseline = _state()\n\tfor locale in LOCALES:\n\t\t_restore_baseline()\n\t\tLocaleManager.set_language(locale)\n\t\tawait _frames(1)\n\t\t_game = MAIN_GAME.instantiate() as Control\n\t\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\t\tadd_child(_game)\n\t\tawait _frames(5)\n\t\t_system = _game.get(\"relationship_system\") as Node\n\t\tif not is_instance_valid(_system):\n\t\t\t_failures.append(str(locale) + \": actual RelationshipSystem absent\")\n\t\telse:\n\t\t\tawait _empty_surface(locale)\n\t\t\tawait _types(locale)\n\t\t\tawait _romantic_stages(locale)\n\t\t\tawait _names_custom(locale)\n\t\t\tawait _metrics_affinity(locale)\n\t\t\tfor kind in [\"romantic\", \"mentor\", \"business\", \"family\", \"friends\", \"unknown\"]:\n\t\t\t\tawait _hints(locale, kind)\n\t\t\tawait _ended_missing(locale)\n\t\t\tawait _passive_missing(locale)\n\t\t\tawait _vip(locale, false)\n\t\t\tawait _vip(locale, true)\n\t\t\tawait _save_language(locale)\n\t\tawait _shutdown()\n\t\t_game = null\n\t\t_system = null\n\t_restore_baseline()\n\tvar restored: bool = _state() == _baseline\n\tprint(\"RELATIONSHIP_PANEL_STATE_RESTORED=%d\" % int(restored))\n\tif not restored:\n\t\t_failures.append(\"in-memory pre-fixture GameState not restored\")\n\tif _case_count != 80:\n\t\t_failures.append(\"fixed 80 scenario groups required, got %d\" % _case_count)\n\tif not _failures.is_empty():\n\t\tfor failure in _failures:\n\t\t\tpush_error(\"RELATIONSHIP_PANEL_CHECK_FAIL \" + failure)\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"RELATIONSHIP_PANEL_CHECK_OK cases=80 locales=5 source_keys=30 hint_rows=43 isolation=preautoload rendered=0\")\n\tget_tree().quit(0)\n\nfunc _tx(ko: String, locale: String, english: String = \"\") -> String:\n\tif locale == \"ko\" or ko.is_empty():\n\t\treturn ko\n\tif locale == \"en\" and not english.is_empty():\n\t\treturn english\n\tfor row in ROWS + PREVIOUS_ROWS:\n\t\tif str(row[\"ko\"]) == ko:\n\t\t\tvar value: String = str(row[locale])\n\t\t\tif locale == \"en\" and value.contains(\"Bond / Connection\"):\n\t\t\t\t_failures.append(\"English contextual argument required: \" + ko)\n\t\t\treturn value\n\t_failures.append(\"frozen table key absent: \" + ko)\n\treturn \"<missing-frozen-key>\"\n\nfunc _projected(raw_name: String, locale: String) -> String:\n\tfor index in range(14):\n\t\tif str(PREVIOUS_ROWS[index][\"ko\"]) == raw_name:\n\t\t\treturn str(PREVIOUS_ROWS[index][locale])\n\treturn raw_name\n\nfunc _record(locale: String, family: String, actual: Variant, expected: Variant, state_ok: bool, details: Dictionary = {}) -> void:\n\tvar passed: bool = actual == expected and state_ok\n\t_case_count += 1\n\tif not passed:\n\t\t_failures.append(\"%s/%s actual=%s expected=%s state_ok=%s\" % [\n\t\t\tlocale, family, JSON.stringify(actual), JSON.stringify(expected), str(state_ok)])\n\tdetails = details.duplicate(true)\n\tdetails[\"relationships_after\"] = GameState.relationships.duplicate(true)\n\tdetails[\"action_log_after\"] = GameState.action_log.duplicate(true)\n\tdetails[\"player_name_after\"] = GameState.player_name\n\tdetails[\"state_after_sha256\"] = JSON.stringify(_state()).sha256_text()\n\tprint(\"RELATIONSHIP_PANEL_CASE \" + JSON.stringify({\n\t\t\"id\": locale + \"/\" + family, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": passed, \"state_ok\": state_ok, \"details\": details}))\n\nfunc _cards() -> Array:\n\t_game.call(\"_render_sidebars\")\n\tawait _frames(1)\n\tvar out: Array = []\n\tvar box: VBoxContainer = _game.get(\"relationship_box\")\n\tfor card in box.get_children():\n\t\tif not card is PanelContainer or card.is_queued_for_deletion():\n\t\t\tcontinue\n\t\tvar name_labels: Array = []\n\t\tfor node in card.find_children(\"*\", \"Label\", true, false):\n\t\t\tif node is Label and node.get_theme_font_size(\"font_size\") == 16:\n\t\t\t\tname_labels.append(node)\n\t\tif name_labels.size() != 1:\n\t\t\t_failures.append(\"actual card name-label cardinality %d\" % name_labels.size())\n\t\t\tout.append({\"error\": \"name-label cardinality\"})\n\t\t\tcontinue\n\t\tvar name_label: Label = name_labels[0]\n\t\tvar title: HBoxContainer = name_label.get_parent() as HBoxContainer\n\t\tvar body: VBoxContainer = title.get_parent() as VBoxContainer\n\t\tif body.get_child_count() < 4 or title.get_child_count() != 2:\n\t\t\t_failures.append(\"actual card structure differs\")\n\t\t\tout.append({\"error\": \"card structure\"})\n\t\t\tcontinue\n\t\tvar aff_row: HBoxContainer = body.get_child(2) as HBoxContainer\n\t\tvar trust_row: HBoxContainer = body.get_child(3) as HBoxContainer\n\t\tout.append({\n\t\t\t\"name\": name_label.text, \"type\": (title.get_child(1) as Label).text,\n\t\t\t\"affinity\": (body.get_child(1) as Label).text,\n\t\t\t\"affection_label\": (aff_row.get_child(0) as Label).text,\n\t\t\t\"affection_value\": (aff_row.get_child(2) as Label).text,\n\t\t\t\"trust_label\": (trust_row.get_child(0) as Label).text,\n\t\t\t\"trust_value\": (trust_row.get_child(2) as Label).text,\n\t\t\t\"affection_ratio\": (aff_row.get_child(1).get_child(0).get_child(0) as Control).anchor_right,\n\t\t\t\"trust_ratio\": (trust_row.get_child(1).get_child(0).get_child(0) as Control).anchor_right,\n\t\t\t\"hint\": (body.get_child(4) as Label).text if body.get_child_count() == 5 else \"\",\n\t\t\t\"body_children\": body.get_child_count()})\n\treturn out\n\nfunc _empty_surface(locale: String) -> void:\n\t_reset()\n\tvar before: Dictionary = _state()\n\t_game.call(\"_render_sidebars\")\n\tawait _frames(1)\n\tvar box: VBoxContainer = _game.get(\"relationship_box\")\n\tvar tabs: TabContainer = _game.get(\"info_tabs\")\n\tvar actual: Array = [tabs.get_tab_title(2), (box.get_child(0) as Label).text,\n\t\t(box.get_child(1).get_child(0) as Label).text, box.get_child_count()]\n\tvar expected: Array = [_tx(\"관계\", locale), _tx(\"내 사람들\", locale),\n\t\t_tx(\"아직 기록된 인연이 없습니다. 이야기를 진행하며 맺은 인연이 여기에 표시됩니다.\", locale), 2]\n\t_record(locale, \"empty_surface\", actual, expected, before == _state(),\n\t\t{\"actual_tab\": \"MainGame._build_info_panel fresh locale construction\", \"not_in_place_tab_refresh_claim\": true})\n\nfunc _types(locale: String) -> void:\n\t_reset()\n\tvar expected: Array = []\n\tvar direct: Array = []\n\tfor row in TYPE_CASES:\n\t\tGameState.relationships.append(_rel(\"Alice\", \"qa_\" + str(row[0]), str(row[0])))\n\t\texpected.append(_tx(row[1], locale, row[2]))\n\tvar before: Dictionary = _state()\n\tvar cards: Array = await _cards()\n\tvar actual: Array = []\n\tfor index in range(TYPE_CASES.size()):\n\t\tdirect.append(_game.call(\"_relationship_type_label\", TYPE_CASES[index][0]))\n\t\tactual.append(cards[index].get(\"type\"))\n\t_record(locale, \"types\", [actual, direct], [expected, expected], before == _state())\n\nfunc _romantic_stages(locale: String) -> void:\n\t_reset()\n\tfor row in ROMANTIC_STAGES:\n\t\tvar rel: Dictionary = row.duplicate(true)\n\t\trel[\"met_turn\"] = 1\n\t\tGameState.relationships.append(rel)\n\tvar before: Dictionary = _state()\n\tvar cards: Array = await _cards()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor index in range(ROMANTIC_STAGES.size()):\n\t\tactual.append([cards[index].get(\"name\"), cards[index].get(\"type\"), cards[index].get(\"hint\")])\n\t\texpected.append([_projected(str(ROMANTIC_STAGES[index][\"name\"]), locale), _tx(\"연애 관련\", locale), \"\"])\n\t_record(locale, \"romantic_stages\", actual, expected, before == _state(),\n\t\t{\"no_partner_stage_inference\": true, \"raw_types_ids_names_preserved\": GameState.relationships == before[\"relationships\"]})\n\nfunc _names_custom(locale: String) -> void:\n\t_reset()\n\tvar values: Array = []\n\tfor index in range(14):\n\t\tvalues.append(str(PREVIOUS_ROWS[index][\"ko\"]))\n\tvalues.append_array([\"Alice\", \"친한 친구 민수\", \" 친한 친구\", \"친한 친구 \", \"Family\", \"\", \"家族\"])\n\tvar expected: Array = []\n\tfor index in range(values.size()):\n\t\tGameState.relationships.append(_rel(values[index], \"qa_name_%d\" % index))\n\t\texpected.append(_projected(values[index], locale))\n\tvar missing: Dictionary = _rel(\"unused\", \"qa_missing\")\n\tmissing.erase(\"name\")\n\tGameState.relationships.append(missing)\n\texpected.append(\"?\")\n\tvar before: Dictionary = _state()\n\tvar cards: Array = await _cards()\n\tvar actual: Array = []\n\tfor card in cards:\n\t\tactual.append(card.get(\"name\"))\n\t_record(locale, \"names_custom\", actual, expected, before == _state())\n\nfunc _metrics_affinity(locale: String) -> void:\n\t_reset()\n\tfor index in range(METRIC_CASES.size()):\n\t\tvar row: Dictionary = METRIC_CASES[index]\n\t\tvar rel: Dictionary = _rel(\"Alice\", \"qa_metric_%d\" % index, \"unknown\")\n\t\trel[\"affection\"] = row[\"affection\"]\n\t\trel[\"trust\"] = row[\"trust\"]\n\t\tGameState.relationships.append(rel)\n\tvar before: Dictionary = _state()\n\tvar cards: Array = await _cards()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar bars_ok: bool = true\n\tfor index in range(METRIC_CASES.size()):\n\t\tvar row: Dictionary = METRIC_CASES[index]\n\t\tvar card: Dictionary = cards[index]\n\t\tactual.append([card.get(\"affection_label\"), card.get(\"affection_value\"), card.get(\"trust_label\"),\n\t\t\tcard.get(\"trust_value\"), card.get(\"affinity\"), _system.call(\"get_affinity_label\", row[\"affection\"])])\n\t\texpected.append([_tx(\"호감\", locale), row[\"display_affection\"], _tx(\"신뢰\", locale),\n\t\t\trow[\"display_trust\"], _tx(row[\"affinity_ko\"], locale), _tx(row[\"affinity_ko\"], locale)])\n\t\tbars_ok = bars_ok and is_equal_approx(float(card.get(\"affection_ratio\", -2)), float(row[\"bar_affection\"])) \\\n\t\t\tand is_equal_approx(float(card.get(\"trust_ratio\", -2)), float(row[\"bar_trust\"]))\n\t_record(locale, \"metrics_affinity\", actual, expected, before == _state() and bars_ok,\n\t\t{\"bars_preserve_existing_clamped_ratio\": bars_ok, \"numeric_text_preserves_unclamped_input\": true, \"cards\": cards})\n\nfunc _hints(locale: String, family: String) -> void:\n\t_reset()\n\tvar rows: Array = []\n\tfor row in HINT_CASES:\n\t\tvar belongs: bool = row[\"kind\"] == family if family != \"unknown\" else row[\"kind\"] in [\"\", \"unknown\", \"Romantic\", \"romantic \"]\n\t\tif belongs:\n\t\t\trows.append(row)\n\t\t\tvar rel: Dictionary = _rel(\"Alice\", \"qa_hint_%d\" % rows.size(), row[\"kind\"])\n\t\t\trel[\"affection\"] = row[\"affection\"]\n\t\t\trel[\"trust\"] = row[\"trust\"]\n\t\t\tGameState.relationships.append(rel)\n\tvar before: Dictionary = _state()\n\tvar cards: Array = await _cards()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor index in range(rows.size()):\n\t\tvar row: Dictionary = rows[index]\n\t\tactual.append([_game.call(\"_rel_effect_hint\", row[\"kind\"], row[\"affection\"], row[\"trust\"]), cards[index].get(\"hint\")])\n\t\texpected.append([_tx(row[\"helper_ko\"], locale), _tx(row[\"card_ko\"], locale)])\n\t_record(locale, \"hint_\" + family, actual, expected, before == _state(),\n\t\t{\"threshold_inputs\": rows, \"card_visibility_affection_gte45_distinct_from_helper\": true})\n\nfunc _ended_missing(locale: String) -> void:\n\t_reset()\n\tvar rel: Dictionary = _rel(\"unused\", \"qa_missing\")\n\trel.erase(\"name\")\n\trel[\"affection\"] = 1\n\trel[\"trust\"] = 1\n\tGameState.relationships = [rel]\n\tvar before: Dictionary = _state()\n\t_system.call(\"process_monthly_relationships\")\n\tvar after: Dictionary = _state()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\texpected_state[\"relationships\"] = []\n\texpected_state[\"action_log\"] = after[\"action_log\"]\n\tvar expected: Array = [_tx(str(PREVIOUS_ROWS[14][\"ko\"]), locale) % _tx(\"누군가\", locale, \"someone\")]\n\t_record(locale, \"ended_missing_name\", _messages_since(before), expected,\n\t\tafter == expected_state and _old_logs_exact(before), {\"actual_caller\": \"process_monthly_relationships\", \"missing_name_removal\": true})\n\nfunc _passive_missing(locale: String) -> void:\n\t_reset()\n\tvar rel: Dictionary = _rel(\"unused\", \"qa_missing\", \"mentor\")\n\trel.erase(\"name\")\n\trel[\"affection\"] = 90\n\trel[\"trust\"] = 80\n\tGameState.relationships = [rel]\n\tvar before: Dictionary = _state()\n\tseed(13)\n\tvar observed_roll: float = randf()\n\tseed(13)\n\t_system.call(\"_apply_passive\", GameState.relationships[0])\n\tvar after: Dictionary = _state()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\texpected_state[\"money\"] = 600000.0\n\texpected_state[\"investment_skill\"] = 21\n\texpected_state[\"intelligence\"] = 21\n\texpected_state[\"action_log\"] = after[\"action_log\"]\n\tvar expected: Array = [_tx(str(PREVIOUS_ROWS[16][\"ko\"]), locale) % _tx(\"인연\", locale, \"Connection\")]\n\t_record(locale, \"passive_missing_name\", _messages_since(before), expected,\n\t\tafter == expected_state and _old_logs_exact(before) and observed_roll < 0.20,\n\t\t{\"actual_caller\": \"_apply_passive\", \"seed\": 13, \"roll\": observed_roll,\n\t\t\"raw_missing_name_remains_missing\": not rel.has(\"name\"),\n\t\t\"state_before\": before, \"state_expected\": expected_state, \"state_after\": after,\n\t\t\"state_delta\": _state_delta(expected_state, after), \"setup_refresh_before_snapshot\": true})\n\nfunc _vip(locale: String, no_ap: bool) -> void:\n\t_reset()\n\tif no_ap:\n\t\tGameState.action_points = 0\n\tvar before: Dictionary = _state()\n\t_game.call(\"_ap_vip_network\")\n\tawait _frames(1)\n\tvar expected: Array = []\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tif not no_ap:\n\t\texpected = [_tx(\"VIP 모임의 낯선 얼굴들 사이에서 먼저 인사를 건넸다. 떠날 때 한 사람이 다음 약속을 물었다.\", locale)]\n\t\texpected_state[\"action_points\"] = 0\n\t\texpected_state[\"social_skill\"] = 23\n\t\texpected_state[\"reputation\"] = 22\n\t\texpected_state[\"tendency\"] = {\"career\": 4, \"invest\": 0, \"found\": 0}\n\t\texpected_state[\"action_axis_this_week\"] = {\"money\": 1, \"human\": 0}\n\t\texpected_state[\"action_places_this_week\"] = {\"city\": {\"count\": 1, \"money\": 1, \"human\": 0}}\n\t\texpected_state[\"recent_action_places\"] = [\"city\"]\n\t\texpected_state[\"action_records_this_week\"] = [{\"id\": \"vip_network\", \"axis\": \"money\",\n\t\t\t\"place\": \"city\", \"subject\": \"\", \"families\": [\"social\", \"network\", \"career\"]}]\n\texpected_state[\"action_log\"] = GameState.action_log.duplicate(true)\n\tvar after: Dictionary = _state()\n\tvar details: Dictionary = {\"actual_caller\": \"_ap_vip_network\",\n\t\t\"no_relationship_or_future_appointment_created\": GameState.relationships.is_empty()}\n\tif not no_ap:\n\t\tdetails.merge({\"state_before\": before, \"state_expected\": expected_state, \"state_after\": after,\n\t\t\t\"state_delta\": _state_delta(expected_state, after), \"setup_refresh_before_snapshot\": true})\n\t_record(locale, \"vip_no_ap\" if no_ap else \"vip_empty\", _messages_since(before), expected,\n\t\tafter == expected_state and _old_logs_exact(before), details)\n\nfunc _state_delta(expected: Dictionary, actual: Dictionary) -> Dictionary:\n\tvar delta: Dictionary = {}\n\tfor key in expected:\n\t\tif not actual.has(key) or expected[key] != actual[key] or typeof(expected[key]) != typeof(actual[key]):\n\t\t\tdelta[str(key)] = {\"expected\": expected[key], \"actual\": actual.get(key),\n\t\t\t\t\"expected_type\": typeof(expected[key]), \"actual_type\": typeof(actual.get(key)),\n\t\t\t\t\"actual_has_key\": actual.has(key)}\n\tfor key in actual:\n\t\tif not expected.has(key):\n\t\t\tdelta[str(key)] = {\"expected_has_key\": false, \"actual\": actual[key]}\n\treturn delta\n\nfunc _save_language(locale: String) -> void:\n\t_reset()\n\tGameState.relationships = [_rel(\"전 연인\", \"ex_partner\", \"romantic\"), _rel(\"Alice\", \"custom\")]\n\tvar original: Dictionary = _state()\n\tvar payload: Variant = JSON.parse_string(JSON.stringify(original))\n\t# Preserve independently captured parsed relationship/log payload BEFORE load.\n\t# This is not a check of all legacy save migrations or a physical save-file write.\n\tvar saved_relations: Array = (payload[\"relationships\"] as Array).duplicate(true)\n\tvar saved_logs: Array = (payload[\"action_log\"] as Array).duplicate(true)\n\tGameState.load_from_dict(payload)\n\tvar alternate: String = \"en\" if locale == \"ko\" else \"ko\"\n\tLocaleManager.set_language(alternate)\n\tawait _frames(1)\n\tvar other_cards: Array = await _cards()\n\tLocaleManager.set_language(locale)\n\tawait _frames(1)\n\tvar cards: Array = await _cards()\n\tvar actual: Array = [other_cards[0].get(\"name\"), other_cards[0].get(\"type\"), cards[0].get(\"name\"), cards[0].get(\"type\"), cards[1].get(\"name\")]\n\tvar expected: Array = [_projected(\"전 연인\", alternate), _tx(\"연애 관련\", alternate), _projected(\"전 연인\", locale), _tx(\"연애 관련\", locale), \"Alice\"]\n\tvar same: bool = GameState.relationships == saved_relations and GameState.action_log == saved_logs and GameState.player_name == \"QA Custom Player\"\n\t_record(locale, \"save_language\", actual, expected, same,\n\t\t{\"disk_save_calls\": 0, \"parsed_expected_fixed_before_load\": true,\n\t\t\"scope\": \"relationship/log/player-name JSON roundtrip, not all legacy migrations\",\n\t\t\"saved_relations_expected\": saved_relations, \"saved_logs_expected\": saved_logs,\n\t\t\"original_relations\": original[\"relationships\"]})\n\nfunc _isolation() -> bool:\n\tvar boot := get_tree().get_script() as Script\n\tvar qa_namespace := str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar regex := RegEx.new()\n\tif regex.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\") != OK:\n\t\treturn false\n\tvar valid: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand regex.search(qa_namespace) != null and OS.get_user_data_dir().get_file() == qa_namespace\n\tif valid:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=%s\" % OS.get_user_data_dir())\n\treturn valid\n\nfunc _state() -> Dictionary:\n\treturn GameState.serialize().duplicate(true)\n\nfunc _restore_baseline() -> void:\n\tfor key in _baseline:\n\t\tvar value: Variant = _baseline[key]\n\t\tif value is Dictionary or value is Array:\n\t\t\tvalue = value.duplicate(true)\n\t\tGameState.set(key, value)\n\nfunc _reset() -> void:\n\t_restore_baseline()\n\tGameState.relationships = []\n\tGameState.action_log = [{\"turn\": 1, \"date\": \"fixed historical date\", \"message\": \"친한 친구 — historical 家族\", \"type\": \"relationship\"}]\n\tGameState.money = 400000.0\n\tGameState.mental = 30\n\tGameState.social_skill = 20\n\tGameState.reputation = 20\n\tGameState.investment_skill = 20\n\tGameState.intelligence = 20\n\tGameState.action_points = 1\n\tGameState.max_action_points = 1\n\tGameState.tendency = {\"career\": 0, \"invest\": 0, \"found\": 0}\n\tGameState.action_axis_this_week = {\"money\": 0, \"human\": 0}\n\tGameState.action_places_this_week = {}\n\tGameState.action_records_this_week = []\n\tGameState.recent_action_places = []\n\tif is_instance_valid(_game):\n\t\t_game.set(\"turn_action_log\", [])\n\t\t# Complete existing UI/director initialization before case before-snapshots.\n\t\t# This is fixture setup, not an expected delta copied from an action result.\n\t\t_game.call(\"_refresh_all\")\n\nfunc _rel(raw_name: String, rel_id: String = \"qa_custom\", kind: String = \"friends\") -> Dictionary:\n\treturn {\"id\": rel_id, \"name\": raw_name, \"type\": kind, \"affection\": 40, \"trust\": 30, \"met_turn\": 1}\n\nfunc _old_logs_exact(before: Dictionary) -> bool:\n\treturn GameState.action_log.slice(0, before[\"action_log\"].size()) == before[\"action_log\"]\n\nfunc _messages_since(before: Dictionary) -> Array:\n\tvar messages: Array = []\n\tfor entry in GameState.action_log.slice(before[\"action_log\"].size()):\n\t\tmessages.append(str(entry.get(\"message\", \"\")))\n\treturn messages\n\nfunc _frames(count: int) -> void:\n\tfor _index in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _shutdown() -> void:\n\tif is_instance_valid(_game):\n\t\t_game.queue_free()\n\t\tawait _frames(4)\n\tfor value in get_tree().get_processed_tweens():\n\t\tif value is Tween and value.is_valid():\n\t\t\tvalue.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n"

