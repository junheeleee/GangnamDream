[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_check"]
script/source = "extends Control\n# ORDER-242: fixed source-only baseline + independently reviewed locale values.\n# Baseline SHA256 1f96ec82fa8071718b9237555416e18d37cf851ede9d07b241a0e4f43eb1ff90\n# Approved revised locale table SHA256 2d3fd135e0ebb911d6498a381e1aae89cdf8aa6538bdb5db2da29701662e8116\n# No private file is required at runtime. Headless text is not rendered/native approval.\nconst FIXTURE_APPROVED := true\nconst MAIN_GAME := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES := [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst SELECTED := [\"gosiwon_survivor\",\"first_move\",\"apartment_life\",\"gangnam_resident\",\"long_gosiwon\",\"first_paycheck\",\"one_year_worker\",\"three_year_worker\",\"long_unemployed\"]\nconst UNSELECTED := [\"first_investment\",\"margin_called\",\"invest_master_title\",\"survived_broke\",\"steady_youth\",\"elite_course\",\"outsider_title\",\"dangerous_dreamer\",\"my_own_way\",\"free_spirit\",\"seoul_love\",\"social_king_title\",\"loner_title\",\"stress_survivor\",\"first_10m_title\",\"first_100m_title\",\"five_runs_title\",\"ten_runs_title\",\"gangnam_dream_title\",\"burnout_survivor\",\"ordinary_end_title\",\"holdem_master_title\",\"racetrack_master_title\",\"scalping_master_title\",\"baccarat_master_title\",\"blackjack_master_title\",\"slot_master_title\",\"roulette_master_title\",\"bigwheel_master_title\",\"daisai_master_title\",\"spec_elite_title\",\"spec_quant_title\",\"spec_founder_title\",\"clean_run_title\",\"network_run_title\",\"temptation_resist_title\",\"high_road_title\",\"father_peace_title\",\"love_chosen_title\",\"investigator_title\",\"white_gangnam_title\"]\nconst RAW_TITLES := [\n\t{\"id\":\"gosiwon_survivor\",\"name\":\"고시원 생존자\",\"cat\":\"주거\",\"rare\":\"common\",\"desc\":\"고시원에서 12개월을 버텼다. 이 경험은 잊지 못할 것이다.\"},\n\t{\"id\":\"first_move\",\"name\":\"첫 이사\",\"cat\":\"주거\",\"rare\":\"common\",\"desc\":\"처음으로 고시원을 벗어나 새 공간으로 이사했다.\"},\n\t{\"id\":\"apartment_life\",\"name\":\"아파트 입성\",\"cat\":\"주거\",\"rare\":\"uncommon\",\"desc\":\"드디어 아파트에 살게 됐다. 경비 아저씨가 반겨준다.\"},\n\t{\"id\":\"gangnam_resident\",\"name\":\"강남 입성\",\"cat\":\"주거\",\"rare\":\"rare\",\"desc\":\"강남 아파트. 주소만으로도 사람들의 눈빛이 달라진다.\"},\n\t{\"id\":\"long_gosiwon\",\"name\":\"고시원 장기거주자\",\"cat\":\"주거\",\"rare\":\"uncommon\",\"desc\":\"고시원 24개월. 이제 이 냄새도 집냄새처럼 느껴진다.\"},\n\t{\"id\":\"first_paycheck\",\"name\":\"첫 월급의 무게\",\"cat\":\"직업\",\"rare\":\"common\",\"desc\":\"통장에 처음으로 월급이 찍혔다. 기쁘면서도 이상하게 허탈했다.\"},\n\t{\"id\":\"one_year_worker\",\"name\":\"1년 직장인\",\"cat\":\"직업\",\"rare\":\"common\",\"desc\":\"같은 회사를 1년 다녔다. 어느새 선배가 돼 있었다.\"},\n\t{\"id\":\"three_year_worker\",\"name\":\"베테랑 직장인\",\"cat\":\"직업\",\"rare\":\"uncommon\",\"desc\":\"3년. 회사 서류함에 내 이름이 녹아들었다.\"},\n\t{\"id\":\"long_unemployed\",\"name\":\"백수의 자유\",\"cat\":\"직업\",\"rare\":\"uncommon\",\"desc\":\"12개월을 무직으로 버텼다. 누군가는 백수라 하고 누군가는 자유인이라 한다.\"},\n\t{\"id\":\"first_investment\",\"name\":\"첫 투자\",\"cat\":\"투자\",\"rare\":\"common\",\"desc\":\"처음으로 주식을 샀다. 그날부터 매일 앱을 열게 됐다.\"},\n\t{\"id\":\"margin_called\",\"name\":\"마진콜의 교훈\",\"cat\":\"투자\",\"rare\":\"uncommon\",\"desc\":\"레버리지 포지션이 강제청산됐다. 비싼 수업료였다.\"},\n\t{\"id\":\"invest_master_title\",\"name\":\"닫힌 노트북\",\"cat\":\"투자\",\"rare\":\"rare\",\"desc\":\"새벽 시장을 지켜보다 스스로 정한 때에 화면을 닫을 수 있게 됐다.\"},\n\t{\"id\":\"survived_broke\",\"name\":\"통장 0원 생존자\",\"cat\":\"투자\",\"rare\":\"common\",\"desc\":\"잔고가 마이너스까지 내려갔다 돌아왔다.\"},\n\t{\"id\":\"steady_youth\",\"name\":\"놓인 계단\",\"cat\":\"성향\",\"rare\":\"common\",\"desc\":\"낯선 지름길보다 이미 놓인 계단을 골라, 한 걸음씩 올라왔다.\"},\n\t{\"id\":\"elite_course\",\"name\":\"오래 오른 계단\",\"cat\":\"성향\",\"rare\":\"uncommon\",\"desc\":\"같은 계단을 오래 올랐다. 익숙해진 풍경만큼 지나친 갈림길도 남았다.\"},\n\t{\"id\":\"outsider_title\",\"name\":\"다른 출구\",\"cat\":\"성향\",\"rare\":\"common\",\"desc\":\"사람들이 몰린 방향에서 벗어나, 다른 출구를 여러 번 골랐다.\"},\n\t{\"id\":\"dangerous_dreamer\",\"name\":\"지도 밖의 길\",\"cat\":\"성향\",\"rare\":\"uncommon\",\"desc\":\"지도에 없는 길을 오래 걸었다. 발밑이 흔들린 날에도 방향을 쉽게 바꾸지 않았다.\"},\n\t{\"id\":\"my_own_way\",\"name\":\"두 길 사이\",\"cat\":\"성향\",\"rare\":\"rare\",\"desc\":\"이미 놓인 길과 지도 밖의 길을 오갔다. 어느 한쪽만으로는 이 5년을 설명할 수 없다.\"},\n\t{\"id\":\"free_spirit\",\"name\":\"비어 있던 오후\",\"cat\":\"성향\",\"rare\":\"uncommon\",\"desc\":\"한강과 편의점, 오래 걷던 길에서 누구의 일정도 아닌 시간을 보냈다.\"},\n\t{\"id\":\"seoul_love\",\"name\":\"서울에서 사랑\",\"cat\":\"관계\",\"rare\":\"uncommon\",\"desc\":\"이 복잡한 도시에서도 사람을 좋아하게 됐다.\"},\n\t{\"id\":\"social_king_title\",\"name\":\"낯익은 자리들\",\"cat\":\"관계\",\"rare\":\"rare\",\"desc\":\"서울 곳곳에 먼저 인사를 건네고 자리를 내어 주는 사람들이 생겼다.\"},\n\t{\"id\":\"loner_title\",\"name\":\"혼자 걷는 저녁\",\"cat\":\"관계\",\"rare\":\"uncommon\",\"desc\":\"연락할 이름이 떠오르지 않는 저녁에도, 혼자 걷는 길은 어느새 익숙해졌다.\"},\n\t{\"id\":\"stress_survivor\",\"name\":\"다음 아침\",\"cat\":\"생활\",\"rare\":\"uncommon\",\"desc\":\"마음이 버티기 어려웠던 밤이 지나고도, 다음 아침은 왔다.\"},\n\t{\"id\":\"first_10m_title\",\"name\":\"첫 1000만원\",\"cat\":\"자산\",\"rare\":\"common\",\"desc\":\"현금 1000만원. 서울에서 처음으로 숨이 트이는 느낌이었다.\"},\n\t{\"id\":\"first_100m_title\",\"name\":\"첫 1억\",\"cat\":\"자산\",\"rare\":\"uncommon\",\"desc\":\"총자산 1억. 뭔가 달라지는 것 같기도 하고 아닌 것 같기도 하다.\"},\n\t{\"id\":\"five_runs_title\",\"name\":\"다섯 번의 인생\",\"cat\":\"메타\",\"rare\":\"common\",\"desc\":\"다섯 번의 삶을 끝까지 살아냈다. 매번 달랐다.\"},\n\t{\"id\":\"ten_runs_title\",\"name\":\"열 번의 인생\",\"cat\":\"메타\",\"rare\":\"uncommon\",\"desc\":\"열 번을 살았다. 이제 이 도시의 반복되는 얼굴이 보이기 시작한다.\"},\n\t{\"id\":\"gangnam_dream_title\",\"name\":\"강남드림 달성자\",\"cat\":\"메타\",\"rare\":\"legendary\",\"desc\":\"총자산 30억. 강남드림을 이뤘다. 다음엔 뭘 꿈꿔야 할까.\"},\n\t{\"id\":\"burnout_survivor\",\"name\":\"번아웃 생존자\",\"cat\":\"메타\",\"rare\":\"common\",\"desc\":\"번아웃 엔딩을 경험했다. 열심히 사는 것의 대가를 배웠다.\"},\n\t{\"id\":\"ordinary_end_title\",\"name\":\"평범한 행복\",\"cat\":\"메타\",\"rare\":\"uncommon\",\"desc\":\"ordinary_life 엔딩. 평범함도 하나의 성취다.\"},\n\t{\"id\":\"holdem_master_title\",\"name\":\"홀덤 무법자\",\"cat\":\"미니게임\",\"rare\":\"rare\",\"desc\":\"지하 홀덤 클럽 15판 이상. 이제 패를 읽는다기보다, 상대를 읽는다.\"},\n\t{\"id\":\"racetrack_master_title\",\"name\":\"경마 귀신\",\"cat\":\"미니게임\",\"rare\":\"rare\",\"desc\":\"경마장 15판 이상. 폼지는 가끔 거짓말을 한다. 나는 이제 그것도 안다.\"},\n\t{\"id\":\"scalping_master_title\",\"name\":\"스캘퍼\",\"cat\":\"미니게임\",\"rare\":\"uncommon\",\"desc\":\"스캘핑 트레이딩 15회 이상. 1분 안에 사고 팔고. 손이 기억한다.\"},\n\t{\"id\":\"baccarat_master_title\",\"name\":\"정선 카지노 상주자\",\"cat\":\"미니게임\",\"rare\":\"rare\",\"desc\":\"바카라 15라운드 이상. 로드맵을 외웠지만 그게 아무 의미도 없다는 것도 안다.\"},\n\t{\"id\":\"blackjack_master_title\",\"name\":\"기본전략의 달인\",\"cat\":\"미니게임\",\"rare\":\"rare\",\"desc\":\"블랙잭 15핸드 이상. 패를 보고 멈출지 받을지를 안다. 이게 이 게임의 전부다.\"},\n\t{\"id\":\"slot_master_title\",\"name\":\"잭팟 사냥꾼\",\"cat\":\"미니게임\",\"rare\":\"uncommon\",\"desc\":\"슬롯머신 20스핀 이상. 777이 나왔을 때 그 소리가 아직도 귓가에 맴돈다.\"},\n\t{\"id\":\"roulette_master_title\",\"name\":\"제로의 지배자\",\"cat\":\"미니게임\",\"rare\":\"rare\",\"desc\":\"룰렛 15스핀 이상. 하우스엣지 2.7%는 알지만 멈출 수 없다.\"},\n\t{\"id\":\"bigwheel_master_title\",\"name\":\"바늘의 눈\",\"cat\":\"미니게임\",\"rare\":\"uncommon\",\"desc\":\"빅휠 15스핀 이상. 가장 단순한 게임이지만 45:1을 노린다.\"},\n\t{\"id\":\"daisai_master_title\",\"name\":\"주사위의 밤\",\"cat\":\"미니게임\",\"rare\":\"uncommon\",\"desc\":\"다이사이 15라운드 이상. 세 개의 주사위가 구르는 소리를 기억한다.\"},\n\t{\"id\":\"spec_elite_title\",\"name\":\"엘리트의 길\",\"cat\":\"성향\",\"rare\":\"uncommon\",\"desc\":\"엘리트 전문화 선택. 정석의 끝에는 무엇이 있을까.\"},\n\t{\"id\":\"spec_quant_title\",\"name\":\"퀀트 마인드\",\"cat\":\"성향\",\"rare\":\"uncommon\",\"desc\":\"퀀트형 전문화 선택. 시장을 수식으로 본다.\"},\n\t{\"id\":\"spec_founder_title\",\"name\":\"창업가 정신\",\"cat\":\"성향\",\"rare\":\"rare\",\"desc\":\"창업형 전문화 선택. 아무것도 없는 곳에서 시작한 사람.\"},\n\t{\"id\":\"clean_run_title\",\"name\":\"청렴한 강남행\",\"cat\":\"메타\",\"rare\":\"rare\",\"desc\":\"도박 없이 30억에 도달했다. 이 도시에서 끝까지 원칙을 지켰다.\"},\n\t{\"id\":\"network_run_title\",\"name\":\"서울 인맥왕\",\"cat\":\"메타\",\"rare\":\"uncommon\",\"desc\":\"맺어 온 인연을 따라 강남에 들어섰다. 결국 사람이 가장 큰 자산이었다.\"},\n\t{\"id\":\"temptation_resist_title\",\"name\":\"그날 밤의 선택\",\"cat\":\"이야기\",\"rare\":\"common\",\"desc\":\"가장 어려울 때 쉬운 돈을 거절했다. 그 선택이 모든 것의 시작이었다.\"},\n\t{\"id\":\"high_road_title\",\"name\":\"선을 지킨 사람\",\"cat\":\"이야기\",\"rare\":\"rare\",\"desc\":\"친구를 경찰에 넘겼다. 옳은 일은 가끔 가장 아픈 일이다.\"},\n\t{\"id\":\"father_peace_title\",\"name\":\"마지막 봄\",\"cat\":\"이야기\",\"rare\":\"uncommon\",\"desc\":\"아버지와 화해했다. 벚꽃이 피기 전에, 늦지 않게.\"},\n\t{\"id\":\"love_chosen_title\",\"name\":\"사랑을 택한 사람\",\"cat\":\"이야기\",\"rare\":\"uncommon\",\"desc\":\"갈림길에서 다은을 붙잡았다. 강남보다 먼저 잡은 것.\"},\n\t{\"id\":\"investigator_title\",\"name\":\"의심하는 자\",\"cat\":\"이야기\",\"rare\":\"uncommon\",\"desc\":\"친구의 경고를 흘려듣지 않았다. 의심은 때로 우정의 다른 이름이다.\"},\n\t{\"id\":\"white_gangnam_title\",\"name\":\"수첩의 다음 장\",\"cat\":\"메타\",\"rare\":\"legendary\",\"desc\":\"30억과 강남의 등기를 손에 쥔 뒤, 하지 않았던 일들을 돌아보며 오래된 수첩의 다음 장을 폈다.\"},\n]\nconst OLD_EN := {\n\t\"gosiwon_survivor\": {\"name\":\"Gosiwon Survivor\",\"cat\":\"Housing\",\"desc\":\"Survived 12 months in a gosiwon. You will not forget that room.\"},\n\t\"first_move\": {\"name\":\"First Move\",\"cat\":\"Housing\",\"desc\":\"Left the gosiwon for the first time and moved into a new space.\"},\n\t\"apartment_life\": {\"name\":\"Apartment Life\",\"cat\":\"Housing\",\"desc\":\"Finally living in an apartment. Even the security guard greets you.\"},\n\t\"gangnam_resident\": {\"name\":\"Gangnam Resident\",\"cat\":\"Housing\",\"desc\":\"A Gangnam apartment. The address alone changes how people look at you.\"},\n\t\"long_gosiwon\": {\"name\":\"Long-Term Gosiwon Tenant\",\"cat\":\"Housing\",\"desc\":\"24 months in a gosiwon. Even the smell has started to feel like home.\"},\n\t\"first_paycheck\": {\"name\":\"Weight of the First Paycheck\",\"cat\":\"Career\",\"desc\":\"Your first salary hit the account. It felt joyful and strangely hollow.\"},\n\t\"one_year_worker\": {\"name\":\"One-Year Worker\",\"cat\":\"Career\",\"desc\":\"Stayed at the same company for a year. Somehow, you became senior to someone.\"},\n\t\"three_year_worker\": {\"name\":\"Office Veteran\",\"cat\":\"Career\",\"desc\":\"Three years. Your name has seeped into the company's filing cabinets.\"},\n\t\"long_unemployed\": {\"name\":\"Freedom of Unemployment\",\"cat\":\"Career\",\"desc\":\"Stayed unemployed for 12 months. Some call it joblessness. Some call it freedom.\"},\n\t\"first_investment\": {\"name\":\"First Investment\",\"cat\":\"Investment\",\"desc\":\"Bought your first stock. From that day on, you opened the app every day.\"},\n\t\"margin_called\": {\"name\":\"Lesson of the Margin Call\",\"cat\":\"Investment\",\"desc\":\"A leveraged position was liquidated. An expensive lesson.\"},\n\t\"invest_master_title\": {\"name\":\"The Closed Laptop\",\"cat\":\"Investment\",\"desc\":\"After watching the market before dawn, you learned to close the screen at the moment you had set for yourself.\"},\n\t\"survived_broke\": {\"name\":\"Zero-Balance Survivor\",\"cat\":\"Investment\",\"desc\":\"Your balance went below zero and came back.\"},\n\t\"steady_youth\": {\"name\":\"The Stairs Already There\",\"cat\":\"Tendency\",\"desc\":\"You kept choosing the stairs already there over unfamiliar shortcuts, one step at a time.\"},\n\t\"elite_course\": {\"name\":\"The Long Climb\",\"cat\":\"Tendency\",\"desc\":\"You stayed on the same staircase for a long time. The view grew familiar, and some turnoffs slipped behind you.\"},\n\t\"outsider_title\": {\"name\":\"Another Exit\",\"cat\":\"Tendency\",\"desc\":\"More than once, you stepped away from the crowd and chose another exit.\"},\n\t\"dangerous_dreamer\": {\"name\":\"Beyond the Map\",\"cat\":\"Tendency\",\"desc\":\"You stayed on roads the map did not show, even on days when the ground felt uncertain.\"},\n\t\"my_own_way\": {\"name\":\"Between Two Roads\",\"cat\":\"Tendency\",\"desc\":\"You moved between the road already laid out and the road beyond the map. Neither one alone explains these five years.\"},\n\t\"free_spirit\": {\"name\":\"An Afternoon of Your Own\",\"cat\":\"Tendency\",\"desc\":\"By the Han River, at convenience stores, and on long walks, you spent time that belonged to no one else's schedule.\"},\n\t\"seoul_love\": {\"name\":\"Love in Seoul\",\"cat\":\"Relationships\",\"desc\":\"Even in this complicated city, you came to care for someone.\"},\n\t\"social_king_title\": {\"name\":\"Familiar Seats\",\"cat\":\"Relationships\",\"desc\":\"Around Seoul, people began greeting you first and making room when you arrived.\"},\n\t\"loner_title\": {\"name\":\"Evenings Walked Alone\",\"cat\":\"Relationships\",\"desc\":\"Even on evenings when no one came to mind to call, walking alone had become familiar.\"},\n\t\"stress_survivor\": {\"name\":\"The Next Morning\",\"cat\":\"Lifestyle\",\"desc\":\"A night when it was hard to hold yourself together passed, and the next morning still came.\"},\n\t\"first_10m_title\": {\"name\":\"First KRW 10M\",\"cat\":\"Assets\",\"desc\":\"KRW 10 million cash. For the first time in Seoul, you could breathe.\"},\n\t\"first_100m_title\": {\"name\":\"First KRW 100M\",\"cat\":\"Assets\",\"desc\":\"KRW 100 million net worth. Something changed. Or maybe nothing did.\"},\n\t\"five_runs_title\": {\"name\":\"Five Lives\",\"cat\":\"Meta\",\"desc\":\"Lived five lives all the way through. Each one was different.\"},\n\t\"ten_runs_title\": {\"name\":\"Ten Lives\",\"cat\":\"Meta\",\"desc\":\"Lived ten lives. The city's recurring patterns are starting to show.\"},\n\t\"gangnam_dream_title\": {\"name\":\"Gangnam Dream Achiever\",\"cat\":\"Meta\",\"desc\":\"KRW 3 billion net worth. You achieved the Gangnam Dream. What do you dream of next?\"},\n\t\"burnout_survivor\": {\"name\":\"Burnout Survivor\",\"cat\":\"Meta\",\"desc\":\"Experienced the burnout ending. You learned the price of trying too hard.\"},\n\t\"ordinary_end_title\": {\"name\":\"Ordinary Happiness\",\"cat\":\"Meta\",\"desc\":\"Ordinary Life ending. Even normalcy can be an achievement.\"},\n\t\"holdem_master_title\": {\"name\":\"Hold'em Outlaw\",\"cat\":\"Mini-Games\",\"desc\":\"Played 15 or more underground hold'em games. You read people now, not cards.\"},\n\t\"racetrack_master_title\": {\"name\":\"Racetrack Ghost\",\"cat\":\"Mini-Games\",\"desc\":\"Bet on 15 or more races. Form lies sometimes. Now you know that too.\"},\n\t\"scalping_master_title\": {\"name\":\"Scalper\",\"cat\":\"Mini-Games\",\"desc\":\"Scalped 15 or more times. Buy and sell within a minute. Your hands remember.\"},\n\t\"baccarat_master_title\": {\"name\":\"Jeongseon Casino Regular\",\"cat\":\"Mini-Games\",\"desc\":\"Played 15 or more baccarat rounds. You memorized the roadmap and learned it means nothing.\"},\n\t\"blackjack_master_title\": {\"name\":\"Basic Strategy Master\",\"cat\":\"Mini-Games\",\"desc\":\"Played 15 or more blackjack hands. Hit or stand. That is the whole game.\"},\n\t\"slot_master_title\": {\"name\":\"Jackpot Hunter\",\"cat\":\"Mini-Games\",\"desc\":\"Spun slots 20 or more times. The sound of 777 still echoes.\"},\n\t\"roulette_master_title\": {\"name\":\"Master of Zero\",\"cat\":\"Mini-Games\",\"desc\":\"Spun roulette 15 or more times. You know the 2.7% house edge and still cannot stop.\"},\n\t\"bigwheel_master_title\": {\"name\":\"Eye of the Needle\",\"cat\":\"Mini-Games\",\"desc\":\"Spun the big wheel 15 or more times. The simplest game, still chasing 45:1.\"},\n\t\"daisai_master_title\": {\"name\":\"Night of Dice\",\"cat\":\"Mini-Games\",\"desc\":\"Played 15 or more Dai Sai rounds. You remember the sound of three dice rolling.\"},\n\t\"spec_elite_title\": {\"name\":\"Path of the Elite\",\"cat\":\"Tendency\",\"desc\":\"Chose the elite specialization. What waits at the end of the proper path?\"},\n\t\"spec_quant_title\": {\"name\":\"Quant Mind\",\"cat\":\"Tendency\",\"desc\":\"Chose the quant specialization. You see the market as equations.\"},\n\t\"spec_founder_title\": {\"name\":\"Founder Spirit\",\"cat\":\"Tendency\",\"desc\":\"Chose the founder specialization. Someone who began from nothing.\"},\n\t\"clean_run_title\": {\"name\":\"Clean Road to Gangnam\",\"cat\":\"Meta\",\"desc\":\"Reached 3 billion won without gambling and held to your principles in this city.\"},\n\t\"network_run_title\": {\"name\":\"Seoul Network King\",\"cat\":\"Meta\",\"desc\":\"The people you came to know opened the way into Gangnam. In the end, people were the greatest asset.\"},\n\t\"temptation_resist_title\": {\"name\":\"Choice That Night\",\"cat\":\"Story\",\"desc\":\"Refused easy money when things were hardest. That choice began everything.\"},\n\t\"high_road_title\": {\"name\":\"One Who Held the Line\",\"cat\":\"Story\",\"desc\":\"Turned your friend over to the police. The right thing is sometimes the most painful thing.\"},\n\t\"father_peace_title\": {\"name\":\"Last Spring\",\"cat\":\"Story\",\"desc\":\"Made peace with your father. Before the cherry blossoms. Before it was too late.\"},\n\t\"love_chosen_title\": {\"name\":\"One Who Chose Love\",\"cat\":\"Story\",\"desc\":\"Held onto Daeun at the crossroads. Something you caught before Gangnam.\"},\n\t\"investigator_title\": {\"name\":\"The Suspicious One\",\"cat\":\"Story\",\"desc\":\"Did not dismiss your friend's warning. Suspicion is sometimes another name for friendship.\"},\n\t\"white_gangnam_title\": {\"name\":\"The Notebook's Next Page\",\"cat\":\"Meta\",\"desc\":\"With 3 billion won and a Gangnam deed in hand, you looked back on what you had refused to do and opened the old notebook to its next page.\"},\n}\nconst ROWS := [\n\t{\"id\":\"gosiwon_survivor\",\"field\":\"name\",\"ko\":\"고시원 생존자\",\"en\":\"Gosiwon Survivor\",\"ja\":\"コシウォン生存者\",\"zh-CN\":\"考试院生存者\",\"zh-TW\":\"考試院生存者\"},\n\t{\"id\":\"gosiwon_survivor\",\"field\":\"desc\",\"ko\":\"고시원에서 12개월을 버텼다. 이 경험은 잊지 못할 것이다.\",\"en\":\"Survived 12 months in a gosiwon. You will not forget that room.\",\"ja\":\"コシウォンで12か月を耐え抜いた。この経験は忘れられないだろう。\",\"zh-CN\":\"在考试院熬过了12个月。这段经历，大概忘不了。\",\"zh-TW\":\"在考試院撐過了12個月。這段經歷，大概忘不了。\"},\n\t{\"id\":\"first_move\",\"field\":\"name\",\"ko\":\"첫 이사\",\"en\":\"First Move\",\"ja\":\"初めての引っ越し\",\"zh-CN\":\"第一次搬家\",\"zh-TW\":\"第一次搬家\"},\n\t{\"id\":\"first_move\",\"field\":\"desc\",\"ko\":\"처음으로 고시원을 벗어나 새 공간으로 이사했다.\",\"en\":\"Left the gosiwon for the first time and moved into a new space.\",\"ja\":\"初めてコシウォンを出て、新しい住まいへ引っ越した。\",\"zh-CN\":\"第一次搬出了考试院，住进了新的地方。\",\"zh-TW\":\"第一次搬離考試院，住進了新的空間。\"},\n\t{\"id\":\"apartment_life\",\"field\":\"name\",\"ko\":\"아파트 입성\",\"en\":\"Apartment Life\",\"ja\":\"マンション入居\",\"zh-CN\":\"入住公寓\",\"zh-TW\":\"住進公寓\"},\n\t{\"id\":\"apartment_life\",\"field\":\"desc\",\"ko\":\"드디어 아파트에 살게 됐다. 경비 아저씨가 반겨준다.\",\"en\":\"Finally living in an apartment. Even the security guard greets you.\",\"ja\":\"ついにマンションで暮らすことになった。警備のおじさんが温かく迎えてくれる。\",\"zh-CN\":\"终于住进了公寓。保安大叔热情地跟我打招呼。\",\"zh-TW\":\"終於住進公寓了。警衛大叔親切地招呼我。\"},\n\t{\"id\":\"gangnam_resident\",\"field\":\"name\",\"ko\":\"강남 입성\",\"en\":\"Gangnam Resident\",\"ja\":\"カンナム入り\",\"zh-CN\":\"住进江南\",\"zh-TW\":\"住進江南\"},\n\t{\"id\":\"gangnam_resident\",\"field\":\"desc\",\"ko\":\"강남 아파트. 주소만으로도 사람들의 눈빛이 달라진다.\",\"en\":\"A Gangnam apartment. The address alone changes how people look at you.\",\"ja\":\"カンナムのマンション。住所だけで、人の見る目が変わる。\",\"zh-CN\":\"江南的公寓。光是这个地址，就让人看我的眼神变了。\",\"zh-TW\":\"江南的公寓。光是這個地址，就讓別人看我的眼光不一樣了。\"},\n\t{\"id\":\"long_gosiwon\",\"field\":\"name\",\"ko\":\"고시원 장기거주자\",\"en\":\"Long-Term Gosiwon Tenant\",\"ja\":\"コシウォン長期居住者\",\"zh-CN\":\"考试院长期住户\",\"zh-TW\":\"考試院長住客\"},\n\t{\"id\":\"long_gosiwon\",\"field\":\"desc\",\"ko\":\"고시원 24개월. 이제 이 냄새도 집냄새처럼 느껴진다.\",\"en\":\"24 months in a gosiwon. Even the smell has started to feel like home.\",\"ja\":\"コシウォンで24か月。今ではこのにおいも、家のにおいに感じられる。\",\"zh-CN\":\"考试院里住了24个月。如今连这股味道，也像是家里的味道了。\",\"zh-TW\":\"住在考試院24個月。現在連這股味道，都有了家的感覺。\"},\n\t{\"id\":\"first_paycheck\",\"field\":\"name\",\"ko\":\"첫 월급의 무게\",\"en\":\"Weight of the First Paycheck\",\"ja\":\"初任給の重み\",\"zh-CN\":\"第一份工资的分量\",\"zh-TW\":\"第一份薪水的重量\"},\n\t{\"id\":\"first_paycheck\",\"field\":\"desc\",\"ko\":\"통장에 처음으로 월급이 찍혔다. 기쁘면서도 이상하게 허탈했다.\",\"en\":\"Your first salary hit the account. It felt joyful and strangely hollow.\",\"ja\":\"初めて口座に給料が振り込まれた。うれしいのに、不思議とむなしかった。\",\"zh-CN\":\"第一笔工资打进了银行账户。高兴之余，心里却莫名有些空落落的。\",\"zh-TW\":\"第一筆薪水匯入了銀行帳戶。開心的同時，心裡卻莫名有點空。\"},\n\t{\"id\":\"one_year_worker\",\"field\":\"name\",\"ko\":\"1년 직장인\",\"en\":\"One-Year Worker\",\"ja\":\"勤めて1年\",\"zh-CN\":\"上班满1年\",\"zh-TW\":\"上班滿1年\"},\n\t{\"id\":\"one_year_worker\",\"field\":\"desc\",\"ko\":\"같은 회사를 1년 다녔다. 어느새 선배가 돼 있었다.\",\"en\":\"Stayed at the same company for a year. Somehow, you became senior to someone.\",\"ja\":\"同じ会社に1年勤めた。いつの間にか先輩になっていた。\",\"zh-CN\":\"在同一家公司干了1年。不知不觉，自己也成了老员工。\",\"zh-TW\":\"在同一家公司待了1年。不知不覺，自己也成了前輩。\"},\n\t{\"id\":\"three_year_worker\",\"field\":\"name\",\"ko\":\"베테랑 직장인\",\"en\":\"Office Veteran\",\"ja\":\"ベテラン会社員\",\"zh-CN\":\"职场老手\",\"zh-TW\":\"職場老手\"},\n\t{\"id\":\"three_year_worker\",\"field\":\"desc\",\"ko\":\"3년. 회사 서류함에 내 이름이 녹아들었다.\",\"en\":\"Three years. Your name has seeped into the company's filing cabinets.\",\"ja\":\"3年。会社の書類棚に、自分の名前が溶け込んでいた。\",\"zh-CN\":\"3年。我的名字已经融进了公司的文件柜里。\",\"zh-TW\":\"3年。我的名字已融進公司的文件櫃裡。\"},\n\t{\"id\":\"long_unemployed\",\"field\":\"name\",\"ko\":\"백수의 자유\",\"en\":\"Freedom of Unemployment\",\"ja\":\"無職の自由\",\"zh-CN\":\"无业者的自由\",\"zh-TW\":\"無業者的自由\"},\n\t{\"id\":\"long_unemployed\",\"field\":\"desc\",\"ko\":\"12개월을 무직으로 버텼다. 누군가는 백수라 하고 누군가는 자유인이라 한다.\",\"en\":\"Stayed unemployed for 12 months. Some call it joblessness. Some call it freedom.\",\"ja\":\"無職のまま12か月をしのいだ。無職と呼ぶ人もいれば、自由人と呼ぶ人もいる。\",\"zh-CN\":\"没有工作，也撑过了12个月。有人说我是无业游民，也有人说我是自由人。\",\"zh-TW\":\"沒有工作，也撐過了12個月。有人說我是無業遊民，也有人說我是自由人。\"},\n]\nconst WRAPPERS := [\n\t{\"ko\":\"미발견 칭호\",\"en\":\"Undiscovered Title\",\"ja\":\"未発見称号\",\"zh-CN\":\"Undiscovered Title\",\"zh-TW\":\"Undiscovered Title\"},\n\t{\"ko\":\"칭호 해금: 「%s」\",\"en\":\"Title Unlocked: \\\"%s\\\"\",\"ja\":\"称号解放: 「%s」\",\"zh-CN\":\"Title Unlocked: \\\"%s\\\"\",\"zh-TW\":\"Title Unlocked: \\\"%s\\\"\"},\n\t{\"ko\":\"칭호 해금: %s\",\"en\":\"Title Unlocked: %s\",\"ja\":\"称号解放: %s\",\"zh-CN\":\"Title Unlocked: %s\",\"zh-TW\":\"Title Unlocked: %s\"},\n\t{\"ko\":\"칭호: 「%s」  %s\",\"en\":\"Title: \\\"%s\\\"  %s\",\"ja\":\"称号: 「%s」   %s\",\"zh-CN\":\"称号：「%s」  %s\",\"zh-TW\":\"稱號：「%s」  %s\"},\n\t{\"ko\":\"미발견\",\"en\":\"HIDDEN\",\"ja\":\"未発見\",\"zh-CN\":\"HIDDEN\",\"zh-TW\":\"HIDDEN\"},\n\t{\"ko\":\"획득\",\"en\":\"OWNED\",\"ja\":\"獲得\",\"zh-CN\":\"OWNED\",\"zh-TW\":\"OWNED\"},\n\t{\"ko\":\"일반\",\"en\":\"COMMON\",\"ja\":\"一般\",\"zh-CN\":\"COMMON\",\"zh-TW\":\"COMMON\"},\n\t{\"ko\":\"희귀\",\"en\":\"UNCOMMON\",\"ja\":\"レア\",\"zh-CN\":\"UNCOMMON\",\"zh-TW\":\"UNCOMMON\"},\n\t{\"ko\":\"레어\",\"en\":\"RARE\",\"ja\":\"レア\",\"zh-CN\":\"RARE\",\"zh-TW\":\"RARE\"},\n\t{\"ko\":\"전설\",\"en\":\"LEGENDARY\",\"ja\":\"伝説\",\"zh-CN\":\"LEGENDARY\",\"zh-TW\":\"LEGENDARY\"},\n\t{\"ko\":\"%d년 %d월 %d주차\",\"en\":\"%04d-%02d W%d\",\"ja\":\"%d年 %d月 %d週目\",\"zh-CN\":\"%04d-%02d W%d\",\"zh-TW\":\"%04d-%02d W%d\"},\n]\nconst CONDITION_ROWS := [\n\t[\"gosiwon_survivor\",\"housing_months\",{\"gosiwon\":11},false],\n\t[\"gosiwon_survivor\",\"housing_months\",{\"gosiwon\":12},true],\n\t[\"long_gosiwon\",\"housing_months\",{\"gosiwon\":23},false],\n\t[\"long_gosiwon\",\"housing_months\",{\"gosiwon\":24},true],\n\t[\"first_move\",\"flag: housing_moved_once\",false,false],\n\t[\"first_move\",\"flag: housing_moved_once\",true,true],\n\t[\"apartment_life\",\"housing\",\"villa\",false],\n\t[\"apartment_life\",\"housing\",\"apartment\",true],\n\t[\"apartment_life\",\"housing\",\"gangnam\",true],\n\t[\"gangnam_resident\",\"housing\",\"apartment\",false],\n\t[\"gangnam_resident\",\"housing\",\"gangnam\",true],\n\t[\"first_paycheck\",\"flag: has_received_paycheck\",false,false],\n\t[\"first_paycheck\",\"flag: has_received_paycheck\",true,true],\n\t[\"one_year_worker\",\"job_tenure\",11,false],\n\t[\"one_year_worker\",\"job_tenure\",12,true],\n\t[\"three_year_worker\",\"job_tenure\",35,false],\n\t[\"three_year_worker\",\"job_tenure\",36,true],\n\t[\"long_unemployed\",\"flag: unemployed_months\",11,false],\n\t[\"long_unemployed\",\"flag: unemployed_months\",12,true],\n\t[\"qa_unknown_title\",\"none\",null,false],\n]\n\nvar _game: Control\nvar _baseline: Dictionary = {}\nvar _case_count: int = 0\nvar _failures: Array[String] = []\n\n\n# ORDER245 new population; final table 1fcd5836 and independent review c8b05761 approved.\nconst NEXT_FIXTURE_APPROVED := true\nconst NEXT_SELECTED := [\"steady_youth\",\"elite_course\",\"outsider_title\",\"dangerous_dreamer\",\"my_own_way\",\"free_spirit\",\"seoul_love\",\"social_king_title\",\"loner_title\",\"stress_survivor\"]\nconst NEXT_ROWS := [\n\t{\"id\":\"steady_youth\",\"field\":\"name\",\"ko\":\"놓인 계단\",\"en\":\"The Stairs Already There\",\"ja\":\"そこにある階段\",\"zh-CN\":\"现成的阶梯\",\"zh-TW\":\"既有的階梯\"},\n\t{\"id\":\"steady_youth\",\"field\":\"desc\",\"ko\":\"낯선 지름길보다 이미 놓인 계단을 골라, 한 걸음씩 올라왔다.\",\"en\":\"You kept choosing the stairs already there over unfamiliar shortcuts, one step at a time.\",\"ja\":\"知らない近道よりも、すでにある階段を選び、一歩ずつ上ってきた。\",\"zh-CN\":\"比起陌生的捷径，选择了已铺好的台阶，一步一步走了上来。\",\"zh-TW\":\"比起陌生的捷徑，選擇了早已鋪好的階梯，一步一步走了上來。\"},\n\t{\"id\":\"elite_course\",\"field\":\"name\",\"ko\":\"오래 오른 계단\",\"en\":\"The Long Climb\",\"ja\":\"長く上った階段\",\"zh-CN\":\"攀登已久的阶梯\",\"zh-TW\":\"攀登已久的階梯\"},\n\t{\"id\":\"elite_course\",\"field\":\"desc\",\"ko\":\"같은 계단을 오래 올랐다. 익숙해진 풍경만큼 지나친 갈림길도 남았다.\",\"en\":\"You stayed on the same staircase for a long time. The view grew familiar, and some turnoffs slipped behind you.\",\"ja\":\"同じ階段を長く上った。見慣れた景色が増えた分、通り過ぎた分かれ道も残った。\",\"zh-CN\":\"沿着同一段阶梯攀登了很久。风景渐渐熟悉，经过的岔路也留在了身后。\",\"zh-TW\":\"沿著同一段階梯爬了很久。風景越來越熟悉，走過的岔路也留在了身後。\"},\n\t{\"id\":\"outsider_title\",\"field\":\"name\",\"ko\":\"다른 출구\",\"en\":\"Another Exit\",\"ja\":\"別の出口\",\"zh-CN\":\"另一处出口\",\"zh-TW\":\"另一個出口\"},\n\t{\"id\":\"outsider_title\",\"field\":\"desc\",\"ko\":\"사람들이 몰린 방향에서 벗어나, 다른 출구를 여러 번 골랐다.\",\"en\":\"More than once, you stepped away from the crowd and chose another exit.\",\"ja\":\"人々が集まる方から離れ、何度も別の出口を選んだ。\",\"zh-CN\":\"离开人群聚集的方向，多次选择了另一处出口。\",\"zh-TW\":\"離開人群聚集的方向，多次選擇了另一個出口。\"},\n\t{\"id\":\"dangerous_dreamer\",\"field\":\"name\",\"ko\":\"지도 밖의 길\",\"en\":\"Beyond the Map\",\"ja\":\"地図の外の道\",\"zh-CN\":\"地图之外的路\",\"zh-TW\":\"地圖之外的路\"},\n\t{\"id\":\"dangerous_dreamer\",\"field\":\"desc\",\"ko\":\"지도에 없는 길을 오래 걸었다. 발밑이 흔들린 날에도 방향을 쉽게 바꾸지 않았다.\",\"en\":\"You stayed on roads the map did not show, even on days when the ground felt uncertain.\",\"ja\":\"地図にない道を長く歩いた。足元が揺らぐ日にも、簡単には進む方向を変えなかった。\",\"zh-CN\":\"在地图上没有的路上走了很久。即使有些日子脚下不稳，也没有轻易改变方向。\",\"zh-TW\":\"在地圖上找不到的路上走了很久。即使有些日子腳下不穩，也沒有輕易改變方向。\"},\n\t{\"id\":\"my_own_way\",\"field\":\"name\",\"ko\":\"두 길 사이\",\"en\":\"Between Two Roads\",\"ja\":\"二つの道のあいだ\",\"zh-CN\":\"两条路之间\",\"zh-TW\":\"兩條路之間\"},\n\t{\"id\":\"my_own_way\",\"field\":\"desc\",\"ko\":\"이미 놓인 길과 지도 밖의 길을 오갔다. 어느 한쪽만으로는 이 5년을 설명할 수 없다.\",\"en\":\"You moved between the road already laid out and the road beyond the map. Neither one alone explains these five years.\",\"ja\":\"すでにある道と地図の外の道を行き来した。どちらか一方だけでは、この5年間を語れない。\",\"zh-CN\":\"在已有的路与地图之外的路之间往返。单凭任何一条，都无法解释这5年。\",\"zh-TW\":\"在既有的路與地圖之外的路之間往返。只靠其中一條，都無法說明這5年。\"},\n\t{\"id\":\"free_spirit\",\"field\":\"name\",\"ko\":\"비어 있던 오후\",\"en\":\"An Afternoon of Your Own\",\"ja\":\"空いていた午後\",\"zh-CN\":\"空下来的午后\",\"zh-TW\":\"空下來的午後\"},\n\t{\"id\":\"free_spirit\",\"field\":\"desc\",\"ko\":\"한강과 편의점, 오래 걷던 길에서 누구의 일정도 아닌 시간을 보냈다.\",\"en\":\"By the Han River, at convenience stores, and on long walks, you spent time that belonged to no one else's schedule.\",\"ja\":\"誰かの予定に合わせることなく、漢江やコンビニ、長く歩いた道で時間を過ごした。\",\"zh-CN\":\"在汉江边、便利店和走了很久的路上，度过了不受任何日程约束的时光。\",\"zh-TW\":\"在漢江邊、便利商店和走了很久的路上，度過了不必配合任何行程的時光。\"},\n\t{\"id\":\"seoul_love\",\"field\":\"name\",\"ko\":\"서울에서 사랑\",\"en\":\"Love in Seoul\",\"ja\":\"ソウルでの恋\",\"zh-CN\":\"在首尔的爱情\",\"zh-TW\":\"在首爾的愛情\"},\n\t{\"id\":\"seoul_love\",\"field\":\"desc\",\"ko\":\"이 복잡한 도시에서도 사람을 좋아하게 됐다.\",\"en\":\"Even in this complicated city, you came to care for someone.\",\"ja\":\"この複雑な街でも、好きな人ができた。\",\"zh-CN\":\"即使在这座纷繁的城市里，也有了喜欢的人。\",\"zh-TW\":\"即使在這座紛雜的城市裡，也有了喜歡的人。\"},\n\t{\"id\":\"social_king_title\",\"field\":\"name\",\"ko\":\"낯익은 자리들\",\"en\":\"Familiar Seats\",\"ja\":\"なじみの席\",\"zh-CN\":\"熟悉的座位\",\"zh-TW\":\"熟悉的座位\"},\n\t{\"id\":\"social_king_title\",\"field\":\"desc\",\"ko\":\"서울 곳곳에 먼저 인사를 건네고 자리를 내어 주는 사람들이 생겼다.\",\"en\":\"Around Seoul, people began greeting you first and making room when you arrived.\",\"ja\":\"ソウルのあちこちに、先に挨拶をして席を空けてくれる人たちができた。\",\"zh-CN\":\"首尔各处渐渐有了会主动打招呼、腾出座位的人。\",\"zh-TW\":\"首爾各處漸漸有了會主動打招呼、空出座位的人。\"},\n\t{\"id\":\"loner_title\",\"field\":\"name\",\"ko\":\"혼자 걷는 저녁\",\"en\":\"Evenings Walked Alone\",\"ja\":\"ひとりで歩く夕暮れ\",\"zh-CN\":\"独行的傍晚\",\"zh-TW\":\"獨行的傍晚\"},\n\t{\"id\":\"loner_title\",\"field\":\"desc\",\"ko\":\"연락할 이름이 떠오르지 않는 저녁에도, 혼자 걷는 길은 어느새 익숙해졌다.\",\"en\":\"Even on evenings when no one came to mind to call, walking alone had become familiar.\",\"ja\":\"連絡する相手が思い浮かばない夕暮れも、ひとりで歩く道にはいつの間にか慣れていた。\",\"zh-CN\":\"即使有些傍晚想不起能联系谁，独自走的路也不知不觉变得熟悉了。\",\"zh-TW\":\"即使有些傍晚想不起能聯絡誰，獨自走的路也不知不覺變得熟悉了。\"},\n\t{\"id\":\"stress_survivor\",\"field\":\"name\",\"ko\":\"다음 아침\",\"en\":\"The Next Morning\",\"ja\":\"次の朝\",\"zh-CN\":\"第二天清晨\",\"zh-TW\":\"隔天早晨\"},\n\t{\"id\":\"stress_survivor\",\"field\":\"desc\",\"ko\":\"마음이 버티기 어려웠던 밤이 지나고도, 다음 아침은 왔다.\",\"en\":\"A night when it was hard to hold yourself together passed, and the next morning still came.\",\"ja\":\"心が持ちこたえるのも難しかった夜が過ぎても、次の朝はやってきた。\",\"zh-CN\":\"心里很难撑下去的夜晚过去了，第二天的清晨还是来了。\",\"zh-TW\":\"心裡難以撐住的那一夜過去，隔天早晨還是來了。\"}\n]\nconst NEXT_CONDITION_ROWS := [\n\t[\"next10/condition/01\",\"steady_youth\",{\"route_orthodox\":9},false],\n\t[\"next10/condition/02\",\"steady_youth\",{\"route_orthodox\":10},true],\n\t[\"next10/condition/03\",\"elite_course\",{\"route_orthodox\":19},false],\n\t[\"next10/condition/04\",\"elite_course\",{\"route_orthodox\":20},true],\n\t[\"next10/condition/05\",\"outsider_title\",{\"route_unorthodox\":9},false],\n\t[\"next10/condition/06\",\"outsider_title\",{\"route_unorthodox\":10},true],\n\t[\"next10/condition/07\",\"dangerous_dreamer\",{\"route_unorthodox\":19},false],\n\t[\"next10/condition/08\",\"dangerous_dreamer\",{\"route_unorthodox\":20},true],\n\t[\"next10/condition/09\",\"my_own_way\",{\"route_orthodox\":9,\"route_unorthodox\":10},false],\n\t[\"next10/condition/10\",\"my_own_way\",{\"route_orthodox\":10,\"route_unorthodox\":9},false],\n\t[\"next10/condition/11\",\"my_own_way\",{\"route_orthodox\":10,\"route_unorthodox\":10},true],\n\t[\"next10/condition/12\",\"free_spirit\",{\"flags.free_time_count\":9},false],\n\t[\"next10/condition/13\",\"free_spirit\",{\"flags.free_time_count\":10},true],\n\t[\"next10/condition/14\",\"seoul_love\",{\"relationships\":[]},false],\n\t[\"next10/condition/15\",\"seoul_love\",{\"relationships\":[{\"type\":\"friends\"}]},false],\n\t[\"next10/condition/16\",\"seoul_love\",{\"relationships\":[{\"type\":\"romantic\"}]},true],\n\t[\"next10/condition/17\",\"social_king_title\",{\"relationships\":[{\"id\":\"qa_next_relationship_0\",\"name\":\"QA custom 0\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_1\",\"name\":\"QA custom 1\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_2\",\"name\":\"QA custom 2\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_3\",\"name\":\"QA custom 3\",\"type\":\"friends\",\"affection\":40,\"trust\":30}]},false],\n\t[\"next10/condition/18\",\"social_king_title\",{\"relationships\":[{\"id\":\"qa_next_relationship_0\",\"name\":\"QA custom 0\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_1\",\"name\":\"QA custom 1\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_2\",\"name\":\"QA custom 2\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_3\",\"name\":\"QA custom 3\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_4\",\"name\":\"QA custom 4\",\"type\":\"friends\",\"affection\":40,\"trust\":30}]},true],\n\t[\"next10/condition/19\",\"loner_title\",{\"relationships\":[],\"age\":35,\"month\":5},false],\n\t[\"next10/condition/20\",\"loner_title\",{\"relationships\":[],\"age\":35,\"month\":6},true],\n\t[\"next10/condition/21\",\"loner_title\",{\"relationships\":[{\"type\":\"friends\"}],\"age\":35,\"month\":6},false],\n\t[\"next10/condition/22\",\"stress_survivor\",{\"flags.reached_max_stress\":false},false],\n\t[\"next10/condition/23\",\"stress_survivor\",{\"flags.reached_max_stress\":true},true]\n]\nconst NEXT_RELATIONSHIPS := [{\"id\":\"qa_next_relationship_0\",\"name\":\"QA custom 0\",\"type\":\"romantic\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_1\",\"name\":\"QA custom 1\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_2\",\"name\":\"QA custom 2\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_3\",\"name\":\"QA custom 3\",\"type\":\"friends\",\"affection\":40,\"trust\":30},{\"id\":\"qa_next_relationship_4\",\"name\":\"QA custom 4\",\"type\":\"friends\",\"affection\":40,\"trust\":30}]\nvar _next_case_count: int = 0\n\n# ORDER245: separately approved current10 observations, never old expectation rewrites.\nfunc _next_expected_custom(original: Dictionary, locale: String) -> Dictionary:\n\tvar value: Dictionary = _expected_custom(original, locale)\n\tvar title_id: String = str(original.get(\"id\", \"\"))\n\tif locale == \"ko\" or locale == \"en\" or not NEXT_SELECTED.has(title_id):\n\t\treturn value\n\tvar found: int = 0\n\tfor row in NEXT_ROWS:\n\t\tif row[\"id\"] == title_id:\n\t\t\tvalue[row[\"field\"]] = row[locale]\n\t\t\tfound += 1\n\tif found != 2:\n\t\t_failures.append(\"next20 fixture missing name/desc: \" + title_id)\n\treturn value\n\nfunc _next_expected(title_id: String, locale: String) -> Dictionary:\n\treturn _next_expected_custom(_raw(title_id), locale)\n\nfunc _next_values(ids: Array, locale: String) -> Array:\n\tvar values: Array = []\n\tfor title_id in ids:\n\t\tvalues.append(_next_expected(str(title_id), locale))\n\treturn values\n\nfunc _next_actual_values(ids: Array) -> Array:\n\tvar values: Array = []\n\tfor title_id in ids:\n\t\tvalues.append(MetaProgression.get_title_info(str(title_id)))\n\treturn values\n\nfunc _next_reset() -> void:\n\t_reset()\n\tGameState.route_orthodox = 0\n\tGameState.route_unorthodox = 0\n\tGameState.flags[\"free_time_count\"] = 0\n\tGameState.flags[\"reached_max_stress\"] = false\n\tGameState.relationships = []\n\tGameState.age = 33\n\tGameState.month = 1\n\t_game.call(\"_refresh_all\")\n\nfunc _next_project_old41(title_id: String, locale: String, actual: Dictionary) -> Dictionary:\n\tvar expected_current: Dictionary = _next_expected(title_id, locale)\n\tvar valid: bool = NEXT_SELECTED.has(title_id) and UNSELECTED.has(title_id) and actual == expected_current\n\tvar projected: Dictionary = actual.duplicate(true)\n\tvar changed: Array = []\n\tif valid:\n\t\tvar old_value: Dictionary = _expected(title_id, locale)\n\t\tfor field in [\"name\", \"desc\"]:\n\t\t\tif projected.get(field) != old_value.get(field):\n\t\t\t\tchanged.append(field)\n\t\t\tprojected[field] = old_value[field]\n\telse:\n\t\t_failures.append(\"new10 current dictionary invalid before old41 projection: \" + title_id)\n\treturn {\"id\": title_id, \"current\": actual.duplicate(true), \"expected_current\": expected_current,\n\t\t\"projected\": projected, \"authorized\": valid, \"changed_fields\": changed,\n\t\t\"scope\": \"validated historical observation only; not raw current localization\"}\n\nfunc _next_record(locale: String, family: String, actual: Variant, expected: Variant,\n\t\tbefore: Dictionary, expected_state: Dictionary, disk_before: String,\n\t\tdisk_expected: String, details: Dictionary = {}) -> void:\n\tvar after: Dictionary = _state()\n\tvar disk_after: String = _disk()\n\tvar raw_ok: bool = MetaProgression.ALL_TITLES == RAW_TITLES and MetaProgression.TITLE_EN == OLD_EN\n\tvar state_ok: bool = after == expected_state and disk_after == disk_expected and raw_ok\n\tvar passed: bool = actual == expected and state_ok\n\t_next_case_count += 1\n\tif not passed:\n\t\t_failures.append(\"%s/next10/%s actual=%s expected=%s state_ok=%s\" % [\n\t\t\tlocale, family, JSON.stringify(actual), JSON.stringify(expected), str(state_ok)])\n\tdetails = details.duplicate(true)\n\tdetails[\"raw50_and_en50_exact\"] = raw_ok\n\tdetails[\"delta\"] = _delta(before, after)\n\tdetails[\"unexpected_delta\"] = _delta(expected_state, after)\n\tdetails[\"before_sha256\"] = JSON.stringify(before).sha256_text()\n\tdetails[\"expected_sha256\"] = JSON.stringify(expected_state).sha256_text()\n\tdetails[\"after_sha256\"] = JSON.stringify(after).sha256_text()\n\tdetails[\"meta_disk\"] = {\"path\": MetaProgression.meta_save_path(),\n\t\t\"before_sha256\": disk_before.sha256_text(), \"expected_sha256\": disk_expected.sha256_text(),\n\t\t\"after_sha256\": disk_after.sha256_text(), \"exact\": disk_after == disk_expected}\n\tif not passed:\n\t\tdetails[\"before\"] = before\n\t\tdetails[\"expected_state\"] = expected_state\n\t\tdetails[\"after\"] = after\n\t\tdetails[\"meta_disk\"][\"before_text\"] = disk_before\n\t\tdetails[\"meta_disk\"][\"expected_text\"] = disk_expected\n\t\tdetails[\"meta_disk\"][\"after_text\"] = disk_after\n\tprint(\"META_TITLE_NEXT_CASE \" + JSON.stringify({\n\t\t\"id\": locale + \"/next10/\" + family, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": passed, \"state_ok\": state_ok, \"details\": details}))\n\nfunc _next_observed_state(before: Dictionary, expected: Dictionary, disk_before: String,\n\t\tdisk_expected: String) -> Dictionary:\n\tvar after: Dictionary = _state()\n\tvar disk_after: String = _disk()\n\tvar result: Dictionary = {\"state_exact\": after == expected, \"disk_exact\": disk_after == disk_expected,\n\t\t\"before_sha256\": JSON.stringify(before).sha256_text(),\n\t\t\"expected_sha256\": JSON.stringify(expected).sha256_text(),\n\t\t\"after_sha256\": JSON.stringify(after).sha256_text(),\n\t\t\"delta\": _delta(before, after), \"unexpected_delta\": _delta(expected, after),\n\t\t\"disk_before_sha256\": disk_before.sha256_text(),\n\t\t\"disk_expected_sha256\": disk_expected.sha256_text(),\n\t\t\"disk_after_sha256\": disk_after.sha256_text()}\n\tif after != expected or disk_after != disk_expected:\n\t\tresult[\"before\"] = before\n\t\tresult[\"expected\"] = expected\n\t\tresult[\"after\"] = after\n\t\tresult[\"disk_before\"] = disk_before\n\t\tresult[\"disk_expected\"] = disk_expected\n\t\tresult[\"disk_after\"] = disk_after\n\treturn result\n\nfunc _next_selected(locale: String, title_id: String) -> void:\n\t_next_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\t_next_record(locale, \"selected/\" + title_id, MetaProgression.get_title_info(title_id),\n\t\t_next_expected(title_id, locale), before, before, disk, disk)\n\nfunc _next_preserved(locale: String) -> void:\n\t_next_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar ids: Array = []\n\tfor raw in RAW_TITLES:\n\t\tif not NEXT_SELECTED.has(raw[\"id\"]):\n\t\t\tids.append(raw[\"id\"])\n\tvar expected: Array = []\n\tfor title_id in ids:\n\t\texpected.append(_expected(str(title_id), locale))\n\tvar a11_history: Dictionary = _a11_history_group(locale)\n\tvar actual: Array = []\n\tfor title_id in ids:\n\t\tactual.append(a11_history[\"by_id\"][title_id] if A11_SELECTED.has(title_id) else MetaProgression.get_title_info(str(title_id)))\n\t_next_record(locale, \"preserved_old9_remaining31\", actual, expected,\n\t\tbefore, before, disk, disk, {\"old9_localized\": 9, \"historical_remaining31\": 31,\n\t\t \"validated_A11_then_historical_name_desc_only\": a11_history, \"other95_NEXT_groups_direct_current\": true})\n\nfunc _next_unknown_custom(locale: String) -> void:\n\t_next_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor title_id in [\"\", \"qa_unknown_title\", \"STEADY_YOUTH\", \"steady_youth \"]:\n\t\tactual.append(MetaProgression.get_title_info(title_id))\n\t\texpected.append({})\n\tvar samples: Array = [{}, {\"name\": \"User title\", \"desc\": \"missing ID\", \"custom\": [1, \"家族\"]},\n\t\t{\"id\": \"qa_unknown_title\", \"name\": \"User title\", \"desc\": \"UNCHANGED\", \"cat\": \"custom\", \"rare\": \"custom\"},\n\t\t{\"id\": \"steady_youth \", \"name\": \"User title\", \"nested\": {\"original\": true}}]\n\tvar known: Dictionary = _raw(\"steady_youth\")\n\tknown[\"name\"] = \"Custom input name\"\n\tknown[\"desc\"] = \"Custom input description\"\n\tknown[\"custom\"] = {\"history\": [\"original\", 7], \"keep\": true}\n\tsamples.append(known)\n\tfor sample in samples:\n\t\tvar original: Dictionary = sample.duplicate(true)\n\t\tvar result: Dictionary = MetaProgression.call(\"_localized_title\", sample)\n\t\tactual.append({\"result\": result, \"input\": sample})\n\t\texpected.append({\"result\": _next_expected_custom(original, locale), \"input\": original})\n\t_next_record(locale, \"unknown_custom\", actual, expected, before, before, disk, disk)\n\nfunc _next_collection_expected(locale: String, unlocked: Array) -> Array:\n\tvar expected: Array = []\n\tvar rare_keys: Dictionary = {\"common\": \"일반\", \"uncommon\": \"희귀\", \"rare\": \"레어\", \"legendary\": \"전설\"}\n\tfor raw in _ordered_titles():\n\t\tvar title_id: String = str(raw[\"id\"])\n\t\tvar is_unlocked: bool = unlocked.has(title_id)\n\t\tvar title: Dictionary = _next_expected(title_id, locale)\n\t\texpected.append({\"name\": str(title[\"name\"]) if is_unlocked else _wrapper(\"미발견 칭호\", locale),\n\t\t\t\"desc\": str(title[\"desc\"]) if is_unlocked else \"\",\n\t\t\t\"status\": _wrapper(\"획득\" if is_unlocked else \"미발견\", locale),\n\t\t\t\"rare\": _wrapper(rare_keys[raw[\"rare\"]], locale)})\n\treturn expected\n\nfunc _next_collection(locale: String, unlocked: bool) -> void:\n\t_next_reset()\n\tvar ids: Array = NEXT_SELECTED.duplicate() if unlocked else []\n\tMetaProgression.data[\"unlocked_titles\"] = ids.duplicate()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = _collection_actual()\n\tvar bonus: Dictionary = {\"luck\": 4, \"social_skill\": 3} if unlocked else {}\n\t_next_record(locale, \"collection_unlocked\" if unlocked else \"collection_locked\",\n\t\t{\"cards\": actual, \"bonus\": MetaProgression.get_run_start_bonus()},\n\t\t{\"cards\": _next_collection_expected(locale, ids), \"bonus\": bonus},\n\t\tbefore, before, disk, disk, {\"cards\": 50, \"seeded_IDs_not_one_run_earned\": true})\n\t_game.call(\"_close_modal\", false, false)\n\nfunc _next_conditions(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor row in NEXT_CONDITION_ROWS:\n\t\t_next_reset()\n\t\tfor field in row[2]:\n\t\t\tvar value: Variant = row[2][field]\n\t\t\tif value is Array or value is Dictionary:\n\t\t\t\tvalue = value.duplicate(true)\n\t\t\tif str(field).begins_with(\"flags.\"):\n\t\t\t\tGameState.flags[str(field).trim_prefix(\"flags.\")] = value\n\t\t\telse:\n\t\t\t\tGameState.set(str(field), value)\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar observed: bool = MetaProgression.call(\"_check_title_condition\", str(row[1]))\n\t\tvar state: Dictionary = _next_observed_state(before, before, disk, disk)\n\t\tactual.append([observed, state[\"state_exact\"], state[\"disk_exact\"]])\n\t\texpected.append([bool(row[3]), true, true])\n\t\tobservations.append({\"id\": row[0], \"title_id\": row[1], \"inputs\": row[2],\n\t\t\t\"expected\": row[3], \"actual\": observed, \"state\": state})\n\t_next_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_next_record(locale, \"condition_boundaries\", actual, expected,\n\t\tfinal_before, final_before, final_disk, final_disk,\n\t\t{\"condition_rows23\": observations, \"positive10_negative13\": true, \"producers_not_invoked\": true})\n\nfunc _next_split_ids(split: String) -> Array:\n\tvar ids: Array = []\n\tfor title_id in NEXT_SELECTED:\n\t\tif (split == \"A\" and title_id != \"loner_title\") or (split == \"B\" and title_id == \"loner_title\"):\n\t\t\tids.append(title_id)\n\treturn ids\n\nfunc _next_unlock_setup(split: String) -> void:\n\t_next_reset()\n\tvar ids: Array = []\n\tfor raw in RAW_TITLES:\n\t\tif (split == \"A\" and not NEXT_SELECTED.has(raw[\"id\"])) or (split == \"B\" and raw[\"id\"] != \"loner_title\"):\n\t\t\tids.append(raw[\"id\"])\n\tMetaProgression.data[\"unlocked_titles\"] = ids\n\tif split == \"A\":\n\t\tGameState.route_orthodox = 20\n\t\tGameState.route_unorthodox = 20\n\t\tGameState.flags[\"free_time_count\"] = 10\n\t\tGameState.flags[\"reached_max_stress\"] = true\n\t\tGameState.relationships = NEXT_RELATIONSHIPS.duplicate(true)\n\telse:\n\t\tGameState.relationships = []\n\t\tGameState.age = 35\n\t\tGameState.month = 6\n\t_game.call(\"_refresh_all\")\n\nfunc _next_unlock_expected(before: Dictionary, split: String) -> Dictionary:\n\tvar expected: Dictionary = before.duplicate(true)\n\tvar ids: Array = expected[\"meta\"][\"unlocked_titles\"].duplicate()\n\tids.append_array(_next_split_ids(split))\n\texpected[\"meta\"][\"unlocked_titles\"] = ids\n\treturn expected\n\nfunc _next_unlock_return_duplicate(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor split in [\"A\", \"B\"]:\n\t\t_next_unlock_setup(split)\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar after_expected: Dictionary = _next_unlock_expected(before, split)\n\t\tvar expected_disk: String = JSON.stringify(after_expected[\"meta\"], \"\\t\")\n\t\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\t\tvar first: Dictionary = _next_observed_state(before, after_expected, disk, expected_disk)\n\t\tvar duplicate: Array = MetaProgression.check_and_unlock_titles()\n\t\tvar ids: Array = _next_split_ids(split)\n\t\tvar direct_duplicate: bool = MetaProgression.unlock_title(str(ids[0]))\n\t\tvar second: Dictionary = _next_observed_state(before, after_expected, disk, expected_disk)\n\t\tactual.append([newly, duplicate, direct_duplicate, first[\"state_exact\"],\n\t\t\tfirst[\"disk_exact\"], second[\"state_exact\"], second[\"disk_exact\"]])\n\t\texpected.append([_next_values(ids, locale), [], false, true, true, true, true])\n\t\tobservations.append({\"split\": split, \"expected_new_IDs\": ids, \"first\": first, \"duplicate\": second})\n\t_next_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_next_record(locale, \"unlock_split_duplicate\", actual, expected,\n\t\tfinal_before, final_before, final_disk, final_disk, {\"actual_split9_and1\": observations})\n\nfunc _next_unlock_toasts(locale: String, record_log: bool) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor split in [\"A\", \"B\"]:\n\t\t_next_unlock_setup(split)\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar after_expected: Dictionary = _next_unlock_expected(before, split)\n\t\tvar expected_toasts: Array = []\n\t\tvar expected_messages: Array = []\n\t\tvar date: String = _wrapper(\"%d년 %d월 %d주차\", locale) % [\n\t\t\tbefore[\"game\"][\"year\"], before[\"game\"][\"month\"], before[\"game\"][\"week_of_month\"]]\n\t\tfor title in _next_values(_next_split_ids(split), locale):\n\t\t\texpected_toasts.append(_wrapper(\"칭호 해금: 「%s」\", locale) % title[\"name\"])\n\t\t\tif record_log:\n\t\t\t\tvar message: String = _wrapper(\"칭호 해금: %s\", locale) % title[\"name\"]\n\t\t\t\texpected_messages.append(message)\n\t\t\t\tafter_expected[\"game\"][\"action_log\"].append({\n\t\t\t\t\t\"turn\": before[\"game\"][\"turn\"], \"date\": date, \"message\": message, \"type\": \"system\"})\n\t\t_game.call(\"_check_title_unlocks\", record_log)\n\t\tvar messages: Array = []\n\t\tfor entry in GameState.action_log.slice(before[\"game\"][\"action_log\"].size()):\n\t\t\tmessages.append(entry[\"message\"])\n\t\tvar state: Dictionary = _next_observed_state(before, after_expected, disk,\n\t\t\tJSON.stringify(after_expected[\"meta\"], \"\\t\"))\n\t\tactual.append([_toast_texts(), messages, state[\"state_exact\"], state[\"disk_exact\"]])\n\t\texpected.append([expected_toasts, expected_messages, true, true])\n\t\tobservations.append({\"split\": split, \"state\": state})\n\t_next_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_next_record(locale, \"unlock_toast_log\" if record_log else \"unlock_toast_no_log\",\n\t\tactual, expected, final_before, final_before, final_disk, final_disk,\n\t\t{\"record_game_log\": record_log, \"actual_split9_and1\": observations})\n\nfunc _next_ending_cards(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor split in [\"A\", \"B\"]:\n\t\t_next_unlock_setup(split)\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar after_expected: Dictionary = _next_unlock_expected(before, split)\n\t\tvar titles: Array = _next_values(_next_split_ids(split), locale)\n\t\tafter_expected[\"ending_titles\"] = titles.duplicate(true)\n\t\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\t\t_game.set(\"_ending_new_titles\", newly.duplicate(true))\n\t\tvar box := VBoxContainer.new()\n\t\tadd_child(box)\n\t\t_game.call(\"_ending_add_unlocks\", box)\n\t\tvar state: Dictionary = _next_observed_state(before, after_expected, disk,\n\t\t\tJSON.stringify(after_expected[\"meta\"], \"\\t\"))\n\t\tactual.append([_ending_texts(box), state[\"state_exact\"], state[\"disk_exact\"]])\n\t\texpected.append([_ending_expected(locale, titles), true, true])\n\t\tobservations.append({\"split\": split, \"actual_newly\": newly, \"state\": state})\n\t\tbox.queue_free()\n\t_next_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_next_record(locale, \"ending_cards\", actual, expected,\n\t\tfinal_before, final_before, final_disk, final_disk,\n\t\t{\"actual_cache_to_ending_add_unlocks\": observations, \"full_ending_not_invoked\": true})\n\nfunc _next_language_storage(locale: String) -> void:\n\t_next_reset()\n\tMetaProgression.data[\"unlocked_titles\"] = NEXT_SELECTED.duplicate()\n\tMetaProgression.data[\"qa_custom\"] = {\"player\": \"QA Custom Player\", \"history\": [\"original 中文\", 7], \"keep\": true}\n\t_game.set(\"_ending_new_titles\", _next_values(NEXT_SELECTED, locale))\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_disk: String = JSON.stringify(before[\"meta\"], \"\\t\")\n\tvar expected_parsed: Dictionary = JSON.parse_string(expected_disk)\n\tvar expected_state: Dictionary = before.duplicate(true)\n\texpected_state[\"meta\"] = expected_parsed.duplicate(true)\n\tMetaProgression.save_meta()\n\tvar saved_exact: bool = _disk() == expected_disk\n\tMetaProgression.load_meta()\n\tvar loaded_exact: bool = MetaProgression.data == expected_parsed\n\tvar alternate: String = \"en\" if locale == \"ko\" else \"ko\"\n\tLocaleManager.set_language(alternate)\n\tvar alternate_values: Array = _next_actual_values(NEXT_SELECTED)\n\tvar alternate_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\tvar box := VBoxContainer.new()\n\tadd_child(box)\n\t_game.call(\"_ending_add_unlocks\", box)\n\tvar cached_actual: Array = _ending_texts(box)\n\tvar cached_expected: Array = _ending_expected(alternate, _next_values(NEXT_SELECTED, locale))\n\tbox.queue_free()\n\tLocaleManager.set_language(locale)\n\tvar returned_values: Array = _next_actual_values(NEXT_SELECTED)\n\tvar returned_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\tvar actual: Array = [saved_exact, loaded_exact, alternate_values, alternate_cards,\n\t\tcached_actual, returned_values, returned_cards, MetaProgression.get_unlocked_titles()]\n\tvar expected: Array = [true, true, _next_values(NEXT_SELECTED, alternate),\n\t\t_next_collection_expected(alternate, NEXT_SELECTED), cached_expected,\n\t\t_next_values(NEXT_SELECTED, locale), _next_collection_expected(locale, NEXT_SELECTED), NEXT_SELECTED]\n\t_next_record(locale, \"language_storage\", actual, expected, before, expected_state, disk, expected_disk,\n\t\t{\"alternate\": alternate, \"fresh_getter_reopened_collection\": true,\n\t\t \"cached_title_keeps_origin_locale_wrapper_uses_current\": true,\n\t\t \"seeded_IDs_not_one_run_earned\": true, \"parsed_expectation_frozen_before_load\": true})\n\nfunc _next_run_groups(locale: String) -> void:\n\tfor title_id in NEXT_SELECTED:\n\t\t_next_selected(locale, title_id)\n\t_next_preserved(locale)\n\t_next_unknown_custom(locale)\n\t_next_collection(locale, false)\n\t_next_collection(locale, true)\n\t_next_conditions(locale)\n\t_next_unlock_return_duplicate(locale)\n\t_next_unlock_toasts(locale, true)\n\t_next_unlock_toasts(locale, false)\n\t_next_ending_cards(locale)\n\t_next_language_storage(locale)\n\nfunc _next_fixture_ready() -> bool:\n\tif not NEXT_FIXTURE_APPROVED or NEXT_SELECTED.size() != 10 or NEXT_ROWS.size() != 20 or NEXT_CONDITION_ROWS.size() != 23:\n\t\treturn false\n\tvar pairs: Dictionary = {}\n\tfor row in NEXT_ROWS:\n\t\tvar title_id: String = str(row[\"id\"])\n\t\tvar field: String = str(row[\"field\"])\n\t\tif not NEXT_SELECTED.has(title_id) or not [\"name\", \"desc\"].has(field):\n\t\t\treturn false\n\t\tvar key: String = title_id + \"/\" + field\n\t\tif pairs.has(key) or str(_raw(title_id).get(field, \"\")) != row[\"ko\"] or str(OLD_EN[title_id].get(field, \"\")) != row[\"en\"]:\n\t\t\treturn false\n\t\tfor locale in LOCALES:\n\t\t\tif not row.has(locale) or not row[locale] is String or str(row[locale]).is_empty():\n\t\t\t\treturn false\n\t\tpairs[key] = true\n\treturn pairs.size() == 20\n\n# PRIVATE ORDER248 prototype. Not installed into the product or executed.\n# Frozen runtime plan: a63c81eaebc3b1b6f4924dde6480b315c65a8bfc1331fd315a86f811f41a4993.\n# Literal rows/conditions/parents are assembled from separately bound inputs.\nconst A11_FIXTURE_APPROVED := true\nconst A11_SELECTED := [\"first_investment\", \"margin_called\", \"invest_master_title\", \"survived_broke\", \"first_10m_title\", \"first_100m_title\", \"five_runs_title\", \"ten_runs_title\", \"gangnam_dream_title\", \"burnout_survivor\", \"ordinary_end_title\"]\nconst A11_ROWS := [{\"id\":\"first_investment\",\"field\":\"name\",\"ko\":\"첫 투자\",\"en\":\"First Investment\",\"ja\":\"初めての投資\",\"zh-CN\":\"首次投资\",\"zh-TW\":\"第一次投資\"},{\"id\":\"first_investment\",\"field\":\"desc\",\"ko\":\"처음으로 주식을 샀다. 그날부터 매일 앱을 열게 됐다.\",\"en\":\"Bought your first stock. From that day on, you opened the app every day.\",\"ja\":\"初めて株式を買った。その日から、毎日アプリを開くようになった。\",\"zh-CN\":\"第一次买了股票。从那天起，每天都会打开应用。\",\"zh-TW\":\"第一次買了股票。從那天開始，每天都會打開應用程式。\"},{\"id\":\"margin_called\",\"field\":\"name\",\"ko\":\"마진콜의 교훈\",\"en\":\"Lesson of the Margin Call\",\"ja\":\"マージンコールの教訓\",\"zh-CN\":\"保证金追缴的教训\",\"zh-TW\":\"追繳保證金的教訓\"},{\"id\":\"margin_called\",\"field\":\"desc\",\"ko\":\"레버리지 포지션이 강제청산됐다. 비싼 수업료였다.\",\"en\":\"A leveraged position was liquidated. An expensive lesson.\",\"ja\":\"レバレッジをかけたポジションが強制決済された。高い授業料だった。\",\"zh-CN\":\"杠杆仓位被强制平仓了。学费真贵。\",\"zh-TW\":\"槓桿部位被強制平倉了。這堂課，學費真貴。\"},{\"id\":\"invest_master_title\",\"field\":\"name\",\"ko\":\"닫힌 노트북\",\"en\":\"The Closed Laptop\",\"ja\":\"閉じたノートパソコン\",\"zh-CN\":\"合上的笔记本电脑\",\"zh-TW\":\"闔上的筆記型電腦\"},{\"id\":\"invest_master_title\",\"field\":\"desc\",\"ko\":\"새벽 시장을 지켜보다 스스로 정한 때에 화면을 닫을 수 있게 됐다.\",\"en\":\"After watching the market before dawn, you learned to close the screen at the moment you had set for yourself.\",\"ja\":\"夜明け前の相場を見ながら、自分で決めた時に画面を閉じられるようになった。\",\"zh-CN\":\"守着凌晨的行情，学会了在自己定下的时间关掉屏幕。\",\"zh-TW\":\"看著凌晨的行情，現在已能在自己決定的時候關掉螢幕。\"},{\"id\":\"survived_broke\",\"field\":\"name\",\"ko\":\"통장 0원 생존자\",\"en\":\"Zero-Balance Survivor\",\"ja\":\"口座残高0ウォンの生存者\",\"zh-CN\":\"银行账户余额0韩元的幸存者\",\"zh-TW\":\"銀行帳戶餘額0韓元的倖存者\"},{\"id\":\"survived_broke\",\"field\":\"desc\",\"ko\":\"잔고가 마이너스까지 내려갔다 돌아왔다.\",\"en\":\"Your balance went below zero and came back.\",\"ja\":\"残高がマイナスにまで落ち込み、そこから戻ってきた。\",\"zh-CN\":\"余额一度跌到负数，后来又恢复了。\",\"zh-TW\":\"餘額一度跌到負數，後來又恢復了。\"},{\"id\":\"first_10m_title\",\"field\":\"name\",\"ko\":\"첫 1000만원\",\"en\":\"First KRW 10M\",\"ja\":\"初めての1000万ウォン\",\"zh-CN\":\"首次达到1000万韩元\",\"zh-TW\":\"首度達到1000萬韓元\"},{\"id\":\"first_10m_title\",\"field\":\"desc\",\"ko\":\"현금 1000만원. 서울에서 처음으로 숨이 트이는 느낌이었다.\",\"en\":\"KRW 10 million cash. For the first time in Seoul, you could breathe.\",\"ja\":\"現金1000万ウォン。ソウルで初めて、ひと息つける気がした。\",\"zh-CN\":\"现金1000万韩元。在首尔，第一次觉得能喘口气了。\",\"zh-TW\":\"現金1000萬韓元。在首爾，第一次有了能喘口氣的感覺。\"},{\"id\":\"first_100m_title\",\"field\":\"name\",\"ko\":\"첫 1억\",\"en\":\"First KRW 100M\",\"ja\":\"初めての1億ウォン\",\"zh-CN\":\"首次达到1亿韩元\",\"zh-TW\":\"首度達到1億韓元\"},{\"id\":\"first_100m_title\",\"field\":\"desc\",\"ko\":\"총자산 1억. 뭔가 달라지는 것 같기도 하고 아닌 것 같기도 하다.\",\"en\":\"KRW 100 million net worth. Something changed. Or maybe nothing did.\",\"ja\":\"純資産1億ウォン。何かが変わったような、そうでもないような気がする。\",\"zh-CN\":\"净资产1亿韩元。好像有什么不一样了，又好像什么都没变。\",\"zh-TW\":\"淨資產1億韓元。感覺好像有些不同，又好像沒有。\"},{\"id\":\"five_runs_title\",\"field\":\"name\",\"ko\":\"다섯 번의 인생\",\"en\":\"Five Lives\",\"ja\":\"5度の人生\",\"zh-CN\":\"五次人生\",\"zh-TW\":\"五次人生\"},{\"id\":\"five_runs_title\",\"field\":\"desc\",\"ko\":\"다섯 번의 삶을 끝까지 살아냈다. 매번 달랐다.\",\"en\":\"Lived five lives all the way through. Each one was different.\",\"ja\":\"5度の人生を最後まで生き抜いた。そのたびに違っていた。\",\"zh-CN\":\"五次人生，都走到了最后。每次都不一样。\",\"zh-TW\":\"五次人生，都一路走到了最後。每一次都不同。\"},{\"id\":\"ten_runs_title\",\"field\":\"name\",\"ko\":\"열 번의 인생\",\"en\":\"Ten Lives\",\"ja\":\"10度の人生\",\"zh-CN\":\"十次人生\",\"zh-TW\":\"十次人生\"},{\"id\":\"ten_runs_title\",\"field\":\"desc\",\"ko\":\"열 번을 살았다. 이제 이 도시의 반복되는 얼굴이 보이기 시작한다.\",\"en\":\"Lived ten lives. The city's recurring patterns are starting to show.\",\"ja\":\"10度の人生を生きた。今は、この街が繰り返し見せる顔に気づき始めている。\",\"zh-CN\":\"活了十次人生。现在，开始看见这座城市反复显露的面孔。\",\"zh-TW\":\"活過了十次人生。現在，開始看出這座城市反覆展現的面貌。\"},{\"id\":\"gangnam_dream_title\",\"field\":\"name\",\"ko\":\"강남드림 달성자\",\"en\":\"Gangnam Dream Achiever\",\"ja\":\"カンナム・ドリーム達成者\",\"zh-CN\":\"GANGNAM DREAM 达成者\",\"zh-TW\":\"GANGNAM DREAM 達成者\"},{\"id\":\"gangnam_dream_title\",\"field\":\"desc\",\"ko\":\"총자산 30억. 강남드림을 이뤘다. 다음엔 뭘 꿈꿔야 할까.\",\"en\":\"KRW 3 billion net worth. You achieved the Gangnam Dream. What do you dream of next?\",\"ja\":\"純資産30億ウォン。カンナム・ドリームを実現した。次は何を夢見ればいいのだろう。\",\"zh-CN\":\"净资产30亿韩元。实现了 GANGNAM DREAM。接下来，又该怀抱什么梦想呢？\",\"zh-TW\":\"淨資產30億韓元。實現了 GANGNAM DREAM。接下來，該懷抱什麼夢想呢？\"},{\"id\":\"burnout_survivor\",\"field\":\"name\",\"ko\":\"번아웃 생존자\",\"en\":\"Burnout Survivor\",\"ja\":\"燃え尽きを生き延びた人\",\"zh-CN\":\"倦怠幸存者\",\"zh-TW\":\"倦怠倖存者\"},{\"id\":\"burnout_survivor\",\"field\":\"desc\",\"ko\":\"번아웃 엔딩을 경험했다. 열심히 사는 것의 대가를 배웠다.\",\"en\":\"Experienced the burnout ending. You learned the price of trying too hard.\",\"ja\":\"燃え尽きエンディングを経験した。懸命に生きることの代償を知った。\",\"zh-CN\":\"经历了倦怠结局。懂得了努力生活所要付出的代价。\",\"zh-TW\":\"經歷了倦怠結局。體會到努力生活的代價。\"},{\"id\":\"ordinary_end_title\",\"field\":\"name\",\"ko\":\"평범한 행복\",\"en\":\"Ordinary Happiness\",\"ja\":\"平凡な幸せ\",\"zh-CN\":\"平凡的幸福\",\"zh-TW\":\"平凡的幸福\"},{\"id\":\"ordinary_end_title\",\"field\":\"desc\",\"ko\":\"ordinary_life 엔딩. 평범함도 하나의 성취다.\",\"en\":\"Ordinary Life ending. Even normalcy can be an achievement.\",\"ja\":\"ordinary_lifeエンディング。平凡であることも、一つの成果だ。\",\"zh-CN\":\"ordinary_life 结局。平凡也是一种成就。\",\"zh-TW\":\"ordinary_life 結局。平凡，也是一種成就。\"}]\nconst A11_CONDITION_ROWS := [{\"id\":\"a11-condition/first_investment/absent\",\"title_id\":\"first_investment\",\"set\":{\"game.flags.had_first_investment\":{\"operation\":\"erase\"}},\"expect\":false},{\"id\":\"a11-condition/first_investment/false\",\"title_id\":\"first_investment\",\"set\":{\"game.flags.had_first_investment\":false},\"expect\":false},{\"id\":\"a11-condition/first_investment/true\",\"title_id\":\"first_investment\",\"set\":{\"game.flags.had_first_investment\":true},\"expect\":true},{\"id\":\"a11-condition/margin_called/absent\",\"title_id\":\"margin_called\",\"set\":{\"game.flags.margin_called_happened\":{\"operation\":\"erase\"}},\"expect\":false},{\"id\":\"a11-condition/margin_called/false\",\"title_id\":\"margin_called\",\"set\":{\"game.flags.margin_called_happened\":false},\"expect\":false},{\"id\":\"a11-condition/margin_called/true\",\"title_id\":\"margin_called\",\"set\":{\"game.flags.margin_called_happened\":true},\"expect\":true},{\"id\":\"a11-condition/survived_broke/absent\",\"title_id\":\"survived_broke\",\"set\":{\"game.flags.was_broke_once\":{\"operation\":\"erase\"}},\"expect\":false},{\"id\":\"a11-condition/survived_broke/false\",\"title_id\":\"survived_broke\",\"set\":{\"game.flags.was_broke_once\":false},\"expect\":false},{\"id\":\"a11-condition/survived_broke/true\",\"title_id\":\"survived_broke\",\"set\":{\"game.flags.was_broke_once\":true},\"expect\":true},{\"id\":\"a11-condition/survived_broke/still-negative\",\"title_id\":\"survived_broke\",\"set\":{\"game.flags.was_broke_once\":true,\"game.money\":-1},\"expect\":true,\"note\":\"Current predicate has no recovery check; do not make prose recovery a new unlock requirement.\"},{\"id\":\"a11-condition/invest_master_title/skill-69\",\"title_id\":\"invest_master_title\",\"set\":{\"game.investment_skill\":69},\"expect\":false},{\"id\":\"a11-condition/invest_master_title/skill-70\",\"title_id\":\"invest_master_title\",\"set\":{\"game.investment_skill\":70},\"expect\":true},{\"id\":\"a11-condition/invest_master_title/skill-71\",\"title_id\":\"invest_master_title\",\"set\":{\"game.investment_skill\":71},\"expect\":true},{\"id\":\"a11-condition/first_10m_title/cash-9999999\",\"title_id\":\"first_10m_title\",\"set\":{\"game.money\":9999999},\"expect\":false},{\"id\":\"a11-condition/first_10m_title/cash-10000000\",\"title_id\":\"first_10m_title\",\"set\":{\"game.money\":10000000},\"expect\":true},{\"id\":\"a11-condition/first_10m_title/cash-10000001\",\"title_id\":\"first_10m_title\",\"set\":{\"game.money\":10000001},\"expect\":true},{\"id\":\"a11-condition/first_10m_title/net-worth-is-not-cash\",\"title_id\":\"first_10m_title\",\"set\":{\"game.money\":9000000,\"game.portfolio\":{\"qa_a11_asset\":{\"quantity\":1,\"avg_price\":91000000}},\"game.market_prices\":{\"qa_a11_asset\":91000000}},\"expect\":false,\"note\":\"Net worth is exactly 100 million, cash is below 10 million; fixture-only holding, no trade producer.\"},{\"id\":\"a11-condition/first_100m_title/net-cash-99999999\",\"title_id\":\"first_100m_title\",\"set\":{\"game.money\":99999999},\"expect\":false},{\"id\":\"a11-condition/first_100m_title/net-cash-100000000\",\"title_id\":\"first_100m_title\",\"set\":{\"game.money\":100000000},\"expect\":true},{\"id\":\"a11-condition/first_100m_title/net-cash-100000001\",\"title_id\":\"first_100m_title\",\"set\":{\"game.money\":100000001},\"expect\":true},{\"id\":\"a11-condition/first_100m_title/deduct-loan\",\"title_id\":\"first_100m_title\",\"set\":{\"game.money\":100000000,\"game.loans\":{\"qa_a11_loan\":1}},\"expect\":false,\"note\":\"get_total_asset_value subtracts sum(float(loans[p])); fixture debt only.\"},{\"id\":\"a11-condition/five_runs_title/runs-4\",\"title_id\":\"five_runs_title\",\"set\":{\"meta.total_runs\":4},\"expect\":false},{\"id\":\"a11-condition/five_runs_title/runs-5\",\"title_id\":\"five_runs_title\",\"set\":{\"meta.total_runs\":5},\"expect\":true},{\"id\":\"a11-condition/ten_runs_title/runs-9\",\"title_id\":\"ten_runs_title\",\"set\":{\"meta.total_runs\":9},\"expect\":false},{\"id\":\"a11-condition/ten_runs_title/runs-10\",\"title_id\":\"ten_runs_title\",\"set\":{\"meta.total_runs\":10},\"expect\":true},{\"id\":\"a11-condition/gangnam_dream_title/empty-achievements\",\"title_id\":\"gangnam_dream_title\",\"set\":{\"meta.achievements\":[]},\"expect\":false},{\"id\":\"a11-condition/gangnam_dream_title/wrong-ID\",\"title_id\":\"gangnam_dream_title\",\"set\":{\"meta.achievements\":[\"Gangnam_Dream\"]},\"expect\":false},{\"id\":\"a11-condition/gangnam_dream_title/historical-ID-low-cash\",\"title_id\":\"gangnam_dream_title\",\"set\":{\"meta.achievements\":[\"gangnam_dream\"],\"game.money\":500000},\"expect\":true},{\"id\":\"a11-condition/gangnam_dream_title/current-three-billion-without-ID\",\"title_id\":\"gangnam_dream_title\",\"set\":{\"meta.achievements\":[],\"game.money\":3000000000},\"expect\":false},{\"id\":\"a11-condition/burnout_survivor/empty-achievements\",\"title_id\":\"burnout_survivor\",\"set\":{\"meta.achievements\":[]},\"expect\":false},{\"id\":\"a11-condition/burnout_survivor/ending-token-is-not-achievement\",\"title_id\":\"burnout_survivor\",\"set\":{\"meta.achievements\":[\"burnout\"]},\"expect\":false},{\"id\":\"a11-condition/burnout_survivor/exact-achievement\",\"title_id\":\"burnout_survivor\",\"set\":{\"meta.achievements\":[\"survived_burnout\"]},\"expect\":true},{\"id\":\"a11-condition/ordinary_end_title/empty-history\",\"title_id\":\"ordinary_end_title\",\"set\":{\"meta.run_history\":[]},\"expect\":false},{\"id\":\"a11-condition/ordinary_end_title/wrong-ending-ID\",\"title_id\":\"ordinary_end_title\",\"set\":{\"meta.run_history\":[{\"ending_id\":\"ordinary_life_extra\"}]},\"expect\":false},{\"id\":\"a11-condition/ordinary_end_title/exact-ending-ID\",\"title_id\":\"ordinary_end_title\",\"set\":{\"meta.run_history\":[{\"ending_id\":\"ordinary_life\"}]},\"expect\":true}]\nconst A11_PARENTS := {\"미발견 칭호\":{\"ko\":\"미발견 칭호\",\"en\":\"Undiscovered Title\",\"ja\":\"未発見称号\",\"zh-CN\":\"Undiscovered Title\",\"zh-TW\":\"Undiscovered Title\"},\"칭호 해금: 「%s」\":{\"ko\":\"칭호 해금: 「%s」\",\"en\":\"Title Unlocked: \\\"%s\\\"\",\"ja\":\"称号解放: 「%s」\",\"zh-CN\":\"Title Unlocked: \\\"%s\\\"\",\"zh-TW\":\"Title Unlocked: \\\"%s\\\"\"},\"칭호 해금: %s\":{\"ko\":\"칭호 해금: %s\",\"en\":\"Title Unlocked: %s\",\"ja\":\"称号解放: %s\",\"zh-CN\":\"Title Unlocked: %s\",\"zh-TW\":\"Title Unlocked: %s\"},\"칭호: 「%s」  %s\":{\"ko\":\"칭호: 「%s」  %s\",\"en\":\"Title: \\\"%s\\\"  %s\",\"ja\":\"称号: 「%s」   %s\",\"zh-CN\":\"称号：「%s」  %s\",\"zh-TW\":\"稱號：「%s」  %s\"},\"미발견\":{\"ko\":\"미발견\",\"en\":\"HIDDEN\",\"ja\":\"未発見\",\"zh-CN\":\"HIDDEN\",\"zh-TW\":\"HIDDEN\"},\"획득\":{\"ko\":\"획득\",\"en\":\"OWNED\",\"ja\":\"獲得\",\"zh-CN\":\"OWNED\",\"zh-TW\":\"OWNED\"},\"일반\":{\"ko\":\"일반\",\"en\":\"COMMON\",\"ja\":\"一般\",\"zh-CN\":\"COMMON\",\"zh-TW\":\"COMMON\"},\"희귀\":{\"ko\":\"희귀\",\"en\":\"UNCOMMON\",\"ja\":\"レア\",\"zh-CN\":\"UNCOMMON\",\"zh-TW\":\"UNCOMMON\"},\"레어\":{\"ko\":\"레어\",\"en\":\"RARE\",\"ja\":\"レア\",\"zh-CN\":\"RARE\",\"zh-TW\":\"RARE\"},\"전설\":{\"ko\":\"전설\",\"en\":\"LEGENDARY\",\"ja\":\"伝説\",\"zh-CN\":\"LEGENDARY\",\"zh-TW\":\"LEGENDARY\"},\"%d년 %d월 %d주차\":{\"ko\":\"%d년 %d월 %d주차\",\"en\":\"%04d-%02d W%d\",\"ja\":\"%d年 %d月 %d週目\",\"zh-CN\":\"%04d-%02d W%d\",\"zh-TW\":\"%04d-%02d W%d\"},\"강남드림 달성자\":{\"ko\":\"강남드림 달성자\",\"en\":\"Gangnam Dreamer\",\"ja\":\"カンナム・ドリーム達成者\",\"zh-CN\":\"Gangnam Dreamer\",\"zh-TW\":\"Gangnam Dreamer\"},\"신흥 자산가\":{\"ko\":\"신흥 자산가\",\"en\":\"Emerging Wealth\",\"ja\":\"新興資産家\",\"zh-CN\":\"Emerging Wealth\",\"zh-TW\":\"Emerging Wealth\"},\"번아웃 직전\":{\"ko\":\"번아웃 직전\",\"en\":\"Near Burnout\",\"ja\":\"アウト寸前\",\"zh-CN\":\"Near Burnout\",\"zh-TW\":\"Near Burnout\"},\"투자\":{\"ko\":\"투자\",\"en\":\"Investment\",\"ja\":\"投資\",\"zh-CN\":\"Investment\",\"zh-TW\":\"Investment\"},\"자산\":{\"ko\":\"자산\",\"en\":\"Assets\",\"ja\":\"資産\",\"zh-CN\":\"Assets\",\"zh-TW\":\"Assets\"},\"메타\":{\"ko\":\"메타\",\"en\":\"Meta\",\"ja\":\"メタ\",\"zh-CN\":\"Meta\",\"zh-TW\":\"Meta\"},\"새로 열린 기록 없음\":{\"ko\":\"새로 열린 기록 없음\",\"en\":\"No newly opened records\",\"ja\":\"新たに開かれた記録はありません\",\"zh-CN\":\"暂无新解锁的记录\",\"zh-TW\":\"沒有新解鎖的紀錄\"}}\nconst A11_SHARED_ROWS := [{\"id\":\"a11-shared/at-three-billion-no-achievement\",\"set\":{\"game.money\":3000000000,\"meta.achievements\":[]},\"expected_gs\":{\"ko\":\"강남드림 달성자\",\"en\":\"Gangnam Dreamer\",\"ja\":\"カンナム・ドリーム達成者\",\"zh-CN\":{\"pending_translation_key\":\"강남드림 달성자\"},\"zh-TW\":{\"pending_translation_key\":\"강남드림 달성자\"}},\"expected_meta_condition\":false},{\"id\":\"a11-shared/below-three-billion\",\"set\":{\"game.money\":2999999999,\"meta.achievements\":[]},\"expected_gs_ref\":\"parent_expectations.신흥 자산가\",\"expected_meta_condition\":false},{\"id\":\"a11-shared/historical-achievement-lower-current-wealth\",\"set\":{\"game.money\":500000000,\"meta.achievements\":[\"gangnam_dream\"]},\"expected_gs_ref\":\"parent_expectations.신흥 자산가\",\"expected_meta_condition\":true},{\"id\":\"a11-shared/mental-priority\",\"set\":{\"game.money\":3000000000,\"game.mental\":12,\"meta.achievements\":[\"gangnam_dream\"]},\"expected_gs_ref\":\"parent_expectations.번아웃 직전\",\"expected_meta_condition\":true}]\nvar _a11_case_count: int = 0\n\nfunc _a11_expected_custom(original: Dictionary, locale: String) -> Dictionary:\n\tvar value: Dictionary = _next_expected_custom(original, locale)\n\tvar title_id: String = str(original.get(\"id\", \"\"))\n\tif locale == \"ko\" or locale == \"en\" or not A11_SELECTED.has(title_id):\n\t\treturn value\n\tvar found: int = 0\n\tfor row in A11_ROWS:\n\t\tif row[\"id\"] == title_id:\n\t\t\tvalue[row[\"field\"]] = row[locale]\n\t\t\tfound += 1\n\tif found != 2:\n\t\t_failures.append(\"A11 fixture missing name/desc: \" + title_id)\n\treturn value\n\nfunc _a11_expected(title_id: String, locale: String) -> Dictionary:\n\treturn _a11_expected_custom(_raw(title_id), locale)\n\nfunc _a11_values(ids: Array, locale: String) -> Array:\n\tvar values: Array = []\n\tfor title_id in ids:\n\t\tvalues.append(_a11_expected(str(title_id), locale))\n\treturn values\n\nfunc _a11_parent(key: String, locale: String) -> String:\n\tif not A11_PARENTS.has(key) or not A11_PARENTS[key].has(locale):\n\t\t_failures.append(\"A11 parent expectation missing: \" + key + \"/\" + locale)\n\t\treturn \"<missing frozen parent>\"\n\treturn str(A11_PARENTS[key][locale])\n\nfunc _a11_apply_fields(values: Dictionary) -> void:\n\tfor key in values:\n\t\tvar field: String = str(key)\n\t\tvar value: Variant = values[key]\n\t\tif value is Dictionary or value is Array:\n\t\t\tvalue = value.duplicate(true)\n\t\tif field.begins_with(\"game.flags.\"):\n\t\t\tvar flag_id: String = field.trim_prefix(\"game.flags.\")\n\t\t\tif value is Dictionary and value == {\"operation\": \"erase\"}:\n\t\t\t\tGameState.flags.erase(flag_id)\n\t\t\telse:\n\t\t\t\tGameState.flags[flag_id] = value\n\t\telif field.begins_with(\"game.\"):\n\t\t\tGameState.set(field.trim_prefix(\"game.\"), value)\n\t\telif field.begins_with(\"meta.\"):\n\t\t\tMetaProgression.data[field.trim_prefix(\"meta.\")] = value\n\t\telse:\n\t\t\t_failures.append(\"Unexpected A11 fixture field: \" + field)\n\nfunc _a11_reset() -> void:\n\t_next_reset()\n\t_a11_apply_fields({\"game.money\": 500000.0, \"game.portfolio\": {}, \"game.loans\": {},\n\t\t\"game.market_prices\": {}, \"game.investment_skill\": 0, \"game.mental\": 50,\n\t\t\"game.flags.had_first_investment\": false, \"game.flags.margin_called_happened\": false,\n\t\t\"game.flags.was_broke_once\": false, \"meta.total_runs\": 0, \"meta.achievements\": [],\n\t\t\"meta.run_history\": [], \"meta.unlocked_titles\": []})\n\t_game.set(\"_ending_new_titles\", [])\n\t_game.set(\"_ending_new_achievements\", [])\n\t_game.call(\"_refresh_all\")\n\nfunc _a11_observed_state(before: Dictionary, expected: Dictionary, disk_before: String,\n\t\tdisk_expected: String) -> Dictionary:\n\tvar observation: Dictionary = _next_observed_state(before, expected, disk_before, disk_expected)\n\t# Effect subobservations retain full before/independent-expected/after even on success.\n\tobservation[\"before\"] = before.duplicate(true)\n\tobservation[\"expected\"] = expected.duplicate(true)\n\tobservation[\"after\"] = _state()\n\tobservation[\"disk_before\"] = disk_before\n\tobservation[\"disk_expected\"] = disk_expected\n\tobservation[\"disk_after\"] = _disk()\n\treturn observation\n\nfunc _a11_record(locale: String, family: String, actual: Variant, expected: Variant,\n\t\tbefore: Dictionary, expected_state: Dictionary, disk_before: String,\n\t\tdisk_expected: String, details: Dictionary = {}, full_state: bool = false) -> void:\n\tvar observation: Dictionary = _a11_observed_state(before, expected_state, disk_before, disk_expected) if full_state else _next_observed_state(before, expected_state, disk_before, disk_expected)\n\tvar raw_ok: bool = MetaProgression.ALL_TITLES == RAW_TITLES and MetaProgression.TITLE_EN == OLD_EN\n\tvar state_ok: bool = bool(observation[\"state_exact\"]) and bool(observation[\"disk_exact\"]) and raw_ok\n\tvar passed: bool = actual == expected and state_ok\n\t_a11_case_count += 1\n\tif not passed:\n\t\t_failures.append(\"%s/a11/%s actual=%s expected=%s state_ok=%s\" % [\n\t\t\tlocale, family, JSON.stringify(actual), JSON.stringify(expected), str(state_ok)])\n\tdetails = details.duplicate(true)\n\tdetails[\"raw50_and_en50_exact\"] = raw_ok\n\tdetails[\"state_observation\"] = observation\n\tprint(\"META_TITLE_A11_CASE \" + JSON.stringify({\n\t\t\"id\": locale + \"/a11/\" + family, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": passed, \"state_ok\": state_ok, \"details\": details}))\n\nfunc _a11_history_group(locale: String) -> Dictionary:\n\t# Read and validate ALL11 current dictionaries before authorizing any projection.\n\tvar originals: Array = _next_actual_values(A11_SELECTED)\n\tvar expected_current: Array = _a11_values(A11_SELECTED, locale)\n\tvar valid: bool = originals == expected_current and originals.size() == 11\n\tif originals != _next_actual_values(A11_SELECTED):\n\t\tvalid = false\n\t\t_failures.append(\"A11 original getter values changed during history preparation\")\n\tvar rows: Array = []\n\tvar projected_by_id: Dictionary = {}\n\tfor index in range(A11_SELECTED.size()):\n\t\tvar title_id: String = str(A11_SELECTED[index])\n\t\tvar actual: Dictionary = originals[index]\n\t\tvar projected: Dictionary = actual.duplicate(true)\n\t\tvar fields: Array = []\n\t\tif valid:\n\t\t\tvar old_value: Dictionary = _next_expected(title_id, locale)\n\t\t\tfor field in [\"name\", \"desc\"]:\n\t\t\t\tif projected.get(field) != old_value.get(field):\n\t\t\t\t\tfields.append(field)\n\t\t\t\tprojected[field] = old_value[field]\n\t\tprojected_by_id[title_id] = projected\n\t\trows.append({\"id\": title_id, \"current\": actual.duplicate(true),\n\t\t\t\"independent_expected_current\": expected_current[index], \"projected\": projected,\n\t\t\t\"authorization\": valid, \"changed_fields\": fields})\n\tif not valid:\n\t\t_failures.append(\"A11 full current group invalid before historical projection\")\n\t\t# Fail closed: return actual values, never the projected view on rejection.\n\t\tfor index in range(A11_SELECTED.size()):\n\t\t\tprojected_by_id[A11_SELECTED[index]] = originals[index].duplicate(true)\n\treturn {\"authorized\": valid, \"rows\": rows, \"by_id\": projected_by_id,\n\t\t\"scope\": \"A11 validated name/desc-only historical observation; not raw current localization\"}\n\nfunc _a11_get(locale: String, title_id: String) -> void:\n\t_a11_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\t_a11_record(locale, \"get/\" + title_id, MetaProgression.get_title_info(title_id),\n\t\t_a11_expected(title_id, locale), before, before, disk, disk)\n\nfunc _a11_preserved(locale: String) -> void:\n\t_a11_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar ids: Array = []\n\tfor raw in RAW_TITLES:\n\t\tif not A11_SELECTED.has(raw[\"id\"]):\n\t\t\tids.append(raw[\"id\"])\n\t_a11_record(locale, \"preserved_old19_remaining20\", _next_actual_values(ids),\n\t\t_next_values(ids, locale), before, before, disk, disk,\n\t\t{\"old19_localized\": 19, \"remaining20_unmodified\": 20, \"projection\": false})\n\nfunc _a11_unknown_custom(locale: String) -> void:\n\t_a11_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor title_id in [\"\", \"qa_a11_unknown_title\", \"FIRST_INVESTMENT\", \"first_investment \"]:\n\t\tactual.append(MetaProgression.get_title_info(title_id))\n\t\texpected.append({})\n\tvar samples: Array = [{}, {\"name\": \"User title\", \"desc\": \"missing ID\", \"custom\": [1, \"家族\"]},\n\t\t{\"id\": \"qa_a11_unknown_title\", \"name\": \"User title\", \"desc\": \"UNCHANGED\", \"cat\": \"custom\", \"rare\": \"custom\"},\n\t\t{\"id\": \"first_investment \", \"name\": \"User title\", \"nested\": {\"original\": true}}]\n\tfor title_id in A11_SELECTED:\n\t\tvar known: Dictionary = _raw(str(title_id)).duplicate(true)\n\t\tknown[\"name\"] = \"Custom input name\"\n\t\tknown[\"desc\"] = \"Custom input description\"\n\t\tknown[\"custom\"] = {\"history\": [\"original 中文\", 7], \"keep\": true}\n\t\tsamples.append(known)\n\tfor sample in samples:\n\t\tvar original: Dictionary = sample.duplicate(true)\n\t\tvar result: Dictionary = MetaProgression.call(\"_localized_title\", sample)\n\t\tactual.append({\"result\": result, \"input\": sample})\n\t\texpected.append({\"result\": _a11_expected_custom(original, locale), \"input\": original})\n\t_a11_record(locale, \"unknown_custom\", actual, expected, before, before, disk, disk,\n\t\t{\"unknown_ids\": 4, \"custom_noncanonical\": 4, \"known_custom\": 11})\n\nfunc _a11_collection_expected(locale: String, unlocked: Array) -> Array:\n\tvar expected: Array = []\n\tvar rare_keys: Dictionary = {\"common\": \"일반\", \"uncommon\": \"희귀\", \"rare\": \"레어\", \"legendary\": \"전설\"}\n\tfor raw in _ordered_titles():\n\t\tvar title_id: String = str(raw[\"id\"])\n\t\tvar is_unlocked: bool = unlocked.has(title_id)\n\t\tvar title: Dictionary = _a11_expected(title_id, locale)\n\t\texpected.append({\"name\": str(title[\"name\"]) if is_unlocked else _a11_parent(\"미발견 칭호\", locale),\n\t\t\t\"desc\": str(title[\"desc\"]) if is_unlocked else \"\",\n\t\t\t\"status\": _a11_parent(\"획득\" if is_unlocked else \"미발견\", locale),\n\t\t\t\"rare\": _a11_parent(rare_keys[raw[\"rare\"]], locale)})\n\treturn expected\n\nfunc _a11_collection(locale: String, unlocked: bool) -> void:\n\t_a11_reset()\n\tvar ids: Array = A11_SELECTED.duplicate() if unlocked else []\n\tMetaProgression.data[\"unlocked_titles\"] = ids.duplicate()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = _collection_actual()\n\tvar bonus: Dictionary = {\"investment_skill\": 4, \"money\": 250000} if unlocked else {}\n\t_a11_record(locale, \"collection_unlocked\" if unlocked else \"collection_locked\",\n\t\t{\"cards\": actual, \"bonus\": MetaProgression.get_run_start_bonus()},\n\t\t{\"cards\": _a11_collection_expected(locale, ids), \"bonus\": bonus},\n\t\tbefore, before, disk, disk, {\"cards\": 50, \"seeded_IDs_not_naturally_earned\": true})\n\t_game.call(\"_close_modal\", false, false)\n\nfunc _a11_conditions(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor row in A11_CONDITION_ROWS:\n\t\t_a11_reset()\n\t\t_a11_apply_fields(row[\"set\"])\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar observed: bool = MetaProgression.call(\"_check_title_condition\", str(row[\"title_id\"]))\n\t\tvar state: Dictionary = _next_observed_state(before, before, disk, disk)\n\t\tactual.append([observed, state[\"state_exact\"], state[\"disk_exact\"]])\n\t\texpected.append([bool(row[\"expect\"]), true, true])\n\t\tobservations.append({\"id\": row[\"id\"], \"title_id\": row[\"title_id\"], \"inputs\": row[\"set\"],\n\t\t\t\"expected\": row[\"expect\"], \"actual\": observed, \"state\": state})\n\t_a11_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_a11_record(locale, \"condition_boundaries\", actual, expected,\n\t\tfinal_before, final_before, final_disk, final_disk,\n\t\t{\"condition_rows\": observations, \"producers_invoked\": false, \"nested_count\": 35})\n\nfunc _a11_unlock_setup() -> void:\n\t_a11_reset()\n\tvar ids: Array = []\n\tfor raw in RAW_TITLES:\n\t\tif not A11_SELECTED.has(raw[\"id\"]):\n\t\t\tids.append(raw[\"id\"])\n\tMetaProgression.data[\"unlocked_titles\"] = ids\n\t_a11_apply_fields({\"game.money\": 100000000.0, \"game.investment_skill\": 70,\n\t\t\"game.flags.had_first_investment\": true, \"game.flags.margin_called_happened\": true,\n\t\t\"game.flags.was_broke_once\": true, \"meta.total_runs\": 10,\n\t\t\"meta.achievements\": [\"gangnam_dream\", \"survived_burnout\"],\n\t\t\"meta.run_history\": [{\"ending_id\": \"ordinary_life\"}]})\n\t_game.call(\"_refresh_all\")\n\nfunc _a11_unlock_expected(before: Dictionary) -> Dictionary:\n\tvar expected: Dictionary = before.duplicate(true)\n\tvar ids: Array = expected[\"meta\"][\"unlocked_titles\"].duplicate()\n\tids.append_array(A11_SELECTED)\n\texpected[\"meta\"][\"unlocked_titles\"] = ids\n\treturn expected\n\nfunc _a11_unlock_return_duplicate(locale: String) -> void:\n\t_a11_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_state: Dictionary = _a11_unlock_expected(before)\n\tvar expected_disk: String = JSON.stringify(expected_state[\"meta\"], \"\\t\")\n\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\tvar first: Dictionary = _a11_observed_state(before, expected_state, disk, expected_disk)\n\tvar duplicate_before: Dictionary = _state()\n\tvar duplicate_disk: String = _disk()\n\tvar duplicate: Array = MetaProgression.check_and_unlock_titles()\n\tvar direct_duplicate: bool = MetaProgression.unlock_title(\"first_investment\")\n\tvar second: Dictionary = _a11_observed_state(duplicate_before, expected_state, duplicate_disk, expected_disk)\n\t_a11_record(locale, \"unlock_return_duplicate\",\n\t\t[newly, duplicate, direct_duplicate, first[\"state_exact\"], first[\"disk_exact\"], second[\"state_exact\"], second[\"disk_exact\"]],\n\t\t[_a11_values(A11_SELECTED, locale), [], false, true, true, true, true],\n\t\tbefore, expected_state, disk, expected_disk, {\"first\": first, \"duplicate\": second}, true)\n\nfunc _a11_unlock_toasts(locale: String, record_log: bool) -> void:\n\t_a11_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_state: Dictionary = _a11_unlock_expected(before)\n\tvar expected_toasts: Array = []\n\tvar expected_messages: Array = []\n\tvar date: String = _a11_parent(\"%d년 %d월 %d주차\", locale) % [\n\t\tbefore[\"game\"][\"year\"], before[\"game\"][\"month\"], before[\"game\"][\"week_of_month\"]]\n\tfor title in _a11_values(A11_SELECTED, locale):\n\t\texpected_toasts.append(_a11_parent(\"칭호 해금: 「%s」\", locale) % title[\"name\"])\n\t\tif record_log:\n\t\t\tvar message: String = _a11_parent(\"칭호 해금: %s\", locale) % title[\"name\"]\n\t\t\texpected_messages.append(message)\n\t\t\texpected_state[\"game\"][\"action_log\"].append({\"turn\": before[\"game\"][\"turn\"], \"date\": date, \"message\": message, \"type\": \"system\"})\n\t_game.call(\"_check_title_unlocks\", record_log)\n\tvar messages: Array = []\n\tfor entry in GameState.action_log.slice(before[\"game\"][\"action_log\"].size()):\n\t\tmessages.append(entry[\"message\"])\n\t_a11_record(locale, \"unlock_toast_log\" if record_log else \"monthly_component_toast_without_game_log\",\n\t\t[_toast_texts(), messages], [expected_toasts, expected_messages], before, expected_state,\n\t\tdisk, JSON.stringify(expected_state[\"meta\"], \"\\t\"),\n\t\t{\"record_game_log\": record_log, \"not_whole_month_advancement\": true}, true)\n\nfunc _a11_ending_cards(locale: String) -> void:\n\t_a11_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_first: Dictionary = _a11_unlock_expected(before)\n\tvar titles: Array = _a11_values(A11_SELECTED, locale)\n\texpected_first[\"ending_titles\"] = titles.duplicate(true)\n\tvar expected_disk: String = JSON.stringify(expected_first[\"meta\"], \"\\t\")\n\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\t_game.set(\"_ending_new_titles\", newly.duplicate(true))\n\tvar first_box := VBoxContainer.new()\n\tadd_child(first_box)\n\t_game.call(\"_ending_add_unlocks\", first_box)\n\tvar first_texts: Array = _ending_texts(first_box)\n\tvar first_state: Dictionary = _a11_observed_state(before, expected_first, disk, expected_disk)\n\tfirst_box.queue_free()\n\tvar second_before: Dictionary = _state()\n\tvar second_disk: String = _disk()\n\tvar duplicate: Array = MetaProgression.check_and_unlock_titles()\n\tvar expected_final: Dictionary = expected_first.duplicate(true)\n\texpected_final[\"ending_titles\"] = []\n\t_game.set(\"_ending_new_titles\", duplicate.duplicate(true))\n\tvar empty_box := VBoxContainer.new()\n\tadd_child(empty_box)\n\t_game.call(\"_ending_add_unlocks\", empty_box)\n\tvar empty_texts: Array = _ending_texts(empty_box)\n\tvar second_state: Dictionary = _a11_observed_state(second_before, expected_final, second_disk, expected_disk)\n\tempty_box.queue_free()\n\t_a11_record(locale, \"ending_cached_cards\",\n\t\t[first_texts, duplicate, empty_texts, first_state[\"state_exact\"], first_state[\"disk_exact\"], second_state[\"state_exact\"], second_state[\"disk_exact\"]],\n\t\t[_ending_expected(locale, titles), [], [_a11_parent(\"새로 열린 기록 없음\", locale)], true, true, true, true],\n\t\tbefore, expected_final, disk, expected_disk,\n\t\t{\"first\": first_state, \"empty_after_duplicate\": second_state, \"full_ending_not_invoked\": true}, true)\n\nfunc _a11_language_storage(locale: String) -> void:\n\t_a11_reset()\n\tMetaProgression.data[\"unlocked_titles\"] = A11_SELECTED.duplicate()\n\tMetaProgression.data[\"qa_custom\"] = {\"player\": \"QA Custom Player\", \"history\": [\"original 中文\", 7], \"keep\": true}\n\t_game.set(\"_ending_new_titles\", _a11_values(A11_SELECTED, locale))\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_disk: String = JSON.stringify(before[\"meta\"], \"\\t\")\n\tvar expected_parsed: Dictionary = JSON.parse_string(expected_disk)\n\tvar expected_state: Dictionary = before.duplicate(true)\n\texpected_state[\"meta\"] = expected_parsed.duplicate(true)\n\tMetaProgression.save_meta()\n\tvar saved_exact: bool = _disk() == expected_disk\n\tvar saved_state: Dictionary = _a11_observed_state(before, before, disk, expected_disk)\n\tvar load_before: Dictionary = _state()\n\tvar load_disk: String = _disk()\n\tMetaProgression.load_meta()\n\tvar loaded_exact: bool = MetaProgression.data == expected_parsed\n\tvar loaded_state: Dictionary = _a11_observed_state(load_before, expected_state, load_disk, expected_disk)\n\tvar alternate: String = \"en\" if locale == \"ko\" else \"ko\"\n\tLocaleManager.set_language(alternate)\n\tvar alternate_values: Array = _next_actual_values(A11_SELECTED)\n\tvar alternate_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\tvar box := VBoxContainer.new()\n\tadd_child(box)\n\t_game.call(\"_ending_add_unlocks\", box)\n\tvar cached_actual: Array = _ending_texts(box)\n\tvar cached_expected: Array = _ending_expected(alternate, _a11_values(A11_SELECTED, locale))\n\tbox.queue_free()\n\tLocaleManager.set_language(locale)\n\tvar returned_values: Array = _next_actual_values(A11_SELECTED)\n\tvar returned_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\t_a11_record(locale, \"language_storage_cached_origin\",\n\t\t[saved_exact, loaded_exact, alternate_values, alternate_cards, cached_actual, returned_values, returned_cards, MetaProgression.get_unlocked_titles(), saved_state[\"state_exact\"], loaded_state[\"state_exact\"]],\n\t\t[true, true, _a11_values(A11_SELECTED, alternate), _a11_collection_expected(alternate, A11_SELECTED), cached_expected, _a11_values(A11_SELECTED, locale), _a11_collection_expected(locale, A11_SELECTED), A11_SELECTED, true, true],\n\t\tbefore, expected_state, disk, expected_disk,\n\t\t{\"saved\": saved_state, \"loaded\": loaded_state, \"alternate\": alternate,\n\t\t \"cached_title_origin_preserved\": true, \"parsed_expectation_frozen_before_load\": true}, true)\n\nfunc _a11_shared_reader(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tfor row in A11_SHARED_ROWS:\n\t\t_a11_reset()\n\t\tfor flag_id in [\"arc_daeun_wedding_day_seen\", \"arc_jiyeon_wedding_gap_seen\", \"daeun_romance_started\", \"jiyeon_romance_started\"]:\n\t\t\tGameState.flags[flag_id] = false\n\t\t_a11_apply_fields(row[\"set\"])\n\t\t_game.call(\"_refresh_all\")\n\t\tvar before: Dictionary = _state()\n\t\tvar disk: String = _disk()\n\t\tvar label: String = GameState.get_current_title()\n\t\tvar condition: bool = MetaProgression.call(\"_check_title_condition\", \"gangnam_dream_title\")\n\t\tvar expected_label: String = \"\"\n\t\tif row.has(\"expected_gs\"):\n\t\t\texpected_label = \"Gangnam Dreamer\" if locale == \"en\" else str(_a11_expected(\"gangnam_dream_title\", locale)[\"name\"])\n\t\telse:\n\t\t\tvar key: String = str(row[\"expected_gs_ref\"]).trim_prefix(\"parent_expectations.\")\n\t\t\texpected_label = _a11_parent(key, locale)\n\t\tvar state: Dictionary = _next_observed_state(before, before, disk, disk)\n\t\tactual.append([label, condition, state[\"state_exact\"], state[\"disk_exact\"]])\n\t\texpected.append([expected_label, bool(row[\"expected_meta_condition\"]), true, true])\n\t\tobservations.append({\"id\": row[\"id\"], \"inputs\": row[\"set\"], \"state\": state,\n\t\t\t\"expected_label\": expected_label, \"actual_label\": label,\n\t\t\t\"expected_meta_condition\": row[\"expected_meta_condition\"], \"actual_meta_condition\": condition})\n\t_a11_reset()\n\tvar final_before: Dictionary = _state()\n\tvar final_disk: String = _disk()\n\t_a11_record(locale, \"shared_gangnam_current_reader\", actual, expected,\n\t\tfinal_before, final_before, final_disk, final_disk,\n\t\t{\"rows\": observations, \"source_specific_English_preserved\": true})\n\nfunc _a11_run_groups(locale: String) -> void:\n\tfor title_id in A11_SELECTED:\n\t\t_a11_get(locale, str(title_id))\n\t_a11_preserved(locale)\n\t_a11_unknown_custom(locale)\n\t_a11_collection(locale, false)\n\t_a11_collection(locale, true)\n\t_a11_conditions(locale)\n\t_a11_unlock_return_duplicate(locale)\n\t_a11_unlock_toasts(locale, true)\n\t_a11_unlock_toasts(locale, false)\n\t_a11_ending_cards(locale)\n\t_a11_language_storage(locale)\n\t_a11_shared_reader(locale)\n\nfunc _a11_fixture_ready() -> bool:\n\tif not A11_FIXTURE_APPROVED or A11_SELECTED.size() != 11 or A11_ROWS.size() != 22 or A11_CONDITION_ROWS.size() != 35 or A11_SHARED_ROWS.size() != 4:\n\t\treturn false\n\tvar pairs: Dictionary = {}\n\tfor row in A11_ROWS:\n\t\tvar title_id: String = str(row[\"id\"])\n\t\tvar field: String = str(row[\"field\"])\n\t\tif not A11_SELECTED.has(title_id) or not [\"name\", \"desc\"].has(field):\n\t\t\treturn false\n\t\tvar key: String = title_id + \"/\" + field\n\t\tif pairs.has(key) or str(_raw(title_id).get(field, \"\")) != row[\"ko\"] or str(OLD_EN[title_id].get(field, \"\")) != row[\"en\"]:\n\t\t\treturn false\n\t\tfor locale in LOCALES:\n\t\t\tif not row.has(locale) or not row[locale] is String or str(row[locale]).is_empty():\n\t\t\t\treturn false\n\t\tpairs[key] = true\n\treturn pairs.size() == 22\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _run() -> void:\n\tif not _isolation() or not FIXTURE_APPROVED or not _next_fixture_ready() or not _a11_fixture_ready() or ROWS.size() != 18 or RAW_TITLES.size() != 50 or CONDITION_ROWS.size() != 20:\n\t\tpush_error(\"META_TITLE_CHECK_FAIL isolation or reviewed fixed fixture required\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tEngine.max_fps = 60\n\tawait _frames(3)\n\tGameState.start_new_game(\"QA Custom Player\", \"지방_상경\", \"none\", \"알바\", \"자유런\", \"현실\")\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_baseline = _state()\n\tfor locale in LOCALES:\n\t\t_restore_baseline()\n\t\tLocaleManager.set_language(locale)\n\t\tawait _frames(1)\n\t\t_game = MAIN_GAME.instantiate() as Control\n\t\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\t\tadd_child(_game)\n\t\tawait _frames(5)\n\t\tfor title_id in SELECTED:\n\t\t\t_selected(locale, title_id)\n\t\t_unselected(locale)\n\t\t_unknown_custom(locale)\n\t\t_collection(locale, false)\n\t\t_collection(locale, true)\n\t\t_conditions(locale)\n\t\t_unlock_return_duplicate(locale)\n\t\t_unlock_toasts(locale, true)\n\t\t_unlock_toasts(locale, false)\n\t\t_ending_cards(locale)\n\t\t_language_storage(locale)\n\t\t_shared_gosiwon_readers(locale)\n\t\t_next_run_groups(locale)\n\t\t_a11_run_groups(locale)\n\t\tawait _shutdown()\n\t\t_game = null\n\t_restore_baseline()\n\tvar restored: bool = _state() == _baseline\n\tprint(\"META_TITLE_STATE_RESTORED=%d\" % int(restored))\n\tif not restored:\n\t\t_failures.append(\"pre-fixture GameState/MetaProgression memory not restored\")\n\tif _case_count != 100:\n\t\t_failures.append(\"fixed original95 + shared5 groups required, got %d\" % _case_count)\n\tif _next_case_count != 100:\n\t\t_failures.append(\"fixed next100 groups required, got %d\" % _next_case_count)\n\tif _a11_case_count != 110:\n\t\t_failures.append(\"fixed A11 110 groups required, got %d\" % _a11_case_count)\n\tif not _failures.is_empty():\n\t\tfor failure in _failures:\n\t\t\tpush_error(\"META_TITLE_CHECK_FAIL \" + failure)\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"META_TITLE_CHECK_OK cases=100 locales=5 selected=9 unselected=41 conditions=20 shared_readers=2 isolation=preautoload rendered=0\")\n\tprint(\"META_TITLE_NEXT_CHECK_OK cases=100 locales=5 selected=10 preserved=40 conditions=23 isolation=preautoload rendered=0\")\n\tprint(\"META_TITLE_A11_CHECK_OK cases=110 locales=5 selected=11 preserved=39 conditions=35 shared_rows=4 isolation=preautoload rendered=0\")\n\tget_tree().quit(0)\n\nfunc _wrapper(ko: String, locale: String) -> String:\n\tfor row in WRAPPERS:\n\t\tif row[\"ko\"] == ko:\n\t\t\treturn str(row[locale])\n\t_failures.append(\"missing frozen wrapper: \" + ko)\n\treturn \"<missing frozen wrapper>\"\n\nfunc _raw(title_id: String) -> Dictionary:\n\tfor row in RAW_TITLES:\n\t\tif row[\"id\"] == title_id:\n\t\t\treturn row.duplicate(true)\n\treturn {}\n\nfunc _expected(title_id: String, locale: String) -> Dictionary:\n\treturn _expected_custom(_raw(title_id), locale)\n\nfunc _expected_custom(original: Dictionary, locale: String) -> Dictionary:\n\tvar value: Dictionary = original.duplicate(true)\n\tvar title_id: String = str(original.get(\"id\", \"\"))\n\tif locale == \"ko\" or not OLD_EN.has(title_id):\n\t\treturn value\n\tfor key in OLD_EN[title_id]:\n\t\tvalue[key] = OLD_EN[title_id][key]\n\tif locale != \"en\" and SELECTED.has(title_id):\n\t\tfor row in ROWS:\n\t\t\tif row[\"id\"] == title_id:\n\t\t\t\tvalue[row[\"field\"]] = row[locale]\n\treturn value\n\nfunc _selected_array(locale: String) -> Array:\n\tvar values: Array = []\n\tfor title_id in SELECTED:\n\t\tvalues.append(_expected(title_id, locale))\n\treturn values\n\nfunc _record(locale: String, family: String, actual: Variant, expected: Variant,\n\t\tbefore: Dictionary, expected_state: Dictionary, disk_before: String,\n\t\tdisk_expected: String, full_state: bool = false, details: Dictionary = {}) -> void:\n\tvar after: Dictionary = _state()\n\tvar disk_after: String = _disk()\n\tvar raw_ok: bool = MetaProgression.ALL_TITLES == RAW_TITLES and MetaProgression.TITLE_EN == OLD_EN\n\tvar state_ok: bool = after == expected_state and disk_after == disk_expected and raw_ok\n\tvar passed: bool = actual == expected and state_ok\n\t_case_count += 1\n\tif not passed:\n\t\t_failures.append(\"%s/%s actual=%s expected=%s state_ok=%s\" % [\n\t\t\tlocale, family, JSON.stringify(actual), JSON.stringify(expected), str(state_ok)])\n\tdetails = details.duplicate(true)\n\tdetails[\"raw50_and_en50_exact\"] = raw_ok\n\tdetails[\"player_name_after\"] = GameState.player_name\n\tdetails[\"before_sha256\"] = JSON.stringify(before).sha256_text()\n\tdetails[\"expected_sha256\"] = JSON.stringify(expected_state).sha256_text()\n\tdetails[\"after_sha256\"] = JSON.stringify(after).sha256_text()\n\tdetails[\"delta\"] = _delta(before, after)\n\tdetails[\"unexpected_delta\"] = _delta(expected_state, after)\n\tdetails[\"meta_disk\"] = {\"path\": MetaProgression.meta_save_path(),\n\t\t\"before_sha256\": disk_before.sha256_text(), \"expected_sha256\": disk_expected.sha256_text(),\n\t\t\"after_sha256\": disk_after.sha256_text(), \"exact\": disk_after == disk_expected,\n\t\t\"retained_in_new_namespace\": true}\n\tif full_state or not passed:\n\t\tdetails[\"before\"] = before\n\t\tdetails[\"expected_state\"] = expected_state\n\t\tdetails[\"after\"] = after\n\t\tdetails[\"meta_disk\"][\"before_text\"] = disk_before\n\t\tdetails[\"meta_disk\"][\"expected_text\"] = disk_expected\n\t\tdetails[\"meta_disk\"][\"after_text\"] = disk_after\n\tprint(\"META_TITLE_CASE \" + JSON.stringify({\n\t\t\"id\": locale + \"/\" + family, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": passed, \"state_ok\": state_ok, \"details\": details}))\n\nfunc _delta(before: Dictionary, after: Dictionary) -> Dictionary:\n\tvar changes: Dictionary = {}\n\tfor section in before:\n\t\tif before[section] == after.get(section):\n\t\t\tcontinue\n\t\tif before[section] is Dictionary and after.get(section) is Dictionary:\n\t\t\tvar keys: Array = before[section].keys()\n\t\t\tfor key in after[section]:\n\t\t\t\tif not keys.has(key):\n\t\t\t\t\tkeys.append(key)\n\t\t\tfor key in keys:\n\t\t\t\tif before[section].get(key) != after[section].get(key) or before[section].has(key) != after[section].has(key):\n\t\t\t\t\tchanges[str(section) + \"/\" + str(key)] = {\n\t\t\t\t\t\t\"before\": before[section].get(key), \"after\": after[section].get(key)}\n\t\telse:\n\t\t\tchanges[section] = {\"before\": before[section], \"after\": after.get(section)}\n\tfor section in after:\n\t\tif not before.has(section):\n\t\t\tchanges[section] = {\"before\": null, \"after\": after[section]}\n\treturn changes\n\nfunc _selected(locale: String, title_id: String) -> void:\n\t_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Dictionary = MetaProgression.get_title_info(title_id)\n\t_record(locale, \"selected/\" + title_id, actual, _expected(title_id, locale),\n\t\tbefore, before, disk, disk)\n\nfunc _unselected(locale: String) -> void:\n\t_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar observations: Array = []\n\tvar a11_history: Dictionary = _a11_history_group(locale)\n\tfor title_id in UNSELECTED:\n\t\tvar current: Dictionary = MetaProgression.get_title_info(title_id)\n\t\tif A11_SELECTED.has(title_id):\n\t\t\tactual.append(a11_history[\"by_id\"][title_id])\n\t\telif NEXT_SELECTED.has(title_id):\n\t\t\tvar observation: Dictionary = _next_project_old41(title_id, locale, current)\n\t\t\tactual.append(observation[\"projected\"])\n\t\t\tobservations.append(observation)\n\t\telse:\n\t\t\tactual.append(current)\n\t\texpected.append(_expected(title_id, locale))\n\t_record(locale, \"unselected41\", actual, expected, before, before, disk, disk, false,\n\t\t{\"validated_current10_then_historical_name_desc_only\": observations,\n\t\t \"validated_A11_then_historical_name_desc_only\": a11_history,\n\t\t \"other95_groups_direct_current\": true})\n\nfunc _unknown_custom(locale: String) -> void:\n\t_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar ids: Array = [\"\", \"qa_unknown_title\", \"GOSIWON_SURVIVOR\", \"gosiwon_survivor \"]\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor title_id in ids:\n\t\tactual.append(MetaProgression.get_title_info(title_id))\n\t\texpected.append({})\n\tvar samples: Array = [{}, {\"name\": \"User title\", \"desc\": \"missing ID\", \"custom\": [1, \"家族\"]},\n\t\t{\"id\": \"qa_unknown_title\", \"name\": \"User title\", \"desc\": \"UNCHANGED\", \"cat\": \"custom\", \"rare\": \"custom\"},\n\t\t{\"id\": \"gosiwon_survivor \", \"name\": \"User title\", \"nested\": {\"original\": true}}]\n\tvar selected_custom: Dictionary = _raw(\"gosiwon_survivor\")\n\tselected_custom[\"name\"] = \"Custom input name\"\n\tselected_custom[\"desc\"] = \"Custom input description\"\n\tselected_custom[\"custom\"] = {\"history\": [\"original\", 7], \"keep\": true}\n\tsamples.append(selected_custom)\n\tfor sample in samples:\n\t\tvar original: Dictionary = sample.duplicate(true)\n\t\tvar result: Dictionary = MetaProgression.call(\"_localized_title\", sample)\n\t\tactual.append({\"result\": result, \"input\": sample})\n\t\texpected.append({\"result\": _expected_custom(original, locale), \"input\": original})\n\t_record(locale, \"unknown_custom\", actual, expected, before, before, disk, disk,\n\t\tfalse, {\"known_custom_KO_retains_input_nonKO_canonical_fields\": true})\n\nfunc _ordered_titles() -> Array:\n\tvar rows: Array = []\n\tfor category in [\"주거\", \"직업\", \"투자\", \"성향\", \"관계\", \"생활\", \"자산\", \"메타\", \"미니게임\", \"이야기\"]:\n\t\tfor row in RAW_TITLES:\n\t\t\tif row[\"cat\"] == category:\n\t\t\t\trows.append(row)\n\treturn rows\n\nfunc _collection_expected(locale: String, unlocked: Array) -> Array:\n\tvar expected: Array = []\n\tvar rare_keys: Dictionary = {\"common\": \"일반\", \"uncommon\": \"희귀\", \"rare\": \"레어\", \"legendary\": \"전설\"}\n\tfor raw in _ordered_titles():\n\t\tvar title_id: String = str(raw[\"id\"])\n\t\tvar is_unlocked: bool = unlocked.has(title_id)\n\t\tvar title: Dictionary = _expected(title_id, locale)\n\t\texpected.append({\"name\": str(title[\"name\"]) if is_unlocked else _wrapper(\"미발견 칭호\", locale),\n\t\t\t\"desc\": str(title[\"desc\"]) if is_unlocked else \"\",\n\t\t\t\"status\": _wrapper(\"획득\" if is_unlocked else \"미발견\", locale),\n\t\t\t\"rare\": _wrapper(rare_keys[raw[\"rare\"]], locale)})\n\treturn expected\n\nfunc _collection_actual() -> Array:\n\t_game.call(\"_open_title_collection\")\n\tvar body: VBoxContainer = _game.get(\"modal_body\")\n\tvar actual: Array = []\n\tfor child in body.get_children():\n\t\tif not child is PanelContainer or child.is_queued_for_deletion():\n\t\t\tcontinue\n\t\tvar row: HBoxContainer = child.get_child(0) as HBoxContainer\n\t\tvar text_col: VBoxContainer = row.get_child(0) as VBoxContainer\n\t\tvar top: HBoxContainer = text_col.get_child(0) as HBoxContainer\n\t\tactual.append({\"name\": (top.get_child(0) as Label).text,\n\t\t\t\"desc\": (text_col.get_child(1) as Label).text if text_col.get_child_count() > 1 else \"\",\n\t\t\t\"status\": (row.get_child(1).get_child(0) as Label).text,\n\t\t\t\"rare\": (top.get_child(1).get_child(0) as Label).text})\n\treturn actual\n\nfunc _collection(locale: String, unlocked: bool) -> void:\n\t_reset()\n\tvar ids: Array = SELECTED.duplicate() if unlocked else []\n\tMetaProgression.data[\"unlocked_titles\"] = ids.duplicate()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = _collection_actual()\n\t# Frozen PERK_RULES: housing5 caps mental at4; career4 gives intelligence4.\n\tvar expected_bonus: Dictionary = {\"mental\": 4, \"intelligence\": 4} if unlocked else {}\n\t_record(locale, \"collection_unlocked\" if unlocked else \"collection_locked\",\n\t\t{\"cards\": actual, \"bonus\": MetaProgression.get_run_start_bonus()},\n\t\t{\"cards\": _collection_expected(locale, ids), \"bonus\": expected_bonus}, before, before, disk, disk,\n\t\tfalse, {\"actual_50_cards\": true, \"locked_description_empty\": true, \"raw_category_bonus_preserved\": true})\n\t_game.call(\"_close_modal\", false, false)\n\nfunc _conditions(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar preserved: bool = true\n\tvar observations: Array = []\n\tfor row in CONDITION_ROWS:\n\t\t_reset()\n\t\tvar field: String = str(row[1])\n\t\tvar value: Variant = row[2]\n\t\tif value is Array or value is Dictionary:\n\t\t\tvalue = value.duplicate(true)\n\t\tif field.begins_with(\"flag:\"):\n\t\t\t# Frozen descriptors use \"flag: name\"; the separator space is not part of the flag ID.\n\t\t\tGameState.flags[field.trim_prefix(\"flag:\").strip_edges()] = value\n\t\telif field != \"none\":\n\t\t\tGameState.set(field, value)\n\t\tvar before_row: Dictionary = _state()\n\t\tvar disk_row: String = _disk()\n\t\tactual.append(MetaProgression.call(\"_check_title_condition\", str(row[0])))\n\t\texpected.append(bool(row[3]))\n\t\tvar same: bool = _state() == before_row and _disk() == disk_row\n\t\tpreserved = preserved and same\n\t\tobservations.append({\"id\": row[0], \"field\": field, \"input\": value,\n\t\t\t\"unchanged\": same, \"delta\": _delta(before_row, _state())})\n\t_reset()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\t_record(locale, \"condition_boundaries\", {\"results\": actual, \"all_unchanged\": preserved},\n\t\t{\"results\": expected, \"all_unchanged\": true}, before, before, disk, disk, false,\n\t\t{\"conditions20\": observations, \"condition_inputs_not_unlock_side_effects\": true})\n\nfunc _unlock_setup() -> void:\n\t_reset()\n\t# All unselected IDs are already unlocked; only the declared nine can be newly added.\n\tMetaProgression.data[\"unlocked_titles\"] = UNSELECTED.duplicate()\n\tGameState.housing_months = {\"gosiwon\": 24}\n\tGameState.housing = \"gangnam\"\n\tGameState.job_tenure = 36\n\tGameState.flags[\"housing_moved_once\"] = true\n\tGameState.flags[\"has_received_paycheck\"] = true\n\tGameState.flags[\"unemployed_months\"] = 12\n\t# Finish existing UI initialization before the observed operation.\n\t_game.call(\"_refresh_all\")\n\nfunc _unlock_expected(before: Dictionary) -> Dictionary:\n\tvar expected: Dictionary = before.duplicate(true)\n\tvar ids: Array = UNSELECTED.duplicate()\n\tids.append_array(SELECTED)\n\texpected[\"meta\"][\"unlocked_titles\"] = ids\n\treturn expected\n\nfunc _unlock_return_duplicate(locale: String) -> void:\n\t_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_state: Dictionary = _unlock_expected(before)\n\tvar expected_disk: String = JSON.stringify(expected_state[\"meta\"], \"\\t\")\n\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\tvar first_state_exact: bool = _state() == expected_state\n\tvar first_disk_exact: bool = _disk() == expected_disk\n\tvar duplicate: Array = MetaProgression.check_and_unlock_titles()\n\tvar direct_duplicate: bool = MetaProgression.unlock_title(\"gosiwon_survivor\")\n\t_record(locale, \"unlock_return_duplicate\",\n\t\t[newly, duplicate, direct_duplicate, first_state_exact, first_disk_exact],\n\t\t[_selected_array(locale), [], false, true, true],\n\t\tbefore, expected_state, disk, expected_disk, true,\n\t\t{\"expected_append_ids\": SELECTED, \"first_new9_second0\": true, \"save_write_inside_new_namespace\": true})\n\nfunc _toast_texts() -> Array:\n\tvar texts: Array = []\n\tvar container: VBoxContainer = _game.get(\"_toast_container\")\n\tfor toast in container.get_children():\n\t\tif toast.is_queued_for_deletion():\n\t\t\tcontinue\n\t\tvar label: Label = toast.get(\"label\") as Label\n\t\ttexts.append(label.text if label != null else \"<actual toast label missing>\")\n\treturn texts\n\nfunc _unlock_toasts(locale: String, record_log: bool) -> void:\n\t_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_state: Dictionary = _unlock_expected(before)\n\tvar expected_toasts: Array = []\n\tvar expected_messages: Array = []\n\tvar date: String = _wrapper(\"%d년 %d월 %d주차\", locale) % [\n\t\tbefore[\"game\"][\"year\"], before[\"game\"][\"month\"], before[\"game\"][\"week_of_month\"]]\n\tfor title in _selected_array(locale):\n\t\texpected_toasts.append(_wrapper(\"칭호 해금: 「%s」\", locale) % title[\"name\"])\n\t\tif record_log:\n\t\t\tvar message: String = _wrapper(\"칭호 해금: %s\", locale) % title[\"name\"]\n\t\t\texpected_messages.append(message)\n\t\t\texpected_state[\"game\"][\"action_log\"].append({\n\t\t\t\t\"turn\": before[\"game\"][\"turn\"], \"date\": date, \"message\": message, \"type\": \"system\"})\n\t_game.call(\"_check_title_unlocks\", record_log)\n\tvar actual_messages: Array = []\n\tfor entry in GameState.action_log.slice(before[\"game\"][\"action_log\"].size()):\n\t\tactual_messages.append(entry[\"message\"])\n\t_record(locale, \"unlock_toast_log\" if record_log else \"unlock_toast_no_log\",\n\t\t[_toast_texts(), actual_messages], [expected_toasts, expected_messages],\n\t\tbefore, expected_state, disk, JSON.stringify(expected_state[\"meta\"], \"\\t\"), true,\n\t\t{\"record_game_log\": record_log, \"month_false_component_not_full_month_or_autosave\": not record_log,\n\t\t \"date_template_frozen_from_baseline\": true})\n\nfunc _ending_texts(parent: VBoxContainer) -> Array:\n\tvar texts: Array = []\n\t# Actual function adds one heading, then one direct Label per cached new title;\n\t# its other non-title details live in a separate VBoxContainer.\n\tfor index in range(1, parent.get_child_count()):\n\t\tvar child: Node = parent.get_child(index)\n\t\tif child is Label:\n\t\t\ttexts.append(child.text)\n\treturn texts\n\nfunc _ending_expected(locale: String, titles: Array) -> Array:\n\tvar texts: Array = []\n\tfor title in titles:\n\t\ttexts.append(_wrapper(\"칭호: 「%s」  %s\", locale) % [title[\"name\"], title[\"desc\"]])\n\treturn texts\n\nfunc _ending_cards(locale: String) -> void:\n\t_unlock_setup()\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar expected_state: Dictionary = _unlock_expected(before)\n\tvar frozen_titles: Array = _selected_array(locale)\n\texpected_state[\"ending_titles\"] = frozen_titles.duplicate(true)\n\tvar newly: Array = MetaProgression.check_and_unlock_titles()\n\t# Same cache assignment as _show_ending, without broad ending progression/audio/save work.\n\t_game.set(\"_ending_new_titles\", newly.duplicate(true))\n\tvar box := VBoxContainer.new()\n\tadd_child(box)\n\t_game.call(\"_ending_add_unlocks\", box)\n\t_record(locale, \"ending_cards\", _ending_texts(box), _ending_expected(locale, frozen_titles),\n\t\tbefore, expected_state, disk, JSON.stringify(expected_state[\"meta\"], \"\\t\"), true,\n\t\t{\"actual_cache_to_actual_ending_add_unlocks\": true, \"full_ending_not_invoked\": true})\n\tbox.queue_free()\n\nfunc _language_storage(locale: String) -> void:\n\t_reset()\n\tMetaProgression.data[\"unlocked_titles\"] = SELECTED.duplicate()\n\tMetaProgression.data[\"qa_custom\"] = {\"player\": \"QA Custom Player\", \"history\": [\"original 中文\", 7], \"keep\": true}\n\t_game.set(\"_ending_new_titles\", _selected_array(locale))\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\t# Freeze serialization/parse expectation before either save or load.\n\tvar expected_disk: String = JSON.stringify(before[\"meta\"], \"\\t\")\n\tvar expected_parsed: Dictionary = JSON.parse_string(expected_disk)\n\tvar expected_state: Dictionary = before.duplicate(true)\n\texpected_state[\"meta\"] = expected_parsed.duplicate(true)\n\tMetaProgression.save_meta()\n\tvar saved_exact: bool = _disk() == expected_disk\n\tMetaProgression.load_meta()\n\tvar loaded_exact: bool = MetaProgression.data == expected_parsed\n\tvar alternate: String = \"en\" if locale == \"ko\" else \"ko\"\n\tLocaleManager.set_language(alternate)\n\tvar alternate_values: Array = []\n\tfor title_id in SELECTED:\n\t\talternate_values.append(MetaProgression.get_title_info(title_id))\n\tvar alternate_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\tvar box := VBoxContainer.new()\n\tadd_child(box)\n\t_game.call(\"_ending_add_unlocks\", box)\n\tvar cached_actual: Array = _ending_texts(box)\n\tvar cached_expected: Array = _ending_expected(alternate, _selected_array(locale))\n\tbox.queue_free()\n\tLocaleManager.set_language(locale)\n\tvar returned_values: Array = []\n\tfor title_id in SELECTED:\n\t\treturned_values.append(MetaProgression.get_title_info(title_id))\n\tvar returned_cards: Array = _collection_actual()\n\t_game.call(\"_close_modal\", false, false)\n\tvar actual: Array = [saved_exact, loaded_exact, alternate_values, alternate_cards,\n\t\tcached_actual, returned_values, returned_cards, MetaProgression.get_unlocked_titles()]\n\tvar expected: Array = [true, true, _selected_array(alternate), _collection_expected(alternate, SELECTED),\n\t\tcached_expected, _selected_array(locale), _collection_expected(locale, SELECTED), SELECTED]\n\t_record(locale, \"language_storage\", actual, expected, before, expected_state, disk, expected_disk, true,\n\t\t{\"alternate\": alternate, \"parsed_expected_before_load\": true,\n\t\t \"fresh_getter_reopened_collection\": true, \"cached_title_data_remains_original_locale\": true,\n\t\t \"cached_wrapper_uses_new_locale\": true, \"temporary_meta_retained\": true,\n\t\t \"not_a_test_of_every_legacy_migration\": true})\n\nfunc _shared_gosiwon_readers(locale: String) -> void:\n\t_reset()\n\tGameState.money = 500000.0\n\tGameState.portfolio = {}\n\tGameState.loans = {}\n\tGameState.mental = 50\n\tGameState.housing = \"gosiwon\"\n\tGameState.turn = 18\n\tGameState.current_job = {}\n\tGameState.job_tenure = 0\n\tGameState.route_orthodox = 0\n\tGameState.route_unorthodox = 0\n\tGameState.core_loop_v2_state = {}\n\tfor flag_id in [\"arc_daeun_wedding_day_seen\", \"arc_jiyeon_wedding_gap_seen\",\n\t\t\t\"daeun_romance_started\", \"jiyeon_romance_started\", \"creator_viral\", \"startup_exit\",\n\t\t\t\"startup_launched\", \"creator_monetized\", \"creator_started\", \"resume_polished\",\n\t\t\t\"mindset_investor\", \"mindset_saver\"]:\n\t\tGameState.flags[flag_id] = false\n\tGameState.flags[\"study_count_exercise\"] = 0\n\tGameState.flags[\"study_count_read\"] = 0\n\t_game.call(\"_refresh_all\")\n\tvar before: Dictionary = _state()\n\tvar disk: String = _disk()\n\tvar actual: Array = [GameState.get_wealth_tier(), GameState.get_current_title()]\n\tvar expected: Array = [\"Goshiwon Survivor\", \"Long-Term Goshiwon Tenant\"] if locale == \"en\" else [\n\t\t_expected(\"gosiwon_survivor\", locale)[\"name\"], _expected(\"long_gosiwon\", locale)[\"name\"]]\n\t_record(locale, \"shared_gosiwon_readers\", actual, expected, before, before, disk, disk, true,\n\t\t{\"additional_to_original95\": true, \"existing_GameState_source_specific_Goshiwon_EN_preserved\": true})\n\nfunc _state() -> Dictionary:\n\treturn {\"game\": GameState.serialize().duplicate(true),\n\t\t\"meta\": MetaProgression.data.duplicate(true),\n\t\t\"new_this_run\": MetaProgression._new_this_run.duplicate(true),\n\t\t\"turn_log\": _game.get(\"turn_action_log\").duplicate(true) if is_instance_valid(_game) else [],\n\t\t\"ending_titles\": _game.get(\"_ending_new_titles\").duplicate(true) if is_instance_valid(_game) else [],\n\t\t\"ending_achievements\": _game.get(\"_ending_new_achievements\").duplicate(true) if is_instance_valid(_game) else []}\n\nfunc _restore_baseline() -> void:\n\tfor key in _baseline[\"game\"]:\n\t\tvar value: Variant = _baseline[\"game\"][key]\n\t\tif value is Array or value is Dictionary:\n\t\t\tvalue = value.duplicate(true)\n\t\tGameState.set(key, value)\n\tMetaProgression.data = _baseline[\"meta\"].duplicate(true)\n\tMetaProgression._new_this_run = _baseline[\"new_this_run\"].duplicate(true)\n\tif is_instance_valid(_game):\n\t\t_game.set(\"turn_action_log\", [])\n\t\t_game.set(\"_ending_new_titles\", [])\n\t\t_game.set(\"_ending_new_achievements\", [])\n\nfunc _reset() -> void:\n\t_restore_baseline()\n\tGameState.player_name = \"QA Custom Player\"\n\tGameState.action_log = [{\"turn\": 1, \"date\": \"fixed historical date\",\n\t\t\"message\": \"Untranslated original 中文 history\", \"type\": \"system\"}]\n\tGameState.relationships = [{\"id\": \"qa_friend\", \"name\": \"Custom 家族\", \"type\": \"friends\", \"affection\": 40, \"trust\": 30}]\n\tGameState.housing_months = {\"gosiwon\": 0}\n\tGameState.housing = \"gosiwon\"\n\tGameState.job_tenure = 0\n\tGameState.flags[\"housing_moved_once\"] = false\n\tGameState.flags[\"has_received_paycheck\"] = false\n\tGameState.flags[\"unemployed_months\"] = 0\n\tMetaProgression.data[\"unlocked_titles\"] = []\n\tMetaProgression.data[\"achievements\"] = []\n\tMetaProgression.data[\"seen_scenes\"] = [\"qa_original_history\"]\n\tMetaProgression.data[\"scene_replay_snapshots\"] = {}\n\tMetaProgression.data[\"qa_custom\"] = {\"original\": \"原本\", \"values\": [7, true]}\n\tif is_instance_valid(_game):\n\t\tvar container: VBoxContainer = _game.get(\"_toast_container\")\n\t\tfor child in container.get_children():\n\t\t\tchild.queue_free()\n\t\t_game.call(\"_refresh_all\")\n\nfunc _disk() -> String:\n\tvar path: String = MetaProgression.meta_save_path()\n\tvar absolute: String = ProjectSettings.globalize_path(path).simplify_path()\n\tif not absolute.begins_with(OS.get_user_data_dir().simplify_path() + \"/\"):\n\t\t_failures.append(\"meta path escapes isolated user directory\")\n\t\treturn \"<unsafe path>\"\n\treturn FileAccess.get_file_as_string(path) if FileAccess.file_exists(path) else \"<absent>\"\n\nfunc _isolation() -> bool:\n\tvar boot := get_tree().get_script() as Script\n\tvar qa_namespace := str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar regex := RegEx.new()\n\tif regex.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\") != OK:\n\t\treturn false\n\tvar valid: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand regex.search(qa_namespace) != null and OS.get_user_data_dir().get_file() == qa_namespace\n\tvar absolute: String = ProjectSettings.globalize_path(MetaProgression.meta_save_path()).simplify_path()\n\tvalid = valid and absolute.begins_with(OS.get_user_data_dir().simplify_path() + \"/\")\n\tif valid:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=%s\" % OS.get_user_data_dir())\n\treturn valid\n\nfunc _frames(count: int) -> void:\n\tfor _index in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _shutdown() -> void:\n\tif is_instance_valid(_game):\n\t\t_game.queue_free()\n\t\tawait _frames(4)\n\tfor value in get_tree().get_processed_tweens():\n\t\tif value is Tween and value.is_valid():\n\t\t\tvalue.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n"

[node name="MetaTitleLocaleCheck" type="Control"]
script = SubResource("GDScript_check")
