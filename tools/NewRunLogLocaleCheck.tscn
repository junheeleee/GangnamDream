[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_check"]
script/source = "extends Node\n# ORDER-267 independent semantic plan 1d364fa88985a2d13ca9c4c73df488fbac7d5253b101c1913bee911b4bfea960.\n# Literal oracle: revision1 de676885f16952a6b3cfb0dd6d2ca78782f85b14e93bdd3143e51e0243011c13.\n# Agent-observed headless component, not rendered/native/human evidence.\nconst FIXTURE_APPROVED := true\nconst MAIN := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES := [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst POOL := [\"investment\", \"jobs\", \"social\", \"health\", \"relationship\", \"gambling\", \"finance\"]\nconst UNKNOWN := [\"직장인\", \"QA_CUSTOM_PROFILE\", \"\"]\nconst ROWS := [\n\t[\"백수\", \"unemployed\", \"無職\", \"无业\", \"無業\"],\n\t[\"알바\", \"working part-time\", \"アルバイト\", \"打工\", \"打工\"],\n\t[\"투자\", \"Investing\", \"投資\", \"投资\", \"投資\"],\n\t[\"직장\", \"Jobs\", \"仕事\", \"工作\", \"工作\"],\n\t[\"인간관계\", \"Social\", \"人間関係\", \"人际关系\", \"人際關係\"],\n\t[\"건강\", \"Health\", \"健康\", \"健康\", \"健康\"],\n\t[\"연애\", \"Relationships\", \"恋愛\", \"恋爱\", \"戀愛\"],\n\t[\"도박\", \"Gambling\", \"ギャンブル\", \"赌博\", \"賭博\"],\n\t[\"재정\", \"Finance\", \"お金\", \"财务\", \"財務\"],\n\t[\"다시 시작한 아침. 출발점은 %s였다.\", \"Another beginning. He started out %s.\", \"再出発の朝。出発点は%sだった。\", \"重新开始的早晨。从%s起步。\", \"重新開始的早晨。從%s起步。\"],\n\t[\"이번에는 %s와 %s에 얽힌 소식이 유난히 먼저 눈에 들어왔다.\", \"This time, news tied to %s and %s caught his eye first.\", \"今回は、%sと%sにまつわる知らせが、いつもより先に目に入った。\", \"这一次，与%s和%s有关的消息格外醒目，先映入了眼帘。\", \"這次，與%s和%s有關的消息，格外容易先映入眼簾。\"],\n]\nconst DATE := [\"%d년 %d월 %d주차\", \"%04d-%02d W%d\", \"%d年 %d月 %d週目\", \"%04d-%02d W%d\", \"%04d-%02d W%d\"]\nconst COMMUNITY_PARENTS := [\"QA COMMUNITY PROFILE <%s>\", \"QA COMMUNITY THEME <%s> + <%s>\"]\nconst COMMUNITY_ARG := \"QA COMMUNITY ARG\"\nconst FORMAT_ERROR := \"[I18N FORMAT ERROR]\"\nconst RNG_CHECKPOINT := 267019\nconst DEFAULT_SEED := 267\nconst OLD_ENTRY := {\"turn\": 77, \"date\": \"OLD [date]\", \"message\": \"Stored [old] ✓ unchanged\", \"type\": \"system\"}\nconst EMPTY_DICT_FIELDS := [\"current_job\", \"milestones_reached\", \"portfolio\", \"flags\", \"random_event_counts\", \"random_event_last_turns\", \"market_prices\", \"price_history\", \"unlocked_stat_thresholds\", \"housing_months\", \"action_places_this_week\", \"pending_weekly_commitment\", \"forgone_path_debts\", \"contact_counts\", \"last_contact_turn\", \"run_seen_scenes_by_year\", \"year_scenes\"]\nconst EMPTY_ARRAY_FIELDS := [\"week_routine\", \"relationships\", \"inventory\", \"news_log\", \"event_log\", \"action_log\", \"deferred_events\", \"run_theme_categories\", \"action_records_this_week\", \"recent_action_places\", \"recent_action_weeks\", \"weekly_commitments\"]\nconst ZERO_INT_FIELDS := [\"grind_streak_weeks\", \"money_weeks_total\", \"human_weeks_total\", \"money_only_weeks_total\", \"human_only_weeks_total\", \"both_axes_weeks_total\", \"unmarked_weeks_total\", \"classified_weeks_total\", \"month_money_weeks\", \"month_human_weeks\", \"last_month_money_weeks\", \"last_month_human_weeks\", \"gambling_tendency\", \"addiction_tendency\", \"job_tenure\", \"events_seen\", \"route_orthodox\", \"route_unorthodox\", \"moral_band_last\"]\n\nvar _game: Control\nvar _failures: Array = []\nvar _io_errors: Array = []\nvar _ids: Array = []\nvar _expected_ids: Array = []\nvar _warnings: Array = []\nvar _coverage: Array = []\nvar _observed_entries: Array = []\nvar _normal_ok: bool = true\nvar _negative_count: int = 0\nvar _ko_control: Dictionary = {}\nvar _launch: Dictionary = {}\nvar _launch_vars: Dictionary = {}\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _frames(count: int) -> void:\n\tfor _i in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _clone(value: Variant) -> Variant:\n\treturn value.duplicate(true) if value is Dictionary or value is Array else value\n\nfunc _exact(a: Variant, b: Variant) -> bool:\n\tif typeof(a) != typeof(b):\n\t\treturn false\n\tif a is Dictionary:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor key in a:\n\t\t\tif not b.has(key) or not _exact(a[key], b[key]):\n\t\t\t\treturn false\n\t\treturn true\n\tif a is Array:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor i in range(a.size()):\n\t\t\tif not _exact(a[i], b[i]):\n\t\t\t\treturn false\n\t\treturn true\n\treturn a == b\n\nfunc _vars(object: Object) -> Dictionary:\n\tvar result: Dictionary = {}\n\tfor property in object.get_property_list():\n\t\tif (int(property[\"usage\"]) & PROPERTY_USAGE_SCRIPT_VARIABLE) == 0:\n\t\t\tcontinue\n\t\tvar value: Variant = object.get(str(property[\"name\"]))\n\t\tif typeof(value) in [TYPE_OBJECT, TYPE_SIGNAL, TYPE_CALLABLE]:\n\t\t\tcontinue\n\t\tresult[str(property[\"name\"])] = _clone(value)\n\treturn result\n\nfunc _set_vars(object: Object, values: Dictionary) -> void:\n\tfor key in values:\n\t\tobject.set(str(key), _clone(values[key]))\n\nfunc _files(path: String = \"user://\") -> Dictionary:\n\tvar result: Dictionary = {}\n\tvar directory: DirAccess = DirAccess.open(path)\n\tif directory == null:\n\t\t_io_errors.append(\"unreadable directory \" + path)\n\t\treturn result\n\tfor filename in directory.get_files():\n\t\tvar full: String = path.path_join(filename)\n\t\tvar handle: FileAccess = FileAccess.open(full, FileAccess.READ)\n\t\tif handle == null:\n\t\t\t_io_errors.append(\"unreadable file \" + full)\n\t\t\tcontinue\n\t\tvar length: int = handle.get_length()\n\t\tvar raw: PackedByteArray = handle.get_buffer(length)\n\t\thandle.close()\n\t\tif raw.size() != length:\n\t\t\t_io_errors.append(\"short read \" + full)\n\t\tresult[full] = raw.hex_encode()\n\tfor child in directory.get_directories():\n\t\tresult.merge(_files(path.path_join(child)))\n\treturn result\n\nfunc _restore_files(expected: Dictionary) -> void:\n\t# Only this already-validated fresh user:// namespace; evidence stays outside.\n\tfor path in _files():\n\t\tif not expected.has(path) and DirAccess.remove_absolute(str(path)) != OK:\n\t\t\t_io_errors.append(\"QA file removal failed \" + str(path))\n\tfor path in expected:\n\t\tvar handle: FileAccess = FileAccess.open(str(path), FileAccess.WRITE)\n\t\tif handle == null:\n\t\t\t_io_errors.append(\"QA file restore failed \" + str(path))\n\t\t\tcontinue\n\t\thandle.store_buffer(str(expected[path]).hex_decode())\n\t\thandle.close()\n\nfunc _isolation() -> bool:\n\tvar boot: Script = get_tree().get_script()\n\tvar name: String = str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar pattern := RegEx.new()\n\tpattern.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\")\n\tvar ok: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand pattern.search(name) != null and OS.get_user_data_dir().get_file() == name\n\tif ok:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=\" + OS.get_user_data_dir())\n\treturn ok\n\nfunc _cache_scope() -> Dictionary:\n\tvar selected: Dictionary = {}\n\tfor language in LOCALES.slice(2):\n\t\tvar pair: Dictionary = {}\n\t\tfor provider in [\"_builtin_ui_tables\", \"_community_ui_tables\"]:\n\t\t\tvar tables: Dictionary = LocaleManager.get(provider)\n\t\t\tvar table: Dictionary = tables.get(language, {})\n\t\t\tvar values: Dictionary = {}\n\t\t\tfor row in ROWS:\n\t\t\t\tif table.has(row[0]):\n\t\t\t\t\tvalues[row[0]] = table[row[0]]\n\t\t\tpair[provider] = {\"present\": tables.has(language), \"selected\": values,\n\t\t\t\t\"whole_sha256\": JSON.stringify(table).sha256_text()}\n\t\tselected[language] = pair\n\treturn {\"language\": LocaleManager.language, \"revision\": LocaleManager.content_revision,\n\t\t\"selected\": selected, \"misses\": LocaleManager._ui_misses.duplicate(true),\n\t\t\"format_errors\": LocaleManager._ui_format_errors.duplicate(true)}\n\nfunc _snapshot() -> Dictionary:\n\treturn {\"game\": GameState.serialize().duplicate(true), \"game_vars\": _vars(GameState),\n\t\t\"meta\": MetaProgression.data.duplicate(true), \"meta_new\": MetaProgression._new_this_run.duplicate(true),\n\t\t\"event\": {\"pending\": EventManager.pending_events.duplicate(true), \"current\": EventManager.current_event.duplicate(true),\n\t\t\t\"cooldowns\": EventManager.event_cooldowns.duplicate(true), \"recent\": EventManager.recent_event_ids.duplicate(true),\n\t\t\t\"bridges\": EventManager.narrative_bridge_results.duplicate(true)},\n\t\t\"locale\": _cache_scope(), \"registry_revision\": DataRegistry.content_revision,\n\t\t\"registry_sha256\": JSON.stringify(_vars(DataRegistry)).sha256_text(),\n\t\t\"settings\": SaveManager._settings.duplicate(true), \"settings_loaded\": SaveManager._settings_loaded,\n\t\t\"files\": _files()}\n\nfunc _entry(message: String, locale_index: int, turn: int = 1, year: int = 2026, month: int = 1, week: int = 1) -> Dictionary:\n\treturn {\"turn\": turn, \"date\": str(DATE[locale_index]) % [year, month, week], \"message\": message, \"type\": \"system\"}\n\nfunc _pair_reference(value: int) -> Dictionary:\n\t# Independent fixed pool + engine primitive, never inferred from product IDs.\n\tseed(value)\n\tvar pool: Array = POOL.duplicate()\n\tpool.shuffle()\n\tvar following: int = randi()\n\treturn {\"seed\": value, \"pair\": [pool[0], pool[1]], \"following\": following}\n\nfunc _discover_coverage() -> void:\n\tvar covered: Array = []\n\tfor value in range(128):\n\t\tvar reference: Dictionary = _pair_reference(value)\n\t\tvar novel: bool = false\n\t\tfor id in reference[\"pair\"]:\n\t\t\tif not covered.has(id):\n\t\t\t\tnovel = true\n\t\tif novel:\n\t\t\t_coverage.append(reference)\n\t\t\tfor id in reference[\"pair\"]:\n\t\t\t\tif not covered.has(id):\n\t\t\t\t\tcovered.append(id)\n\t\tif covered.size() == 7:\n\t\t\tbreak\n\tcovered.sort()\n\tvar expected: Array = POOL.duplicate()\n\texpected.sort()\n\tif covered != expected:\n\t\t_failures.append(\"setup/category coverage incomplete at seed128\")\n\nfunc _text(row_index: int, locale_index: int) -> String:\n\treturn str(ROWS[row_index][locale_index])\n\nfunc _theme_text(locale_index: int, pair: Array) -> String:\n\treturn _text(10, locale_index) % [_text(2 + POOL.find(pair[0]), locale_index), _text(2 + POOL.find(pair[1]), locale_index)]\n\nfunc _on_log(entry: Dictionary) -> void:\n\t_observed_entries.append(entry.duplicate(true))\n\nfunc _record(id: String, actual: Variant, expected: Variant, before: Dictionary, expected_state: Dictionary, normal: bool = true, extra: Dictionary = {}) -> void:\n\tvar after: Dictionary = _snapshot()\n\tvar display_ok: bool = _exact(actual, expected)\n\tvar state_ok: bool = _exact(after, expected_state)\n\tvar ok: bool = display_ok and state_ok and _io_errors.is_empty()\n\t_ids.append(id)\n\tif not ok:\n\t\t_failures.append(id)\n\tif normal:\n\t\t_normal_ok = _normal_ok and ok\n\telse:\n\t\t_negative_count += 1\n\tvar row: Dictionary = {\"id\": id, \"pass\": ok, \"display_ok\": display_ok, \"state_ok\": state_ok,\n\t\t\"typed_state_exact\": state_ok, \"normal_base\": _normal_ok, \"actual\": actual, \"expected\": expected,\n\t\t\"state\": {\"before\": before, \"expected\": expected_state, \"after\": after}, \"io_errors\": _io_errors.duplicate()}\n\trow.merge(extra)\n\tprint(\"NEW_RUN_LOG_CASE \" + JSON.stringify(row))\n\nfunc _set_game_expectation(state: Dictionary, game: Dictionary) -> void:\n\tstate[\"game\"] = game.duplicate(true)\n\tfor key in game:\n\t\tstate[\"game_vars\"][key] = _clone(game[key])\n\nfunc _default_game(before: Dictionary, locale_index: int, reference: Dictionary, profile_message: String, theme_message: String) -> Dictionary:\n\t# Source-frozen default reset assignments (GS 1050..1168), not a captured result.\n\t# Three discovery fields intentionally not reset by start_new_game retain before.\n\tvar game: Dictionary = before[\"game\"].duplicate(true)\n\tfor key in EMPTY_DICT_FIELDS:\n\t\tgame[key] = {}\n\tfor key in EMPTY_ARRAY_FIELDS:\n\t\tgame[key] = []\n\tfor key in ZERO_INT_FIELDS:\n\t\tgame[key] = 0\n\tgame.merge({\"player_name\": \"QA Custom Player\", \"player_background\": \"지방_상경\", \"player_route\": \"none\",\n\t\t\"difficulty\": \"현실\", \"age\": 33, \"year\": 2026, \"month\": 1, \"turn\": 1, \"week_of_month\": 1,\n\t\t\"is_game_over\": false, \"housing\": \"gosiwon\", \"money\": 500000.0, \"monthly_income\": 0.0,\n\t\t\"fixed_expense\": 650000.0, \"health\": 65, \"mental\": 60, \"intelligence\": 55, \"social_skill\": 45,\n\t\t\"appearance\": 50, \"investment_skill\": 15, \"luck\": 45, \"action_points\": 2, \"max_action_points\": 2,\n\t\t\"loop_tint_spent\": 0.0, \"tutorial_step\": 3, \"reputation\": 5, \"work_performance\": 50,\n\t\t\"loans\": {\"bank\": 0.0, \"second\": 0.0}, \"peak_asset\": 0.0, \"moral_tint\": 0.0,\n\t\t\"month_focus\": \"\", \"action_axis_this_week\": {\"money\": 0, \"human\": 0},\n\t\t\"core_loop_v2_state\": {\"run_generation\": \"seoul_cycle_eligible_v1\"},\n\t\t\"chapter5_causal_state\": {\"schema_version\": 1, \"ledger_id\": \"chapter5_m49_m55_causal_route_v1\", \"status\": \"open\", \"closed_reason\": \"\", \"entry\": {}, \"receipts\": {}, \"order\": []},\n\t\t\"chapter5_finale_state\": {\"schema_version\": 1, \"ledger_id\": \"chapter5_m56_m60_safe_finale_v1\", \"status\": \"open\", \"closed_reason\": \"\", \"entry\": {}, \"receipts\": {}, \"order\": [], \"ending_check\": \"pending\"},\n\t\t\"phone_state\": {\"schema\": 3, \"device_purchase_retired\": true, \"legacy_refund_applied\": true, \"legacy_refund_amount\": 0.0},\n\t\t\"tendency\": {\"career\": 0, \"invest\": 0, \"found\": 0}, \"tendency_realized\": \"\", \"tendency_evidence_version\": 2,\n\t\t\"market_context\": {\"fear_greed\": 50, \"cycle\": \"neutral\", \"bubble_assets\": [], \"crash_risk\": 0.04, \"momentum\": 0.0},\n\t\t\"run_theme\": \"자유런\", \"run_theme_categories\": reference[\"pair\"].duplicate(),\n\t\t\"action_log\": [_entry(theme_message, locale_index), _entry(profile_message, locale_index)]}, true)\n\tgame[\"cast\"] = {}\n\tfor id in [\"jiyeon\", \"daeun\", \"jaehyuk\", \"father\", \"sangchul\"]:\n\t\tgame[\"cast\"][id] = {\"stage\": \"distant\" if id == \"father\" else \"unknown\", \"affinity\": 40 if id == \"father\" else 0, \"met\": id == \"father\", \"flags\": {}}\n\t# Immutable loaded asset inputs; no call to the product price initializer.\n\tfor asset in DataRegistry.assets:\n\t\tgame[\"market_prices\"][asset.get(\"id\", \"\")] = float(asset.get(\"initial_price\", asset.get(\"base_price\", 10000.0)))\n\treturn game\n\nfunc _reset_expected(before: Dictionary, game: Dictionary) -> Dictionary:\n\tvar expected: Dictionary = before.duplicate(true)\n\t_set_game_expectation(expected, game)\n\texpected[\"event\"] = {\"pending\": [], \"current\": {}, \"cooldowns\": {}, \"recent\": [], \"bridges\": []}\n\treturn expected\n\nfunc _warm_setup(locale_index: int) -> void:\n\tLocaleManager.set_language(str(LOCALES[locale_index]))\n\t# Nonowned date/default-name probes are setup, not expected target suppliers.\n\tLocaleManager.ui(\"김민준\", \"Kim Minjun\")\n\tLocaleManager.ui(\"%d년 %d월 %d주차\", \"%04d-%02d W%d\")\n\t_observed_entries.clear()\n\nfunc _new_run(locale_index: int) -> void:\n\tvar reference: Dictionary = _pair_reference(DEFAULT_SEED)\n\tvar before: Dictionary = _snapshot()\n\tvar logs: Array = [_entry(_theme_text(locale_index, reference[\"pair\"]), locale_index), _entry(_text(9, locale_index) % _text(0, locale_index), locale_index)]\n\tvar game: Dictionary = _default_game(before, locale_index, reference, logs[1][\"message\"], logs[0][\"message\"])\n\tvar expected_state: Dictionary = _reset_expected(before, game)\n\tseed(DEFAULT_SEED)\n\tGameState.start_new_game(\"QA Custom Player\")\n\tvar following: int = randi()\n\tvar actual: Dictionary = {\"logs\": GameState.action_log.duplicate(true), \"signal_logs\": _observed_entries.duplicate(true),\n\t\t\"pair\": GameState.run_theme_categories.duplicate(), \"following\": following}\n\tvar expected: Dictionary = {\"logs\": logs, \"signal_logs\": logs, \"pair\": reference[\"pair\"], \"following\": reference[\"following\"]}\n\tvar sidecar: Dictionary = {\"boundary\": \"actual default 백수/자유런 reset; Main not constructed; source-derived full reset oracle\"}\n\tif locale_index == 0:\n\t\t_ko_control = GameState.serialize().duplicate(true)\n\telse:\n\t\tvar matched_ko: Dictionary = _ko_control.duplicate(true)\n\t\tmatched_ko[\"action_log\"] = logs.duplicate(true)\n\t\tsidecar[\"matched_ko_control\"] = {\"expected\": matched_ko, \"actual\": GameState.serialize().duplicate(true), \"exact\": _exact(matched_ko, GameState.serialize()), \"only_substituted_paths\": [\"action_log/0/date\", \"action_log/0/message\", \"action_log/1/date\", \"action_log/1/message\"]}\n\t\tif not sidecar[\"matched_ko_control\"][\"exact\"]:\n\t\t\t_failures.append(str(LOCALES[locale_index]) + \"/matched_ko\")\n\t_record(str(LOCALES[locale_index]) + \"/default_new_run\", actual, expected, before, expected_state, true, sidecar)\n\nfunc _profile(locale_index: int, index: int, unknown: bool = false) -> void:\n\tvar raw: String = str(UNKNOWN[index]) if unknown else _text(index, 0)\n\tvar before: Dictionary = _snapshot()\n\tvar localized: String = GameState._localized_profile_label(raw)\n\tvar english: String = GameState._localized_profile_label(raw, true)\n\tvar actual: Dictionary = {\"label\": localized, \"english_only\": english}\n\tvar expected: Dictionary = {\"label\": raw if unknown else _text(index, locale_index), \"english_only\": raw if unknown else _text(index, 1)}\n\tif not unknown:\n\t\tactual[\"composed\"] = LocaleManager.ui_format(_text(9, 0), _text(9, 1), [localized], [english])\n\t\texpected[\"composed\"] = _text(9, locale_index) % _text(index, locale_index)\n\t_record(str(LOCALES[locale_index]) + (\"/unknown_\" if unknown else \"/known_\") + str(index), actual, expected, before, before.duplicate(true))\n\nfunc _theme(locale_index: int, reference: Dictionary) -> void:\n\t_observed_entries.clear()\n\tvar before: Dictionary = _snapshot()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tvar logs: Array = before[\"game\"][\"action_log\"].duplicate(true)\n\tvar entry: Dictionary = _entry(_theme_text(locale_index, reference[\"pair\"]), locale_index, GameState.turn, GameState.year, GameState.month, GameState.week_of_month)\n\tlogs.append(entry)\n\tif logs.size() > 120:\n\t\tlogs.pop_front()\n\tvar game: Dictionary = before[\"game\"].duplicate(true)\n\tgame[\"action_log\"] = logs\n\tgame[\"run_theme_categories\"] = reference[\"pair\"].duplicate()\n\t_set_game_expectation(expected_state, game)\n\tseed(int(reference[\"seed\"]))\n\tGameState._roll_run_theme()\n\tvar following: int = randi()\n\t_record(str(LOCALES[locale_index]) + \"/category_seed_\" + str(reference[\"seed\"]),\n\t\t{\"pair\": GameState.run_theme_categories.duplicate(), \"following\": following, \"signal_logs\": _observed_entries.duplicate(true)},\n\t\t{\"pair\": reference[\"pair\"], \"following\": reference[\"following\"], \"signal_logs\": [entry]}, before, expected_state)\n\nfunc _provider_begin() -> Dictionary:\n\t# Keep original provider objects. Only copied dictionaries are modified.\n\tvar saved: Dictionary = {\"builtin\": LocaleManager._builtin_ui_tables,\n\t\t\"community\": LocaleManager._community_ui_tables, \"misses\": LocaleManager._ui_misses,\n\t\t\"errors\": LocaleManager._ui_format_errors, \"revision\": LocaleManager.content_revision}\n\tsaved[\"snapshot\"] = {\"builtin\": saved[\"builtin\"].duplicate(true), \"community\": saved[\"community\"].duplicate(true),\n\t\t\"misses\": saved[\"misses\"].duplicate(true), \"errors\": saved[\"errors\"].duplicate(true), \"revision\": saved[\"revision\"]}\n\tLocaleManager._builtin_ui_tables = saved[\"builtin\"].duplicate(true)\n\tLocaleManager._community_ui_tables = saved[\"community\"].duplicate(true)\n\tLocaleManager._ui_misses = saved[\"misses\"].duplicate(true)\n\tLocaleManager._ui_format_errors = saved[\"errors\"].duplicate(true)\n\treturn saved\n\nfunc _provider_end(id: String, saved: Dictionary) -> void:\n\tLocaleManager._builtin_ui_tables = saved[\"builtin\"]\n\tLocaleManager._community_ui_tables = saved[\"community\"]\n\tLocaleManager._ui_misses = saved[\"misses\"]\n\tLocaleManager._ui_format_errors = saved[\"errors\"]\n\tLocaleManager.content_revision = int(saved[\"revision\"])\n\tvar actual: Dictionary = {\"builtin\": LocaleManager._builtin_ui_tables, \"community\": LocaleManager._community_ui_tables,\n\t\t\"misses\": LocaleManager._ui_misses, \"errors\": LocaleManager._ui_format_errors, \"revision\": LocaleManager.content_revision}\n\tvar identity: bool = is_same(LocaleManager._builtin_ui_tables, saved[\"builtin\"]) \\\n\t\tand is_same(LocaleManager._community_ui_tables, saved[\"community\"]) \\\n\t\tand is_same(LocaleManager._ui_misses, saved[\"misses\"]) and is_same(LocaleManager._ui_format_errors, saved[\"errors\"])\n\tvar exact: bool = _exact(actual, saved[\"snapshot\"])\n\tif not identity or not exact:\n\t\t_failures.append(id + \"/provider_restore\")\n\tprint(\"NEW_RUN_LOG_PROVIDER_RESTORED \" + JSON.stringify({\"id\": id, \"exact\": exact, \"object_identity\": identity,\n\t\t\"before_sha256\": JSON.stringify(saved[\"snapshot\"]).sha256_text(), \"after_sha256\": JSON.stringify(actual).sha256_text(),\n\t\t\"boundary\": \"four full provider dictionaries recursively type-compared; hashes are not full-state snapshots\"}))\n\nfunc _miss_expected(state: Dictionary, language: String, keys: Array) -> void:\n\tif keys.is_empty():\n\t\treturn\n\tif not state[\"locale\"][\"misses\"].has(language):\n\t\tstate[\"locale\"][\"misses\"][language] = {}\n\tfor key in keys:\n\t\tstate[\"locale\"][\"misses\"][language][key] = true\n\nfunc _probe(locale_index: int, parent: int, mode: String) -> void:\n\tvar language: String = str(LOCALES[locale_index])\n\tvar id: String = language + \"/\" + (\"profile\" if parent == 0 else \"theme\") + \"/\" + mode\n\tvar reference: Dictionary = _pair_reference(DEFAULT_SEED) if parent == 0 else _coverage[0]\n\tvar pair: Array = reference[\"pair\"]\n\tvar parent_row: int = 9 + parent\n\tvar argument_row: int = 0 if parent == 0 else 2 + POOL.find(pair[0])\n\tvar affected_row: int = argument_row\n\tif mode == \"eager_unselected\":\n\t\tfor candidate in range(7):\n\t\t\tif not pair.has(POOL[candidate]):\n\t\t\t\taffected_row = 2 + candidate\n\t\t\t\tbreak\n\tvar saved: Dictionary = _provider_begin()\n\tvar builtin: Dictionary = LocaleManager._builtin_ui_tables[language]\n\tvar community: Dictionary = LocaleManager._community_ui_tables[language]\n\tvar missing: Array = []\n\tif mode in [\"parent_missing\", \"both_missing\"]:\n\t\tmissing.append(_text(parent_row, 0))\n\tif mode in [\"argument_missing\", \"both_missing\", \"eager_unselected\"]:\n\t\tmissing.append(_text(affected_row, 0))\n\tfor key in missing:\n\t\tbuiltin.erase(key)\n\t\tcommunity.erase(key)\n\t\tif LocaleManager._ui_misses.has(language):\n\t\t\tLocaleManager._ui_misses[language].erase(key)\n\tif mode in [\"community_both\", \"community_argument\"]:\n\t\tcommunity[_text(argument_row, 0)] = COMMUNITY_ARG\n\t\tif mode == \"community_both\":\n\t\t\tcommunity[_text(parent_row, 0)] = COMMUNITY_PARENTS[parent]\n\t\telse:\n\t\t\tcommunity.erase(_text(parent_row, 0))\n\tvar reason: String = \"\"\n\tvar diagnostic_key: String = \"\"\n\tif mode == \"invalid_parent\":\n\t\tvar template: String = _text(parent_row, locale_index)\n\t\tvar first_placeholder: int = template.find(\"%s\")\n\t\tcommunity[_text(parent_row, 0)] = template.substr(0, first_placeholder) + \"%d\" + template.substr(first_placeholder + 2)\n\t\treason = \"localized %s: placeholder signature mismatch %s != %s\" % [language,\n\t\t\t'[\"s\"]' if parent == 0 else '[\"s\", \"s\"]', '[\"d\"]' if parent == 0 else '[\"d\", \"s\"]']\n\t\tdiagnostic_key = \"%s\\u001f%s\\u001f%s\" % [language, _text(parent_row, 0), reason]\n\t\tLocaleManager._ui_format_errors.erase(diagnostic_key)\n\t\t_warnings.append(\"I18N_UI_FORMAT_REJECT lang=%s key=%s reason=%s\" % [language, _text(parent_row, 0), reason])\n\tvar target_args: Array = [_text(argument_row, locale_index)]\n\tvar english_args: Array = [_text(argument_row, 1)]\n\tif parent == 1:\n\t\ttarget_args.append(_text(2 + POOL.find(pair[1]), locale_index))\n\t\tenglish_args.append(_text(2 + POOL.find(pair[1]), 1))\n\tif mode in [\"argument_missing\", \"both_missing\"]:\n\t\ttarget_args[0] = english_args[0]\n\tif mode in [\"community_both\", \"community_argument\"]:\n\t\ttarget_args[0] = COMMUNITY_ARG\n\tvar message: String = _text(parent_row, locale_index) % target_args\n\tif mode in [\"parent_missing\", \"both_missing\"]:\n\t\tmessage = _text(parent_row, 1) % english_args\n\tif mode == \"community_both\":\n\t\tmessage = str(COMMUNITY_PARENTS[parent]) % target_args\n\tif mode == \"invalid_parent\":\n\t\tmessage = FORMAT_ERROR\n\t_observed_entries.clear()\n\tvar before: Dictionary = _snapshot()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tvar logs: Array = []\n\tif parent == 0:\n\t\tlogs = [_entry(_theme_text(locale_index, pair), locale_index), _entry(message, locale_index)]\n\t\texpected_state = _reset_expected(before, _default_game(before, locale_index, reference, message, logs[0][\"message\"]))\n\telse:\n\t\tvar entry: Dictionary = _entry(message, locale_index, GameState.turn, GameState.year, GameState.month, GameState.week_of_month)\n\t\tlogs = [entry]\n\t\tvar game: Dictionary = before[\"game\"].duplicate(true)\n\t\tgame[\"action_log\"].append(entry)\n\t\tif game[\"action_log\"].size() > 120:\n\t\t\tgame[\"action_log\"].pop_front()\n\t\tgame[\"run_theme_categories\"] = pair.duplicate()\n\t\t_set_game_expectation(expected_state, game)\n\t_miss_expected(expected_state, language, missing)\n\tif not diagnostic_key.is_empty():\n\t\texpected_state[\"locale\"][\"format_errors\"][diagnostic_key] = true\n\tseed(int(reference[\"seed\"]))\n\tif parent == 0:\n\t\tGameState.start_new_game(\"QA Custom Player\")\n\telse:\n\t\tGameState._roll_run_theme()\n\tvar following: int = randi()\n\tvar actual: Dictionary = {\"last_message\": GameState.action_log.back().get(\"message\"),\n\t\t\"signal_logs\": _observed_entries.duplicate(true), \"pair\": GameState.run_theme_categories.duplicate(), \"following\": following}\n\tvar expected: Dictionary = {\"last_message\": message, \"signal_logs\": logs, \"pair\": pair, \"following\": reference[\"following\"]}\n\tif mode == \"invalid_parent\":\n\t\t# Second exact rejection proves diagnostic de-duplication without another log.\n\t\tactual[\"repeat_return\"] = LocaleManager.ui_format(_text(parent_row, 0), _text(parent_row, 1), target_args, english_args)\n\t\texpected[\"repeat_return\"] = FORMAT_ERROR\n\t_record(id, actual, expected, before, expected_state, false,\n\t\t{\"missing_keys_expected\": missing, \"parent_source\": _text(parent_row, 0), \"argument_source\": _text(affected_row, 0),\n\t\t\"expected_warning\": _warnings.back() if mode == \"invalid_parent\" else \"\", \"diagnostic_key_expected\": diagnostic_key,\n\t\t\"provider_boundary\": \"copied cache providers; not an installed community language pack or file-loader test\"})\n\t# No early assertions: every prepared probe reaches provider restoration.\n\t_provider_end(id, saved)\n\nfunc _reader_text(logs: Array) -> String:\n\tvar lines: PackedStringArray = PackedStringArray()\n\tfor entry in logs.slice(maxi(0, logs.size() - 16)):\n\t\tvar date: String = str(entry[\"date\"]).replace(\"[\", \"(\").replace(\"]\", \")\")\n\t\tvar message: String = str(entry[\"message\"]).replace(\"✓\", \"•\").replace(\"[\", \"(\").replace(\"]\", \")\")\n\t\tlines.append(\"[%s] %s\" % [date, message])\n\treturn \"\\n\".join(lines)\n\nfunc _reader(locale_index: int) -> void:\n\t# Establish a different language, normalized actual Main, and a real sandbox\n\t# save BEFORE the measured non-reset switch. No old save is opened.\n\tLocaleManager.set_language(\"en\" if locale_index == 0 else \"ko\")\n\t_game.call(\"_refresh_all\")\n\tvar old_logs: Array = []\n\tfor i in range(17):\n\t\tvar entry: Dictionary = OLD_ENTRY.duplicate(true)\n\t\tentry[\"turn\"] = 60 + i\n\t\tentry[\"message\"] = str(entry[\"message\"]) + \" \" + str(i)\n\t\told_logs.append(entry)\n\tGameState.action_log = old_logs.duplicate(true)\n\tvar setup_save: bool = SaveManager.save_game(1)\n\tvar switch_before: Dictionary = _snapshot()\n\tvar expected_settings: Dictionary = switch_before[\"settings\"].duplicate(true)\n\texpected_settings[\"language\"] = str(LOCALES[locale_index])\n\tvar expected_files: Dictionary = switch_before[\"files\"].duplicate(true)\n\texpected_files[SaveManager.settings_path()] = JSON.stringify(expected_settings).to_utf8_buffer().hex_encode()\n\tLocaleManager.set_language(str(LOCALES[locale_index]))\n\tvar switch_after: Dictionary = _snapshot()\n\tvar language_ok: bool = setup_save and _exact(switch_after[\"game_vars\"], switch_before[\"game_vars\"]) \\\n\t\tand _exact(switch_after[\"meta\"], switch_before[\"meta\"]) and _exact(switch_after[\"files\"], expected_files) \\\n\t\tand _exact(switch_after[\"settings\"], expected_settings) \\\n\t\tand int(switch_after[\"registry_revision\"]) == int(switch_before[\"registry_revision\"]) + 1 \\\n\t\tand int(switch_after[\"locale\"][\"revision\"]) == int(switch_before[\"locale\"][\"revision\"])\n\t_observed_entries.clear()\n\tvar reference: Dictionary = _coverage[0]\n\tvar before: Dictionary = _snapshot()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tvar new_entry: Dictionary = _entry(_theme_text(locale_index, reference[\"pair\"]), locale_index, GameState.turn, GameState.year, GameState.month, GameState.week_of_month)\n\tvar logs: Array = old_logs.duplicate(true)\n\tlogs.append(new_entry)\n\tvar game: Dictionary = before[\"game\"].duplicate(true)\n\tgame[\"action_log\"] = logs\n\tgame[\"run_theme_categories\"] = reference[\"pair\"].duplicate()\n\t_set_game_expectation(expected_state, game)\n\tseed(int(reference[\"seed\"]))\n\tGameState._roll_run_theme()\n\tvar following: int = randi()\n\t_game.call(\"_render_log\")\n\tvar actual: Dictionary = {\"language_switch_ok\": language_ok, \"stored_old_logs\": GameState.action_log.slice(0, 17).duplicate(true),\n\t\t\"reader\": _game.get(\"log_box\").get_parsed_text(), \"reader_id\": _game.get(\"log_box\").get_instance_id(),\n\t\t\"following\": following, \"signal_logs\": _observed_entries.duplicate(true)}\n\tvar expected: Dictionary = {\"language_switch_ok\": true, \"stored_old_logs\": old_logs,\n\t\t\"reader\": _reader_text(logs), \"reader_id\": _game.get_meta(\"qa_original_log_box_id\"),\n\t\t\"following\": reference[\"following\"], \"signal_logs\": [new_entry]}\n\t_record(str(LOCALES[locale_index]) + \"/existing_record_reader\", actual, expected, before, expected_state, true,\n\t\t{\"language_transition\": {\"before\": switch_before, \"after\": switch_after, \"expected_settings\": expected_settings,\n\t\t\t\"expected_files\": expected_files, \"game_vars_unchanged\": _exact(switch_before[\"game_vars\"], switch_after[\"game_vars\"]),\n\t\t\t\"registry_boundary\": \"real locale reload, expected revision +1; localized registry content is separate from unchanged game/save\", \"pass\": language_ok},\n\t\t\"save_boundary\": \"actual save_game setup; raw slot/backup bytes preserved during switch and new log; no load_game or legacy migration coverage\"})\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n\nfunc _shutdown_main() -> void:\n\tif is_instance_valid(_game):\n\t\t_game.queue_free()\n\t\tawait _frames(4)\n\tfor tween in get_tree().get_processed_tweens():\n\t\tif tween is Tween and tween.is_valid():\n\t\t\ttween.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _restore() -> void:\n\tawait _shutdown_main()\n\tif GameState.log_added.is_connected(_on_log):\n\t\tGameState.log_added.disconnect(_on_log)\n\tfor name in _launch_vars:\n\t\t_set_vars(get_node(\"/root/\" + str(name)), _launch_vars[name])\n\tMetaProgression.data = _launch[\"meta\"].duplicate(true)\n\tMetaProgression._new_this_run = _launch[\"meta_new\"].duplicate(true)\n\t_restore_files(_launch[\"files\"])\n\tseed(RNG_CHECKPOINT)\n\tvar following: int = randi()\n\tseed(RNG_CHECKPOINT)\n\tvar after: Dictionary = _snapshot()\n\tvar exact: bool = _exact(after, _launch)\n\tvar variables_exact: bool = true\n\tfor name in _launch_vars:\n\t\tvariables_exact = variables_exact and _exact(_vars(get_node(\"/root/\" + str(name))), _launch_vars[name])\n\tif not exact or not variables_exact:\n\t\t_failures.append(\"final_restore\")\n\tprint(\"NEW_RUN_LOG_STATE_RESTORED \" + JSON.stringify({\"exact\": exact, \"script_variables_exact\": variables_exact,\n\t\t\"state\": {\"before\": _launch, \"expected\": _launch, \"after\": after}, \"io_errors\": _io_errors.duplicate(),\n\t\t\"rng\": {\"seed\": RNG_CHECKPOINT, \"following\": following, \"boundary\": \"explicit fixture checkpoint restored; opaque pre-fixture randomize state was not observable\"}}))\n\nfunc _prepare_ids() -> void:\n\tfor language in LOCALES:\n\t\t_expected_ids.append(str(language) + \"/default_new_run\")\n\t\tfor i in range(2):\n\t\t\t_expected_ids.append(str(language) + \"/known_\" + str(i))\n\t\tfor i in range(3):\n\t\t\t_expected_ids.append(str(language) + \"/unknown_\" + str(i))\n\t\tfor reference in _coverage:\n\t\t\t_expected_ids.append(str(language) + \"/category_seed_\" + str(reference[\"seed\"]))\n\tfor language in LOCALES.slice(2):\n\t\tfor parent in [\"profile\", \"theme\"]:\n\t\t\tfor mode in [\"parent_missing\", \"argument_missing\", \"both_missing\", \"community_both\", \"community_argument\", \"invalid_parent\"]:\n\t\t\t\t_expected_ids.append(str(language) + \"/\" + str(parent) + \"/\" + str(mode))\n\t\t_expected_ids.append(str(language) + \"/theme/eager_unselected\")\n\tfor language in LOCALES:\n\t\t_expected_ids.append(str(language) + \"/existing_record_reader\")\n\nfunc _run() -> void:\n\tif not FIXTURE_APPROVED or not _isolation():\n\t\tpush_error(\"NEW_RUN_LOG_CHECK_FAIL unapproved fixture or isolation\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tawait _frames(3)\n\t_launch = _snapshot()\n\tfor name in [\"GameState\", \"LocaleManager\", \"DataRegistry\", \"SaveManager\", \"EventManager\"]:\n\t\t_launch_vars[name] = _vars(get_node(\"/root/\" + str(name)))\n\tMetaProgression.data = {\"unlocked_titles\": [], \"total_runs\": 0}\n\tMetaProgression._new_this_run = {\"achievements\": []}\n\tGameState.player_name = \"QA Custom Player\"\n\tGameState.log_added.connect(_on_log)\n\t_discover_coverage()\n\t_prepare_ids()\n\tvar oracle_errors: Array = []\n\tfor index in range(2, 5):\n\t\t_warm_setup(index)\n\t\tfor row in ROWS:\n\t\t\tvar table: Dictionary = LocaleManager._builtin_ui_tables[str(LOCALES[index])]\n\t\t\tif not table.has(row[0]) or table[row[0]] != row[index]:\n\t\t\t\toracle_errors.append(str(LOCALES[index]) + \"/\" + str(row[0]))\n\t\t\tif LocaleManager._community_ui_tables[str(LOCALES[index])].has(row[0]):\n\t\t\t\toracle_errors.append(\"unexpected real community key \" + str(row[0]))\n\tif not oracle_errors.is_empty():\n\t\t_failures.append(\"setup/approved literal oracle\")\n\tseed(RNG_CHECKPOINT)\n\tvar checkpoint_next: int = randi()\n\tseed(RNG_CHECKPOINT)\n\tprint(\"NEW_RUN_LOG_SETUP \" + JSON.stringify({\"coverage\": _coverage, \"expected_ids\": _expected_ids,\n\t\t\"precondition_errors\": _failures.duplicate(), \"oracle_errors\": oracle_errors, \"rng_checkpoint\": {\"seed\": RNG_CHECKPOINT, \"following\": checkpoint_next},\n\t\t\"counts\": {\"default_new_runs\": 5, \"known_profile_compositions\": 10, \"unknown_profiles\": 15, \"category_probes\": 5 * _coverage.size(), \"provider_probes\": 39, \"readers\": 5},\n\t\t\"boundary\": \"independent seed scan is setup, not primary group count; no engine-output-derived text\"}))\n\tfor locale_index in range(5):\n\t\t_warm_setup(locale_index)\n\t\t_new_run(locale_index)\n\t\tfor index in range(2):\n\t\t\t_profile(locale_index, index)\n\t\tfor index in range(3):\n\t\t\t_profile(locale_index, index, true)\n\t\tfor reference in _coverage:\n\t\t\t_theme(locale_index, reference)\n\tvar normals_before_probes: bool = _normal_ok and _failures.is_empty()\n\tfor locale_index in range(2, 5):\n\t\t_warm_setup(locale_index)\n\t\tfor parent in range(2):\n\t\t\tfor mode in [\"parent_missing\", \"argument_missing\", \"both_missing\", \"community_both\", \"community_argument\", \"invalid_parent\"]:\n\t\t\t\t_probe(locale_index, parent, str(mode))\n\t\t_probe(locale_index, 1, \"eager_unselected\")\n\t# All reset producers finish before constructing Main. No temporary signal\n\t# disconnection conceals start/reset side effects; reader coverage is separate.\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_game = MAIN.instantiate()\n\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\tadd_child(_game)\n\tawait _frames(5)\n\t_game.set_meta(\"qa_original_log_box_id\", _game.get(\"log_box\").get_instance_id())\n\tfor locale_index in range(5):\n\t\t_reader(locale_index)\n\tawait _restore()\n\tif _ids != _expected_ids:\n\t\t_failures.append(\"case IDs/order\")\n\tprint(\"NEW_RUN_LOG_SUMMARY \" + JSON.stringify({\"groups\": _ids.size(), \"ids\": _ids, \"expected_ids\": _expected_ids,\n\t\t\"normal_base\": normals_before_probes, \"provider_probes\": _negative_count,\n\t\t\"effective_provider_probes\": _negative_count if normals_before_probes else 0,\n\t\t\"expected_warnings\": _warnings, \"failures\": _failures, \"io_errors\": _io_errors}))\n\tfor failure in _failures:\n\t\tpush_error(\"NEW_RUN_LOG_CHECK_FAIL \" + str(failure))\n\tif not _failures.is_empty() or not _io_errors.is_empty():\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"NEW_RUN_LOG_CHECK_OK groups=%d locales=5 provider_probes=39 expected_warnings=6 isolation=preautoload rendered=0\" % _ids.size())\n\tget_tree().quit(0)\n"

[node name="NewRunLogLocaleCheck" type="Node"]
script = SubResource("GDScript_check")
