[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_inventory"]
script/source = "extends Control\n# Frozen source literals precede the product repair. Headless component, not rendered/native QA.\nconst FIXTURE_APPROVED := true\nconst MAIN := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES := [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst FIXED := {\"oracles\":{\"locales\":[\"ko\",\"en\",\"ja\",\"zh-CN\",\"zh-TW\"],\"artifact_name_rows\":[{\"id\":\"artifact_sangchul_card\",\"ko\":\"임상철의 명함\",\"name_by_locale\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"artifact_daeun_note\",\"ko\":\"다은이 남긴 포스트잇\",\"name_by_locale\":{\"ko\":\"다은이 남긴 포스트잇\",\"en\":\"Daeun's Post-it Note\",\"ja\":\"ダウンが残した付箋\",\"zh-CN\":\"Daeun留下的便利贴\",\"zh-TW\":\"Daeun 留下的便利貼\"}},{\"id\":\"artifact_father_call\",\"ko\":\"통화시간 23초\",\"name_by_locale\":{\"ko\":\"통화시간 23초\",\"en\":\"23-Second Call\",\"ja\":\"通話時間23秒\",\"zh-CN\":\"通话时长23秒\",\"zh-TW\":\"通話時間23秒\"}},{\"id\":\"artifact_jiyeon_text\",\"ko\":\"그 아침의 문자\",\"name_by_locale\":{\"ko\":\"그 아침의 문자\",\"en\":\"That Morning's Text\",\"ja\":\"あの朝のメッセージ\",\"zh-CN\":\"那个早晨的短信\",\"zh-TW\":\"那天早上的訊息\"}},{\"id\":\"artifact_jaehyuk_photo\",\"ko\":\"포장마차 셀카\",\"name_by_locale\":{\"ko\":\"포장마차 셀카\",\"en\":\"Pojangmacha Selfie\",\"ja\":\"ポジャンマチャでの自撮り\",\"zh-CN\":\"韩国路边摊的自拍\",\"zh-TW\":\"韓國路邊攤的自拍\"}},{\"id\":\"artifact_hyunsu_card\",\"ko\":\"현수의 명함\",\"name_by_locale\":{\"ko\":\"현수의 명함\",\"en\":\"Hyunsu's Business Card\",\"ja\":\"ヒョンスの名刺\",\"zh-CN\":\"Hyunsu的名片\",\"zh-TW\":\"Hyunsu 的名片\"}}],\"gift_ui_preservation_rows\":[{\"id\":\"gift_can_coffee\",\"name_by_locale\":{\"ko\":\"캔커피 세트\",\"en\":\"Canned Coffee Set\",\"ja\":\"缶コーヒーセット\",\"zh-CN\":\"罐装咖啡套装\",\"zh-TW\":\"罐裝咖啡組\"},\"quantity\":1},{\"id\":\"gift_socks\",\"name_by_locale\":{\"ko\":\"양말 세트\",\"en\":\"Sock Set\",\"ja\":\"靴下セット\",\"zh-CN\":\"袜子套装\",\"zh-TW\":\"襪子組\"},\"quantity\":1},{\"id\":\"gift_essay_book\",\"name_by_locale\":{\"ko\":\"에세이집\",\"en\":\"Essay Collection\",\"ja\":\"エッセイ集\",\"zh-CN\":\"随笔集\",\"zh-TW\":\"散文集\"},\"quantity\":1},{\"id\":\"gift_exhibit_catalog\",\"name_by_locale\":{\"ko\":\"전시 도록\",\"en\":\"Exhibition Catalogue\",\"ja\":\"展示図録\",\"zh-CN\":\"展览图录\",\"zh-TW\":\"展覽圖錄\"},\"quantity\":1},{\"id\":\"gift_scarf\",\"name_by_locale\":{\"ko\":\"목도리\",\"en\":\"Wool Scarf\",\"ja\":\"マフラー\",\"zh-CN\":\"围巾\",\"zh-TW\":\"圍巾\"},\"quantity\":1},{\"id\":\"gift_perfume\",\"name_by_locale\":{\"ko\":\"향수\",\"en\":\"Perfume\",\"ja\":\"香水\",\"zh-CN\":\"香水\",\"zh-TW\":\"香水\"},\"quantity\":1},{\"id\":\"gift_wallet\",\"name_by_locale\":{\"ko\":\"브랜드 지갑\",\"en\":\"Designer Wallet\",\"ja\":\"ブランド財布\",\"zh-CN\":\"品牌钱包\",\"zh-TW\":\"名牌皮夾\"},\"quantity\":1},{\"id\":\"gift_necklace\",\"name_by_locale\":{\"ko\":\"목걸이\",\"en\":\"Necklace\",\"ja\":\"ネックレス\",\"zh-CN\":\"项链\",\"zh-TW\":\"項鍊\"},\"quantity\":1}],\"item_fallbacks\":{\"ko\":\"아이템\",\"en\":\"Item\",\"ja\":\"アイテム\",\"zh-CN\":\"物品\",\"zh-TW\":\"物品\"},\"quantity_templates\":{\"ko\":\"%s · %d개\",\"en\":\"%s · %d held\",\"ja\":\"%s · %d個所持\",\"zh-CN\":\"%s · %d个\",\"zh-TW\":\"%s · %d個\"},\"unknown_gift_names\":{\"ko\":\"선물\",\"en\":\"Gift\",\"ja\":\"贈り物\",\"zh-CN\":\"礼物\",\"zh-TW\":\"禮物\"},\"factored_input_recipe\":\"For each artifact, KO-acquired/saved canonical input must display its five exact names (6×5=30 source-derived comparisons). Its unique same-ID canonical aliases use the same five expected outputs, not an output-derived expected table. There are 29 distinct alias Strings across the six IDs (JA/TW father-call equality), so expanding all aliases would be 145 unique alias/target pairs, not 150. This expansion is an explicit possible assertion schedule, not a forced top-level case count.\",\"gift_recipe\":\"Eight current gift IDs remain on the original Main branch in each of five locales (8×5=40). These are actual UI spellings, not substituted catalog names. No gift delivery is invoked.\",\"quantity_recipe\":\"Observe missing quantity→1, actual add1→1 and second actual add1→2, then display with exact current templates. All six artifacts/eight gifts preserve ID/order/name/raw quantity; acquisition effects are setup, not display mutation.\"},\"edges\":[{\"id\":\"known_missing_name\",\"item\":{\"id\":\"artifact_sangchul_card\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_canonical_ko\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"임상철의 명함\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_canonical_en\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"Lim Sangchul's Business Card\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_canonical_ja\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"イム・サンチョルの名刺\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_canonical_cn\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"Im Sangchul的名片\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_canonical_tw\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"Im Sangchul 的名片\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"Lim Sangchul's Business Card\",\"ja\":\"イム・サンチョルの名刺\",\"zh-CN\":\"Im Sangchul的名片\",\"zh-TW\":\"Im Sangchul 的名片\"}},{\"id\":\"known_custom_string\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"My Keepsake\"},\"expected\":{\"ko\":\"My Keepsake\",\"en\":\"My Keepsake\",\"ja\":\"My Keepsake\",\"zh-CN\":\"My Keepsake\",\"zh-TW\":\"My Keepsake\"}},{\"id\":\"known_explicit_empty\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"\"},\"expected\":{\"ko\":\"\",\"en\":\"\",\"ja\":\"\",\"zh-CN\":\"\",\"zh-TW\":\"\"}},{\"id\":\"known_whitespace\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"  \"},\"expected\":{\"ko\":\"  \",\"en\":\"  \",\"ja\":\"  \",\"zh-CN\":\"  \",\"zh-TW\":\"  \"}},{\"id\":\"known_number_name\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":42},\"expected\":{\"ko\":\"42\",\"en\":\"42\",\"ja\":\"42\",\"zh-CN\":\"42\",\"zh-TW\":\"42\"}},{\"id\":\"known_null_name\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":null},\"expected_rule\":\"Exactly the caller's existing str(null) fallback, including its Godot spelling; compare to pre-code legacy-expression observation, not Python/JSON stringification.\"},{\"id\":\"known_cross_id_alias\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"다은이 남긴 포스트잇\"},\"expected\":{\"ko\":\"다은이 남긴 포스트잇\",\"en\":\"다은이 남긴 포스트잇\",\"ja\":\"다은이 남긴 포스트잇\",\"zh-CN\":\"다은이 남긴 포스트잇\",\"zh-TW\":\"다은이 남긴 포스트잇\"}},{\"id\":\"known_old_preset_name\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"Preset A\"},\"expected\":{\"ko\":\"Preset A\",\"en\":\"Preset A\",\"ja\":\"Preset A\",\"zh-CN\":\"Preset A\",\"zh-TW\":\"Preset A\"}},{\"id\":\"known_canonical_alias_with_extra_space\",\"item\":{\"id\":\"artifact_sangchul_card\",\"name\":\"임상철의 명함 \"},\"expected\":{\"ko\":\"임상철의 명함 \",\"en\":\"임상철의 명함 \",\"ja\":\"임상철의 명함 \",\"zh-CN\":\"임상철의 명함 \",\"zh-TW\":\"임상철의 명함 \"}},{\"id\":\"unknown_id_custom\",\"item\":{\"id\":\"qa_unknown_item\",\"name\":\"Unknown Keepsake\"},\"expected\":{\"ko\":\"Unknown Keepsake\",\"en\":\"Unknown Keepsake\",\"ja\":\"Unknown Keepsake\",\"zh-CN\":\"Unknown Keepsake\",\"zh-TW\":\"Unknown Keepsake\"}},{\"id\":\"unknown_id_looks_canonical\",\"item\":{\"id\":\"qa_unknown_item\",\"name\":\"임상철의 명함\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"임상철의 명함\",\"ja\":\"임상철의 명함\",\"zh-CN\":\"임상철의 명함\",\"zh-TW\":\"임상철의 명함\"}},{\"id\":\"unknown_id_missing_name\",\"item\":{\"id\":\"qa_unknown_item\"},\"expected\":{\"ko\":\"아이템\",\"en\":\"Item\",\"ja\":\"アイテム\",\"zh-CN\":\"物品\",\"zh-TW\":\"物品\"}},{\"id\":\"missing_id\",\"item\":{\"name\":\"임상철의 명함\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"임상철의 명함\",\"ja\":\"임상철의 명함\",\"zh-CN\":\"임상철의 명함\",\"zh-TW\":\"임상철의 명함\"}},{\"id\":\"nonstring_id\",\"item\":{\"id\":42,\"name\":\"임상철의 명함\"},\"expected\":{\"ko\":\"임상철의 명함\",\"en\":\"임상철의 명함\",\"ja\":\"임상철의 명함\",\"zh-CN\":\"임상철의 명함\",\"zh-TW\":\"임상철의 명함\"}}]}\nvar _game: Control\nvar _panel: Node\nvar _failures: Array = []\nvar _ids: Array = []\nvar _signals: Array = []\nvar _signal_expected_names: Array = []\nvar _base_items: Array = []\nvar _locale_catalogs: Dictionary = {}\nvar _baseline: Dictionary = {}\nvar _preset_names: Dictionary = {}\nvar _baseline_mod_roots: Array = []\n\nclass ControlledRegistry:\n\textends \"res://autoloads/DataRegistry.gd\"\n\tvar target: Dictionary = {}\n\tfunc _load_locale_catalog(code: String) -> Dictionary:\n\t\treturn target.duplicate(true) if code == \"ja\" else super._load_locale_catalog(code)\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _frames(count: int) -> void:\n\tfor _i in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _exact(a: Variant, b: Variant) -> bool:\n\tif typeof(a) != typeof(b):\n\t\treturn false\n\tif a is Dictionary:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor key in a:\n\t\t\tif not b.has(key) or not _exact(a[key], b[key]):\n\t\t\t\treturn false\n\t\treturn true\n\tif a is Array:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor i in range(a.size()):\n\t\t\tif not _exact(a[i], b[i]):\n\t\t\t\treturn false\n\t\treturn true\n\treturn a == b\n\nfunc _isolation() -> bool:\n\tvar boot: Script = get_tree().get_script()\n\tvar name: String = str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar pattern := RegEx.new()\n\tpattern.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\")\n\tvar ok: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand pattern.search(name) != null and OS.get_user_data_dir().get_file() == name\n\tif ok:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=\" + OS.get_user_data_dir())\n\treturn ok\n\nfunc _files(path: String = \"user://\", result: Dictionary = {}) -> Dictionary:\n\tvar found: Dictionary = result.duplicate(true)\n\tvar directory: DirAccess = DirAccess.open(path)\n\tif directory == null:\n\t\treturn found\n\tfor file in directory.get_files():\n\t\tvar item_path: String = path.path_join(file)\n\t\tif item_path == SaveManager.settings_path():\n\t\t\tcontinue\n\t\tfound[item_path] = FileAccess.get_file_as_bytes(item_path).hex_encode()\n\tfor child in directory.get_directories():\n\t\tfound = _files(path.path_join(child), found)\n\treturn found\n\nfunc _snapshot() -> Dictionary:\n\tvar settings_path: String = SaveManager.settings_path()\n\treturn {\"game\": GameState.serialize().duplicate(true), \"meta\": MetaProgression.data.duplicate(true),\n\t\t\"new_this_run\": MetaProgression._new_this_run.duplicate(true),\n\t\t\"turn_log\": _game.get(\"turn_action_log\").duplicate(true) if is_instance_valid(_game) else [],\n\t\t\"files\": _files(), \"language\": LocaleManager.language,\n\t\t\"settings\": (SaveManager.get(\"_settings\") as Dictionary).duplicate(true),\n\t\t\"settings_raw\": FileAccess.get_file_as_string(settings_path) if FileAccess.file_exists(settings_path) else null,\n\t\t\"registry\": DataRegistry.items.duplicate(true), \"registry_index\": DataRegistry.items_by_id.duplicate(true),\n\t\t\"revision\": DataRegistry.content_revision, \"locale_revision\": LocaleManager.content_revision,\n\t\t\"player\": GameState.player_name}\n\nfunc _record(id: String, actual: Variant, expected: Variant, before: Dictionary,\n\t\texpected_state: Dictionary, json_game_only: bool = false) -> void:\n\tvar after: Dictionary = _snapshot()\n\tvar tested_after: Dictionary = after.duplicate(true)\n\tvar tested_expected: Dictionary = expected_state.duplicate(true)\n\tif json_game_only:\n\t\t# Load crosses JSON number types; whole values must match, while the new loaded\n\t\t# inventory is independently type-exact to the pre-read parsed payload.\n\t\ttested_after[\"game\"] = JSON.stringify(after[\"game\"])\n\t\ttested_expected[\"game\"] = JSON.stringify(expected_state[\"game\"])\n\tvar state_ok: bool = _exact(tested_after, tested_expected)\n\tvar ok: bool = _exact(actual, expected) and state_ok\n\t_ids.append(id)\n\tif not ok:\n\t\t_failures.append(id)\n\tprint(\"INVENTORY_NAME_CASE \" + JSON.stringify({\"id\": id, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": ok, \"state_ok\": state_ok, \"state\": {\"before\": before, \"expected\": expected_state, \"after\": after},\n\t\t\"load_json_value_boundary\": json_game_only}))\n\nfunc _get(item: Dictionary) -> String:\n\treturn str(DataRegistry.call(\"get_inventory_display_name\", item,\n\t\tstr(item.get(\"name\", FIXED[\"oracles\"][\"item_fallbacks\"][LocaleManager.language]))))\n\nfunc _labels() -> Array:\n\tvar result: Array = []\n\tvar live_children: Array = _panel.get_children().filter(func(child: Node): return not child.is_queued_for_deletion())\n\tfor card in live_children.slice(1):\n\t\tif not card is PanelContainer:\n\t\t\tresult.append(\"<wrong card>\")\n\t\t\tcontinue\n\t\tvar row: Node = card.get_child(0).get_child(0)\n\t\tvar content: Node = row.get_children().back()\n\t\tresult.append(str(content.get_child(0).get(\"text\")))\n\treturn result\n\nfunc _expected_labels(names: Array) -> Array:\n\tvar result: Array = []\n\tfor i in range(names.size()):\n\t\tresult.append(str(FIXED[\"oracles\"][\"quantity_templates\"][LocaleManager.language]) \\\n\t\t\t% [names[i], GameState.inventory[i].get(\"quantity\", 1)])\n\treturn result\n\nfunc _expected_items(locale: String) -> Array:\n\tvar result: Array = _base_items.duplicate(true)\n\tfor row in result:\n\t\tvar id: String = str(row[\"id\"])\n\t\tif locale != \"ko\":\n\t\t\tvar english: Dictionary = DataRegistry.ITEM_TEXT_EN.get(id, {})\n\t\t\tfor key in [\"name\", \"description\"]:\n\t\t\t\tif english.has(key):\n\t\t\t\t\trow[key] = english[key]\n\t\t\tvar target: Dictionary = _locale_catalogs.get(locale, {}).get(\"items\", {}).get(id, {})\n\t\t\tfor key in [\"name\", \"description\"]:\n\t\t\t\tif target.has(key):\n\t\t\t\t\trow[key] = target[key]\n\t\tif _preset_names.has(id):\n\t\t\trow[\"name\"] = _preset_names[id]\n\treturn result\n\nfunc _index(rows: Array) -> Dictionary:\n\tvar result: Dictionary = {}\n\tfor row in rows:\n\t\tresult[row[\"id\"]] = row.duplicate(true)\n\treturn result\n\nfunc _inventory(names: Array) -> void:\n\tGameState.inventory = names.duplicate(true)\n\t_game.call(\"_render_sidebars\")\n\nfunc _on_language(_locale: String) -> void:\n\t_signals.append({\"panel\": _panel.get_instance_id(), \"labels\": _labels()})\n\nfunc _switch(locale: String, id: String, names: Array) -> void:\n\tvar before: Dictionary = _snapshot()\n\tvar expected: Dictionary = before.duplicate(true)\n\tvar changed: bool = before[\"language\"] != locale\n\texpected[\"language\"] = locale\n\texpected[\"settings\"][\"language\"] = locale\n\texpected[\"settings_raw\"] = JSON.stringify(expected[\"settings\"])\n\tif changed:\n\t\texpected[\"registry\"] = _expected_items(locale)\n\t\texpected[\"registry_index\"] = _index(expected[\"registry\"])\n\t\texpected[\"revision\"] += 1\n\t_signals.clear()\n\tLocaleManager.set_language(locale)\n\t# No refresh, reload, frame, or prewarm between the actual API and observation.\n\tvar expected_labels: Array = _expected_labels(names)\n\tvar expected_signals: Array = [{\"panel\": _panel.get_instance_id(), \"labels\": expected_labels}] if changed else []\n\t_record(id, {\"panel\": _game.get(\"inventory_box\").get_instance_id(), \"labels\": _labels(), \"signals\": _signals},\n\t\t{\"panel\": _panel.get_instance_id(), \"labels\": expected_labels, \"signals\": expected_signals}, before, expected)\n\nfunc _locale_groups(locale: String) -> void:\n\tLocaleManager.set_language(locale)\n\tvar before: Dictionary = _snapshot()\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\tvar aliases: Array = []\n\t\tfor language in LOCALES:\n\t\t\tvar name: String = str(row[\"name_by_locale\"][language])\n\t\t\tif name not in aliases:\n\t\t\t\taliases.append(name)\n\t\tfor alias in aliases:\n\t\t\tactual.append(_get({\"id\": row[\"id\"], \"name\": alias}))\n\t\t\texpected.append(row[\"name_by_locale\"][locale])\n\t_record(locale + \"/aliases\", actual, expected, before, before)\n\n\tvar inputs: Array = []\n\tvar names: Array = []\n\tfor edge in FIXED[\"edges\"]:\n\t\tinputs.append(edge[\"item\"].duplicate(true))\n\t\tnames.append(edge[\"expected\"][locale] if edge.has(\"expected\") else str(null))\n\tGameState.inventory = inputs.duplicate(true)\n\tbefore = _snapshot()\n\t_game.call(\"_render_sidebars\")\n\tactual = []\n\tfor item in inputs:\n\t\tactual.append(_get(item))\n\t_record(locale + \"/stored_edges\", {\"direct\": actual, \"labels\": _labels()},\n\t\t{\"direct\": names, \"labels\": _expected_labels(names)}, before, before)\n\n\tinputs = []\n\tnames = []\n\tfor row in FIXED[\"oracles\"][\"gift_ui_preservation_rows\"]:\n\t\tinputs.append({\"id\": row[\"id\"], \"name\": \"Stored gift custom\", \"category\": \"gift\", \"quantity\": 2})\n\t\tnames.append(row[\"name_by_locale\"][locale])\n\tinputs.append({\"id\": \"qa_unknown_gift\", \"name\": \"Custom unknown gift\", \"category\": \"gift\"})\n\tnames.append(FIXED[\"oracles\"][\"unknown_gift_names\"][locale])\n\tGameState.inventory = inputs\n\tbefore = _snapshot()\n\t_game.call(\"_render_sidebars\")\n\t_record(locale + \"/gifts\", _labels(), _expected_labels(names), before, before)\n\n\tGameState.inventory = []\n\tbefore = _snapshot()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tvar acquired: Array = _expected_items(locale).slice(0, 6)\n\tnames = []\n\tfor row in acquired:\n\t\trow[\"quantity\"] = 2\n\t\tnames.append(row[\"name\"])\n\texpected_state[\"game\"][\"inventory\"] = acquired\n\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\tGameState.add_item(row[\"id\"], 1)\n\t\tGameState.add_item(row[\"id\"], 1)\n\t_game.call(\"_render_sidebars\")\n\t_record(locale + \"/acquisition\", {\"inventory\": GameState.inventory, \"labels\": _labels()},\n\t\t{\"inventory\": acquired, \"labels\": _expected_labels(names)}, before, expected_state)\n\nfunc _live_cases() -> void:\n\tLocaleManager.set_language(\"ja\")\n\tvar row: Dictionary = DataRegistry.get_item(\"artifact_sangchul_card\").duplicate(true)\n\t_inventory([{\"id\": \"artifact_sangchul_card\", \"name\": \"임상철의 명함\", \"quantity\": 2}])\n\tvar variants: Array = [\n\t\t{\"id\": \"string\", \"name\": \"Live Name\", \"expected\": \"Live Name\"},\n\t\t{\"id\": \"blank\", \"name\": \"\", \"expected\": \"\"},\n\t\t{\"id\": \"number\", \"name\": 42, \"expected\": \"42\"},\n\t\t{\"id\": \"alias\", \"name\": \"Lim Sangchul's Business Card\", \"expected\": \"Lim Sangchul's Business Card\"},\n\t\t{\"id\": \"missing\", \"expected\": \"임상철의 명함\"},\n\t\t{\"id\": \"removed\", \"expected\": \"임상철의 명함\"},\n\t\t{\"id\": \"restored\", \"name\": \"イム・サンチョルの名刺\", \"expected\": \"イム・サンチョルの名刺\"}]\n\tfor variant in variants:\n\t\tDataRegistry.items_by_id[\"artifact_sangchul_card\"] = row.duplicate(true)\n\t\tif variant[\"id\"] == \"removed\":\n\t\t\tDataRegistry.items_by_id.erase(\"artifact_sangchul_card\")\n\t\telif variant.has(\"name\"):\n\t\t\tDataRegistry.items_by_id[\"artifact_sangchul_card\"][\"name\"] = variant[\"name\"]\n\t\telse:\n\t\t\tDataRegistry.items_by_id[\"artifact_sangchul_card\"].erase(\"name\")\n\t\tDataRegistry.notify_content_override()\n\t\tvar before: Dictionary = _snapshot()\n\t\t_game.call(\"_render_sidebars\")\n\t\t_record(\"live/\" + str(variant[\"id\"]), {\"direct\": _get(GameState.inventory[0]), \"labels\": _labels()},\n\t\t\t{\"direct\": variant[\"expected\"], \"labels\": _expected_labels([variant[\"expected\"]])}, before, before)\n\tDataRegistry.items_by_id[\"artifact_sangchul_card\"] = row.duplicate(true)\n\tDataRegistry.items_by_id[\"artifact_sangchul_card\"][\"name\"] = \"Live Name\"\n\tDataRegistry.notify_content_override()\n\t_game.call(\"_render_sidebars\")\n\t_switch(\"ja\", \"live/same_language\", [\"Live Name\"])\n\t_switch(\"zh-CN\", \"live/changed_language\", [\"Im Sangchul的名片\"])\n\tGameState.inventory[0][\"name\"] = \"My Keepsake\"\n\t_game.call(\"_render_sidebars\")\n\t_switch(\"ja\", \"live/custom_changed_language\", [\"My Keepsake\"])\n\nfunc _write_json(path: String, value: Variant) -> void:\n\tvar absolute: String = ProjectSettings.globalize_path(path).simplify_path()\n\tif not absolute.begins_with(OS.get_user_data_dir().simplify_path() + \"/\"):\n\t\t_failures.append(\"unsafe fixture path\")\n\t\treturn\n\tDirAccess.make_dir_recursive_absolute(path.get_base_dir())\n\tvar handle: FileAccess = FileAccess.open(path, FileAccess.WRITE)\n\thandle.store_string(JSON.stringify(value))\n\thandle.close()\n\nfunc _preset_settings(order: Array, enabled: Dictionary = {}) -> void:\n\tSaveManager.set_setting(\"mod_load_order\", order)\n\tSaveManager.set_setting(\"mod_enabled\", enabled)\n\tModLoader.notify_settings_changed()\n\nfunc _preset_cases() -> void:\n\tModLoader.configure_test_roots(\"user://lang\", \"user://inventory_fixture_mods/assets\", \"user://inventory_fixture_mods\", SaveManager.settings_path())\n\t_write_json(\"user://inventory_fixture_mods/presets/inventory_a.json\", {\"id\": \"inventory_a\",\n\t\t\"items\": [{\"id\": \"artifact_sangchul_card\", \"name\": \"Preset A\"}]})\n\t_write_json(\"user://inventory_fixture_mods/presets/inventory_b.json\", {\"id\": \"inventory_b\",\n\t\t\"items\": [{\"id\": \"artifact_sangchul_card\", \"name\": \"Preset B\"}]})\n\t_preset_settings([\"preset:inventory_a\", \"preset:inventory_b\"])\n\t_preset_names = {\"artifact_sangchul_card\": \"Preset B\"}\n\tLocaleManager.set_language(\"ko\")\n\tDataRegistry.reload()\n\t_inventory([{\"id\": \"artifact_sangchul_card\", \"name\": \"임상철의 명함\"}])\n\t_preset_settings([\"preset:inventory_b\", \"preset:inventory_a\"])\n\t_switch(\"ko\", \"preset/settings_only\", [\"Preset B\"])\n\tvar before: Dictionary = _snapshot()\n\tvar notified: Dictionary = before.duplicate(true)\n\tnotified[\"revision\"] += 1\n\tDataRegistry.notify_content_override()\n\t_game.call(\"_render_sidebars\")\n\t_record(\"preset/notify_not_reload\", _labels(), _expected_labels([\"Preset B\"]), before, notified)\n\t_preset_names = {\"artifact_sangchul_card\": \"Preset A\"}\n\t_switch(\"ja\", \"preset/changed_language\", [\"Preset A\"])\n\tGameState.inventory[0][\"name\"] = \"Preset B\"\n\t_game.call(\"_render_sidebars\")\n\t_switch(\"zh-CN\", \"preset/stored_old_preset\", [\"Preset B\"])\n\tGameState.inventory[0][\"name\"] = \"임상철의 명함\"\n\tDataRegistry.items_by_id[\"artifact_sangchul_card\"][\"name\"] = \"Live Name\"\n\tDataRegistry.notify_content_override()\n\t_game.call(\"_render_sidebars\")\n\t_switch(\"zh-TW\", \"preset/live_and_pending\", [\"Preset A\"])\n\t_preset_settings([], {\"preset:inventory_a\": false, \"preset:inventory_b\": false})\n\t_preset_names = {}\n\t_switch(\"ko\", \"preset/disabled_on_language\", [\"임상철의 명함\"])\n\t_preset_settings([\"preset:inventory_b\", \"preset:inventory_a\"])\n\t_preset_names = {\"artifact_sangchul_card\": \"Preset A\"}\n\tbefore = _snapshot()\n\tvar reloaded: Dictionary = before.duplicate(true)\n\treloaded[\"registry\"] = _expected_items(\"ko\")\n\treloaded[\"registry_index\"] = _index(reloaded[\"registry\"])\n\treloaded[\"revision\"] += 1\n\tDataRegistry.reload()\n\t_record(\"preset/explicit_reload_getter\", _get(GameState.inventory[0]), \"Preset A\", before, reloaded)\n\t_preset_settings([], {\"preset:inventory_a\": false, \"preset:inventory_b\": false})\n\t_preset_names = {}\n\tDataRegistry.reload()\n\nfunc _unknown_preset_case() -> void:\n\t_write_json(\"user://inventory_fixture_mods/presets/inventory_unknown.json\",\n\t\t{\"id\": \"inventory_unknown\", \"items\": [{\"id\": \"qa_unknown_item\", \"name\": \"Unknown preset\"}]})\n\t_preset_settings([\"preset:inventory_unknown\"],\n\t\t{\"preset:inventory_a\": false, \"preset:inventory_b\": false, \"preset:inventory_unknown\": true})\n\tvar rows: Array = _expected_items(\"ko\")\n\tvar expected: Array = rows.duplicate(true)\n\tvar before: Dictionary = _snapshot()\n\tDataRegistry._apply_catalog_presets(rows, \"items\")\n\t_record(\"loader/preset_unknown_id\", rows, expected, before, before)\n\t_preset_settings([], {\"preset:inventory_a\": false, \"preset:inventory_b\": false, \"preset:inventory_unknown\": false})\n\nfunc _loader_cases() -> void:\n\tLocaleManager.set_language(\"ja\")\n\tvar cases: Array = [\n\t\t{\"id\": \"missing_section\", \"target\": {}, \"expected\": \"Lim Sangchul's Business Card\"},\n\t\t{\"id\": \"missing_id\", \"target\": {\"items\": {}}, \"expected\": \"Lim Sangchul's Business Card\"},\n\t\t{\"id\": \"missing_name\", \"target\": {\"items\": {\"artifact_sangchul_card\": {}}}, \"expected\": \"Lim Sangchul's Business Card\"},\n\t\t{\"id\": \"blank\", \"target\": {\"items\": {\"artifact_sangchul_card\": {\"name\": \"\"}}}, \"expected\": \"\"},\n\t\t{\"id\": \"number\", \"target\": {\"items\": {\"artifact_sangchul_card\": {\"name\": 42}}}, \"expected\": \"42\"}]\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar before: Dictionary = _snapshot()\n\tfor entry in cases:\n\t\tvar registry := ControlledRegistry.new()\n\t\tregistry.target = entry[\"target\"]\n\t\tregistry.reload()\n\t\tactual.append(registry.call(\"get_inventory_display_name\",\n\t\t\t{\"id\": \"artifact_sangchul_card\", \"name\": \"임상철의 명함\"}, \"임상철의 명함\"))\n\t\texpected.append(entry[\"expected\"])\n\t\tregistry.free()\n\tvar cold := ControlledRegistry.new()\n\tactual.append(cold.call(\"get_inventory_display_name\", {\"id\": \"artifact_sangchul_card\"}, \"Legacy fallback\"))\n\texpected.append(\"Legacy fallback\")\n\tcold.free()\n\t_record(\"loader/fallback_and_types\", actual, expected, before, before)\n\tbefore = _snapshot()\n\tvar base: Dictionary = {\"id\": \"artifact_sangchul_card\", \"name\": \"Preset A\"}\n\tvar numeric: Dictionary = DataRegistry._merge_existing_catalog_row(base, {\"name\": 42}, \"inventory-fixture\")\n\tvar blank: Dictionary = DataRegistry._merge_existing_catalog_row(base, {\"name\": \"\"}, \"inventory-fixture\")\n\t_record(\"loader/preset_types\", [numeric, blank],\n\t\t[base, {\"id\": \"artifact_sangchul_card\", \"name\": \"\"}], before, before)\n\nfunc _save_load() -> void:\n\tLocaleManager.set_language(\"ko\")\n\tGameState.inventory = []\n\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\tGameState.add_item(row[\"id\"], 1)\n\t_game.call(\"_render_sidebars\")\n\tvar before: Dictionary = _snapshot()\n\tvar saved_state: Dictionary = before[\"game\"].duplicate(true)\n\tvar began: String = Time.get_datetime_string_from_system()\n\tvar saved: bool = SaveManager.save_game(1)\n\tvar ended: String = Time.get_datetime_string_from_system()\n\tvar path: String = SaveManager.slot_path(1)\n\tvar payload: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))\n\tvar expected: Dictionary = before.duplicate(true)\n\t# New save bytes include the real timestamp; semantic state and namespace are\n\t# checked independently before these newly-created bytes become a display baseline.\n\tvar files_after: Dictionary = _files()\n\tvar save_path_only: bool = not before[\"files\"].has(path) and files_after.has(path)\n\texpected[\"files\"][path] = FileAccess.get_file_as_bytes(path).hex_encode()\n\tsave_path_only = save_path_only and _exact(files_after, expected[\"files\"])\n\tvar timestamp: String = str(payload.get(\"saved_at\", \"\"))\n\tvar timestamp_ok: bool = timestamp >= began and timestamp <= ended\n\t_record(\"storage/save\", {\"success\": saved, \"state_json\": JSON.stringify(payload.get(\"state\", {})),\n\t\t\"slot\": int(payload.get(\"slot\", -1)), \"only_new_slot\": save_path_only, \"timestamp_in_call\": timestamp_ok},\n\t\t{\"success\": true, \"state_json\": JSON.stringify(saved_state), \"slot\": 1,\n\t\t\"only_new_slot\": true, \"timestamp_in_call\": true}, before, expected)\n\tvar names: Array = []\n\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\tnames.append(row[\"name_by_locale\"][\"ja\"])\n\t_switch(\"ja\", \"storage/language_preserves_saved_bytes\", names)\n\tGameState.inventory = []\n\tbefore = _snapshot()\n\texpected = before.duplicate(true)\n\texpected[\"game\"] = saved_state.duplicate(true)\n\texpected[\"game\"][\"inventory\"] = (payload[\"state\"][\"inventory\"] as Array).duplicate(true)\n\tvar loaded: bool = SaveManager.load_game(1)\n\t_game.call(\"_render_sidebars\")\n\t_record(\"storage/load\", {\"success\": loaded, \"inventory\": GameState.inventory, \"labels\": _labels()},\n\t\t{\"success\": true, \"inventory\": payload[\"state\"][\"inventory\"], \"labels\": _expected_labels(names)},\n\t\tbefore, expected, true)\n\tbefore = _snapshot()\n\t_game.call(\"_render_sidebars\")\n\t_record(\"storage/loaded_display_immutable\", _labels(), _expected_labels(names), before, before)\n\nfunc _restore_sandbox_memory() -> void:\n\tLocaleManager.language_changed.disconnect(_on_language)\n\tModLoader.configure_test_roots(str(_baseline_mod_roots[0]), str(_baseline_mod_roots[1]),\n\t\tstr(_baseline_mod_roots[2]), str(_baseline_mod_roots[3]))\n\tSaveManager.set(\"_settings\", (_baseline[\"settings\"] as Dictionary).duplicate(true))\n\tvar path: String = SaveManager.settings_path()\n\tif _baseline[\"settings_raw\"] == null:\n\t\t# This file did not exist in the fresh preautoload namespace.\n\t\tvar absolute: String = ProjectSettings.globalize_path(path).simplify_path()\n\t\tif not absolute.begins_with(OS.get_user_data_dir().simplify_path() + \"/\"):\n\t\t\t_failures.append(\"unsafe settings restore\")\n\t\telif FileAccess.file_exists(path):\n\t\t\tDirAccess.remove_absolute(absolute)\n\telse:\n\t\tvar handle: FileAccess = FileAccess.open(path, FileAccess.WRITE)\n\t\thandle.store_string(str(_baseline[\"settings_raw\"]))\n\t\thandle.close()\n\tModLoader.notify_settings_changed()\n\tLocaleManager.language = str(_baseline[\"language\"]) # teardown restoration, not runtime API coverage\n\tDataRegistry.reload()\n\tGameState.load_from_dict((_baseline[\"game\"] as Dictionary).duplicate(true))\n\tMetaProgression.data = (_baseline[\"meta\"] as Dictionary).duplicate(true)\n\tMetaProgression._new_this_run = (_baseline[\"new_this_run\"] as Dictionary).duplicate(true)\n\t_game.set(\"turn_action_log\", (_baseline[\"turn_log\"] as Array).duplicate(true))\n\tvar before: Dictionary = _snapshot()\n\tvar expected: Dictionary = _baseline.duplicate(true)\n\texpected[\"files\"] = before[\"files\"] # QA-created saves/fixtures are retained, not player storage.\n\texpected[\"revision\"] = before[\"revision\"] # monotonic generation is not rewound.\n\t_record(\"teardown/restored_memory\", [ModLoader._language_root_override, ModLoader._asset_root_override,\n\t\tModLoader._mod_root_override, ModLoader._settings_path_override], _baseline_mod_roots, before, expected)\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n\nfunc _shutdown() -> void:\n\t_game.queue_free()\n\tawait _frames(4)\n\tfor value in get_tree().get_processed_tweens():\n\t\tif value is Tween and value.is_valid():\n\t\t\tvalue.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _run() -> void:\n\tif not FIXTURE_APPROVED or not _isolation():\n\t\tpush_error(\"INVENTORY_NAME_CHECK_FAIL unapproved fixture or isolation\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tawait _frames(3)\n\tGameState.start_new_game(\"QA Custom Player\", \"지방_상경\", \"none\", \"알바\", \"성실런\", \"현실\")\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_base_items = JSON.parse_string(FileAccess.get_file_as_string(\"res://content/items.json\"))\n\tfor locale in [\"ja\", \"zh-CN\", \"zh-TW\"]:\n\t\t_locale_catalogs[locale] = JSON.parse_string(FileAccess.get_file_as_string(\"res://locale/catalog_%s.json\" % locale))\n\t_game = MAIN.instantiate()\n\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\tadd_child(_game)\n\tawait _frames(5)\n\t_panel = _game.get(\"inventory_box\")\n\tLocaleManager.language_changed.connect(_on_language)\n\t_baseline = _snapshot()\n\t_baseline_mod_roots = [ModLoader._language_root_override, ModLoader._asset_root_override,\n\t\tModLoader._mod_root_override, ModLoader._settings_path_override]\n\tfor locale in LOCALES:\n\t\t_locale_groups(locale)\n\t\tawait _frames(1)\n\tvar rows: Array = []\n\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\trows.append({\"id\": row[\"id\"], \"name\": row[\"ko\"], \"quantity\": 2})\n\trows.append({\"id\": \"artifact_sangchul_card\", \"name\": \"My Keepsake\"})\n\trows.append({\"id\": \"qa_unknown_item\", \"name\": \"임상철의 명함\"})\n\trows.append({\"id\": \"artifact_sangchul_card\", \"name\": \"\"})\n\trows.append({\"id\": \"artifact_sangchul_card\", \"name\": 42})\n\trows.append({\"id\": \"artifact_sangchul_card\", \"name\": null})\n\tLocaleManager.set_language(\"ko\")\n\t_inventory(rows)\n\tfor locale in [\"en\", \"ja\", \"zh-CN\", \"zh-TW\", \"ko\", \"ko\"]:\n\t\tvar names: Array = []\n\t\tfor row in FIXED[\"oracles\"][\"artifact_name_rows\"]:\n\t\t\tnames.append(row[\"name_by_locale\"][locale])\n\t\tnames.append_array([\"My Keepsake\", \"임상철의 명함\", \"\", \"42\", str(null)])\n\t\t_switch(locale, \"switch/\" + locale + (\"/same\" if locale == \"ko\" and LocaleManager.language == \"ko\" else \"\"), names)\n\t\tawait _frames(1)\n\t_live_cases()\n\t_preset_cases()\n\t_unknown_preset_case()\n\t_loader_cases()\n\t_save_load()\n\t_restore_sandbox_memory()\n\tawait _shutdown()\n\tfor failure in _failures:\n\t\tpush_error(\"INVENTORY_NAME_CHECK_FAIL \" + str(failure))\n\tif not _failures.is_empty():\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"INVENTORY_NAME_CHECK_OK groups=%d locales=5 same_panel=1 isolation=preautoload rendered=0\" % _ids.size())\n\tget_tree().quit(0)\n"

[node name="InventoryNameLocaleCheck" type="Control"]
script = SubResource("GDScript_inventory")
