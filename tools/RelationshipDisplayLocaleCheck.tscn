[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_check"]
script/source = "extends Node\n## ORDER-239: actual caller component, never a rendered/native/full-play claim.\n## Static pre-edit baseline: bf456ce7016eb98f6b4a90e5b6380d50768221b268a0f82aeafe7bc69a669eef.\n## Reviewed table SHA: 72565027bfb179977687662a908a4923da8310cb2ebbd3670c267e909fb00089 (20 x 5, fixed external authority).\nconst FIXTURE_APPROVED := true\nconst MAIN_GAME := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES := [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst FAMILIES := [\"names14\", \"exact_custom\", \"parents_shared\", \"first_name\",\n\t\"save_language\", \"vip_populated\", \"vip_empty\", \"vip_no_ap\", \"ended\",\n\t\"passive_romantic\", \"passive_mentor\", \"passive_business\", \"passive_family\"]\nconst ROWS := [\n\t{\n\t\t\"ko\": \"가족\",\n\t\t\"en\": \"Family\",\n\t\t\"ja\": \"家族\",\n\t\t\"zh-CN\": \"家人\",\n\t\t\"zh-TW\": \"家人\"\n\t},\n\t{\n\t\t\"ko\": \"강남 인맥\",\n\t\t\"en\": \"Gangnam Contact\",\n\t\t\"ja\": \"カンナムの知り合い\",\n\t\t\"zh-CN\": \"江南人脉\",\n\t\t\"zh-TW\": \"江南人脈\"\n\t},\n\t{\n\t\t\"ko\": \"부모님\",\n\t\t\"en\": \"Parents\",\n\t\t\"ja\": \"両親\",\n\t\t\"zh-CN\": \"父母\",\n\t\t\"zh-TW\": \"父母\"\n\t},\n\t{\n\t\t\"ko\": \"사업 파트너\",\n\t\t\"en\": \"Business Partner\",\n\t\t\"ja\": \"ビジネスパートナー\",\n\t\t\"zh-CN\": \"生意伙伴\",\n\t\t\"zh-TW\": \"事業夥伴\"\n\t},\n\t{\n\t\t\"ko\": \"새벽 통화 친구\",\n\t\t\"en\": \"Late-night Phone Friend\",\n\t\t\"ja\": \"深夜に電話する友人\",\n\t\t\"zh-CN\": \"深夜通话的朋友\",\n\t\t\"zh-TW\": \"深夜通話的朋友\"\n\t},\n\t{\n\t\t\"ko\": \"소개팅 상대\",\n\t\t\"en\": \"Blind Date\",\n\t\t\"ja\": \"紹介された相手\",\n\t\t\"zh-CN\": \"介绍认识的约会对象\",\n\t\t\"zh-TW\": \"介紹認識的約會對象\"\n\t},\n\t{\n\t\t\"ko\": \"썸 상대\",\n\t\t\"en\": \"Romantic Interest\",\n\t\t\"ja\": \"気になる相手\",\n\t\t\"zh-CN\": \"暧昧对象\",\n\t\t\"zh-TW\": \"曖昧對象\"\n\t},\n\t{\n\t\t\"ko\": \"업계 지인\",\n\t\t\"en\": \"Industry Acquaintance\",\n\t\t\"ja\": \"業界の知り合い\",\n\t\t\"zh-CN\": \"业内熟人\",\n\t\t\"zh-TW\": \"業界熟人\"\n\t},\n\t{\n\t\t\"ko\": \"옆방 이웃\",\n\t\t\"en\": \"Next-door Neighbor\",\n\t\t\"ja\": \"隣の部屋の住人\",\n\t\t\"zh-CN\": \"隔壁房间的邻居\",\n\t\t\"zh-TW\": \"隔壁房間的鄰居\"\n\t},\n\t{\n\t\t\"ko\": \"인생 멘토\",\n\t\t\"en\": \"Life Mentor\",\n\t\t\"ja\": \"人生の師\",\n\t\t\"zh-CN\": \"人生导师\",\n\t\t\"zh-TW\": \"人生導師\"\n\t},\n\t{\n\t\t\"ko\": \"전 연인\",\n\t\t\"en\": \"Former Romantic Partner\",\n\t\t\"ja\": \"かつての恋人\",\n\t\t\"zh-CN\": \"前任恋人\",\n\t\t\"zh-TW\": \"前任戀人\"\n\t},\n\t{\n\t\t\"ko\": \"직장 선배\",\n\t\t\"en\": \"Senior Colleague\",\n\t\t\"ja\": \"職場の先輩\",\n\t\t\"zh-CN\": \"职场前辈\",\n\t\t\"zh-TW\": \"職場前輩\"\n\t},\n\t{\n\t\t\"ko\": \"친한 친구\",\n\t\t\"en\": \"Close Friend\",\n\t\t\"ja\": \"親しい友人\",\n\t\t\"zh-CN\": \"好友\",\n\t\t\"zh-TW\": \"好友\"\n\t},\n\t{\n\t\t\"ko\": \"카페 단골 친구\",\n\t\t\"en\": \"Friend at My Usual Café\",\n\t\t\"ja\": \"行きつけのカフェの友人\",\n\t\t\"zh-CN\": \"常去的咖啡店里认识的朋友\",\n\t\t\"zh-TW\": \"常去的咖啡店裡認識的朋友\"\n\t},\n\t{\n\t\t\"ko\": \"%s와의 관계가 끊어졌다.\",\n\t\t\"en\": \"Relationship with %s ended.\",\n\t\t\"ja\": \"%s との関係が断たれた。\",\n\t\t\"zh-CN\": \"与%s的关系断了。\",\n\t\t\"zh-TW\": \"與%s的關係斷了。\"\n\t},\n\t{\n\t\t\"ko\": \"%s: 생활비 분담 효과 +10만원\",\n\t\t\"en\": \"%s: shared living cost effect +100,000 won\",\n\t\t\"ja\": \"%s: 生活費分担効果 +10万ウォン\",\n\t\t\"zh-CN\": \"%s：分担生活费的效果 +10万韩元\",\n\t\t\"zh-TW\": \"%s：分攤生活費的效果 +10萬韓元\"\n\t},\n\t{\n\t\t\"ko\": \"%s 멘토: 투자 인사이트 +20만원 가치\",\n\t\t\"en\": \"%s mentor: investment insight worth 200,000 won\",\n\t\t\"ja\": \"%s メンター: 投資インサイト +20万ウォンの価値\",\n\t\t\"zh-CN\": \"%s导师：投资见解价值 +20万韩元\",\n\t\t\"zh-TW\": \"%s導師：投資見解價值 +20萬韓元\"\n\t},\n\t{\n\t\t\"ko\": \"%s: 비즈니스 파트너 수익 공유 +15만원\",\n\t\t\"en\": \"%s: business partner profit share +150,000 won\",\n\t\t\"ja\": \"%s: ビジネスパートナー利益共有 +15万ウォン\",\n\t\t\"zh-CN\": \"%s：生意伙伴分享收益 +15万韩元\",\n\t\t\"zh-TW\": \"%s：事業夥伴分享收益 +15萬韓元\"\n\t},\n\t{\n\t\t\"ko\": \"%s: 가족 지원금 +30만원\",\n\t\t\"en\": \"%s: family support +300,000 won\",\n\t\t\"ja\": \"%s: 家族支援金 +30万ウォン\",\n\t\t\"zh-CN\": \"%s：家人资助 +30万韩元\",\n\t\t\"zh-TW\": \"%s：家人資助 +30萬韓元\"\n\t},\n\t{\n\t\t\"ko\": \"VIP 모임에서 먼저 이름을 불러 준 사람들이 생겼다. 그 자리에 있던 사람: %s.\",\n\t\t\"en\": \"At the VIP gathering, people began greeting me by name. People there: %s.\",\n\t\t\"ja\": \"VIPの集まりで、先に名前を呼んでくれる人たちが現れた。その場にいた人：%s。\",\n\t\t\"zh-CN\": \"在VIP聚会上，有人开始主动叫我的名字。在场的人：%s。\",\n\t\t\"zh-TW\": \"在VIP聚會上，有人開始主動叫我的名字。在場的人：%s。\"\n\t}\n]\nvar _game: Control\nvar _system: Node\nvar _baseline: Dictionary\nvar _failures: Array[String] = []\nvar _case_count := 0\nvar _reward_seed := -1\nvar _reward_roll := -1.0\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _run() -> void:\n\tif not _isolation() or not FIXTURE_APPROVED or ROWS.size() != 20:\n\t\tpush_error(\"RELATIONSHIP_DISPLAY_CHECK_FAIL isolation or reviewed fixture required\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tEngine.max_fps = 60\n\tawait _frames(3)\n\tGameState.start_new_game(\"QA Custom Player\", \"지방_상경\", \"none\", \"알바\", \"자유런\", \"현실\")\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_game = MAIN_GAME.instantiate() as Control\n\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\tadd_child(_game)\n\tawait _frames(5)\n\t_system = _game.get(\"relationship_system\") as Node\n\tif _system == null or not _system.has_method(\"get_display_name\"):\n\t\t_failures.append(\"actual relationship system display API absent\")\n\telse:\n\t\t_baseline = _state()\n\t\t# Bounded RNG setup, not expected text or product-derived reward behavior.\n\t\t# No frame/signal runs between resetting this seed and _apply_passive.\n\t\tfor candidate in range(32):\n\t\t\tseed(candidate)\n\t\t\tvar roll := randf()\n\t\t\tif roll < 0.10:\n\t\t\t\t_reward_seed = candidate\n\t\t\t\t_reward_roll = roll\n\t\t\t\tbreak\n\t\tprint(\"RELATIONSHIP_QA_RNG \" + JSON.stringify({\n\t\t\t\"candidate_range\": [0, 31], \"seed\": _reward_seed, \"roll\": _reward_roll,\n\t\t\t\"phase\": \"first engine setup; static baseline had no Godot execution\"}))\n\t\tif _reward_seed < 0:\n\t\t\t_failures.append(\"fixed RNG preparation exhausted; no candidate expansion\")\n\t\telse:\n\t\t\tfor locale in LOCALES:\n\t\t\t\t_reset()\n\t\t\t\tLocaleManager.set_language(locale)\n\t\t\t\tawait _frames(2)\n\t\t\t\tawait _names(locale)\n\t\t\t\tawait _custom(locale)\n\t\t\t\tawait _parents(locale)\n\t\t\t\tawait _first_name(locale)\n\t\t\t\tawait _save_language(locale)\n\t\t\t\tawait _vip(locale, \"populated\")\n\t\t\t\tawait _vip(locale, \"empty\")\n\t\t\t\tawait _vip(locale, \"no_ap\")\n\t\t\t\tawait _ended(locale)\n\t\t\t\tfor kind in [\"romantic\", \"mentor\", \"business\", \"family\"]:\n\t\t\t\t\tawait _passive(locale, kind)\n\t\t_restore_baseline()\n\tawait _shutdown()\n\tvar restored: bool = not _baseline.is_empty() and _state() == _baseline\n\tprint(\"RELATIONSHIP_QA_STATE_RESTORED=%d\" % int(restored))\n\tif not restored:\n\t\t_failures.append(\"in-memory pre-fixture GameState not restored\")\n\tif _case_count != 65:\n\t\t_failures.append(\"expected fixed 65 scenario groups, got %d\" % _case_count)\n\tif not _failures.is_empty():\n\t\tfor failure in _failures:\n\t\t\tpush_error(\"RELATIONSHIP_DISPLAY_CHECK_FAIL \" + failure)\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"RELATIONSHIP_DISPLAY_CHECK_OK cases=65 locales=5 names=14 parents=6 isolation=preautoload rendered=0\")\n\tget_tree().quit(0)\n\nfunc _isolation() -> bool:\n\tvar boot := get_tree().get_script() as Script\n\tvar qa_namespace := str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar regex := RegEx.new()\n\tif regex.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\") != OK:\n\t\treturn false\n\tvar valid: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand regex.search(qa_namespace) != null and OS.get_user_data_dir().get_file() == qa_namespace\n\tif valid:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=%s\" % OS.get_user_data_dir())\n\treturn valid\n\nfunc _state() -> Dictionary:\n\treturn GameState.serialize().duplicate(true)\n\nfunc _restore_baseline() -> void:\n\tfor key in _baseline:\n\t\tvar value: Variant = _baseline[key]\n\t\tif value is Dictionary or value is Array:\n\t\t\tvalue = value.duplicate(true)\n\t\tGameState.set(key, value)\n\nfunc _reset() -> void:\n\t_restore_baseline()\n\tGameState.relationships = []\n\tGameState.action_log = [{\"turn\": 1, \"date\": \"fixed historical date\", \"message\": \"친한 친구 — historical 家族\", \"type\": \"relationship\"}]\n\tGameState.money = 400000.0\n\tGameState.mental = 30\n\tGameState.social_skill = 20\n\tGameState.reputation = 20\n\tGameState.investment_skill = 20\n\tGameState.intelligence = 20\n\tGameState.action_points = 1\n\tGameState.max_action_points = 1\n\tGameState.tendency = {\"career\": 0, \"invest\": 0, \"found\": 0}\n\tGameState.action_axis_this_week = {\"money\": 0, \"human\": 0}\n\tGameState.action_places_this_week = {}\n\tGameState.action_records_this_week = []\n\tGameState.recent_action_places = []\n\tif is_instance_valid(_game):\n\t\t_game.set(\"turn_action_log\", [])\n\nfunc _rel(raw_name: String, rel_id: String = \"qa_custom\", kind: String = \"friends\") -> Dictionary:\n\treturn {\"id\": rel_id, \"name\": raw_name, \"type\": kind, \"affection\": 40, \"trust\": 30, \"met_turn\": 1}\n\nfunc _text(index: int, locale: String) -> String:\n\treturn str(ROWS[index][locale])\n\nfunc _projected(raw_name: String, locale: String) -> String:\n\tfor index in range(14):\n\t\tif str(ROWS[index][\"ko\"]) == raw_name:\n\t\t\treturn _text(index, locale)\n\treturn raw_name\n\nfunc _record(locale: String, family: String, actual: Variant, expected: Variant, state_ok: bool, details: Dictionary = {}) -> void:\n\tvar passed: bool = actual == expected and state_ok\n\t_case_count += 1\n\tif not passed:\n\t\t_failures.append(\"%s/%s actual=%s expected=%s state_ok=%s\" % [\n\t\t\tlocale, family, JSON.stringify(actual), JSON.stringify(expected), str(state_ok)])\n\tdetails = details.duplicate(true)\n\tdetails[\"relationships_after\"] = GameState.relationships.duplicate(true)\n\tdetails[\"action_log_after\"] = GameState.action_log.duplicate(true)\n\tdetails[\"state_after_sha256\"] = JSON.stringify(_state()).sha256_text()\n\tprint(\"RELATIONSHIP_DISPLAY_CASE \" + JSON.stringify({\n\t\t\"id\": locale + \"/\" + family, \"actual\": actual, \"expected\": expected,\n\t\t\"pass\": passed, \"state_ok\": state_ok, \"details\": details}))\n\nfunc _unchanged_except(before: Dictionary, allowed: Array) -> bool:\n\tvar after := _state()\n\tfor key in before:\n\t\tif key not in allowed and before[key] != after.get(key):\n\t\t\treturn false\n\treturn true\n\nfunc _old_logs_exact(before: Dictionary) -> bool:\n\treturn GameState.action_log.slice(0, before[\"action_log\"].size()) == before[\"action_log\"]\n\nfunc _messages_since(before: Dictionary) -> Array:\n\tvar messages: Array = []\n\tfor entry in GameState.action_log.slice(before[\"action_log\"].size()):\n\t\tmessages.append(str(entry.get(\"message\", \"\")))\n\treturn messages\n\nfunc _caller_names() -> Array:\n\t_game.call(\"_render_sidebars\")\n\tawait _frames(1)\n\tvar names: Array = []\n\tvar box: VBoxContainer = _game.get(\"relationship_box\")\n\tfor card in box.get_children():\n\t\tif not card is PanelContainer or card.is_queued_for_deletion():\n\t\t\tcontinue\n\t\tvar matching: Array = []\n\t\tfor child in card.find_children(\"*\", \"Label\", true, false):\n\t\t\tif child is Label and child.get_theme_font_size(\"font_size\") == 16:\n\t\t\t\tmatching.append(child.text)\n\t\tif matching.size() != 1:\n\t\t\t_failures.append(\"caller-created name label cardinality=%d\" % matching.size())\n\t\tnames.append(matching[0] if matching.size() == 1 else \"<missing-name-label>\")\n\treturn names\n\nfunc _names(locale: String) -> void:\n\t_reset()\n\tvar expected: Array = []\n\tvar helpers: Array = []\n\tfor index in range(14):\n\t\tGameState.relationships.append(_rel(str(ROWS[index][\"ko\"]), \"qa_%d\" % index))\n\t\texpected.append(_text(index, locale))\n\tvar before := _state()\n\tfor index in range(14):\n\t\thelpers.append(_system.call(\"get_display_name\", str(ROWS[index][\"ko\"])))\n\tvar labels: Array = await _caller_names()\n\t_record(locale, \"names14\", [labels, helpers], [expected, expected], before == _state())\n\nfunc _custom(locale: String) -> void:\n\t_reset()\n\tvar values: Array = [\"Alice\", \"친한 친구 민수\", \" 친한 친구\", \"친한 친구 \", \"Family\", \"\", \"家族\"]\n\tfor index in range(values.size()):\n\t\tGameState.relationships.append(_rel(values[index], \"custom_%d\" % index))\n\tvar missing := _rel(\"placeholder\", \"missing_name\")\n\tmissing.erase(\"name\")\n\tGameState.relationships.append(missing)\n\tvar expected := values.duplicate()\n\texpected.append(\"?\")\n\tvar before := _state()\n\tvar helpers: Array = []\n\tfor value in values:\n\t\thelpers.append(_system.call(\"get_display_name\", value))\n\tvar labels: Array = await _caller_names()\n\t_record(locale, \"exact_custom\", [labels, helpers], [expected, values], before == _state())\n\nfunc _parents(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar same := true\n\tfor passed in [false, true]:\n\t\t_reset()\n\t\tGameState.flags[\"father_passed_away\"] = passed\n\t\tGameState.relationships = [_rel(\"부모님\", \"parents_family\", \"family\"), _rel(\"가족\", \"parents_family\", \"family\")]\n\t\tvar before := _state()\n\t\tactual.append(await _caller_names())\n\t\texpected.append([_projected(\"부모님\", locale), _projected(\"가족\", locale)])\n\t\tsame = same and before == _state()\n\t_record(locale, \"parents_shared\", actual, expected, same, {\"same_id\": \"parents_family\", \"flags\": [false, true]})\n\nfunc _first_name(locale: String) -> void:\n\tvar actual: Array = []\n\tvar expected: Array = []\n\tvar same := true\n\tfor pair in [[\"부모님\", \"가족\"], [\"가족\", \"부모님\"]]:\n\t\t_reset()\n\t\tGameState.apply_relationship_effect({\"id\": \"parents_family\", \"name\": pair[0], \"type\": \"family\", \"affection\": 40, \"trust\": 30})\n\t\tvar first: Dictionary = GameState.relationships[0].duplicate(true)\n\t\tGameState.apply_relationship_effect({\"id\": \"parents_family\", \"name\": pair[1], \"type\": \"family\", \"affection\": 5, \"trust\": 7})\n\t\tvar preserved := first.duplicate(true)\n\t\tpreserved[\"affection\"] = 45\n\t\tpreserved[\"trust\"] = 37\n\t\tsame = same and GameState.relationships == [preserved]\n\t\tactual.append(await _caller_names())\n\t\texpected.append([_projected(pair[0], locale)])\n\t_record(locale, \"first_name\", actual, expected, same)\n\nfunc _save_language(locale: String) -> void:\n\t_reset()\n\tGameState.relationships = [_rel(\"가족\", \"parents_family\", \"family\"), _rel(\"Alice\", \"custom\")]\n\tvar original := _state()\n\tvar payload: Variant = JSON.parse_string(JSON.stringify(original))\n\t# JSON transport represents all numbers as floats. Preserve the exact parsed\n\t# payload, not pre-serialization Variant number types; no value is discarded.\n\tvar saved_relations: Array = (payload[\"relationships\"] as Array).duplicate(true)\n\tvar saved_logs: Array = (payload[\"action_log\"] as Array).duplicate(true)\n\tGameState.load_from_dict(payload)\n\tvar retained: bool = GameState.relationships == saved_relations \\\n\t\tand GameState.action_log == saved_logs and GameState.player_name == \"QA Custom Player\"\n\tvar alternate := \"en\" if locale == \"ko\" else \"ko\"\n\tLocaleManager.set_language(alternate)\n\tawait _frames(1)\n\tvar other_names: Array = await _caller_names()\n\tLocaleManager.set_language(locale)\n\tawait _frames(1)\n\tvar current_names: Array = await _caller_names()\n\tretained = retained and GameState.relationships == saved_relations \\\n\t\tand GameState.action_log == saved_logs and GameState.player_name == \"QA Custom Player\"\n\t_record(locale, \"save_language\", [other_names, current_names],\n\t\t[[_projected(\"가족\", alternate), \"Alice\"], [_projected(\"가족\", locale), \"Alice\"]], retained,\n\t\t{\"disk_save_calls\": 0, \"scope\": \"in-memory relationship/log/name roundtrip, not all legacy migrations\",\n\t\t\"player_name_after\": GameState.player_name, \"saved_relations_expected\": saved_relations,\n\t\t\"saved_logs_expected\": saved_logs, \"source_name_id_order\": original[\"relationships\"]})\n\nfunc _vip(locale: String, mode: String) -> void:\n\t_reset()\n\tif mode != \"empty\":\n\t\tGameState.relationships = [_rel(\"친한 친구\", \"close_friend\"), _rel(\"가족\", \"parents_family\", \"family\"),\n\t\t\t_rel(\"Alice\", \"custom\"), _rel(\"강남 인맥\", \"fourth_hidden\", \"business\")]\n\tif mode == \"no_ap\":\n\t\tGameState.action_points = 0\n\tvar before := _state()\n\tvar expected: Array = []\n\tif mode == \"populated\":\n\t\texpected.append(_text(19, locale) % \" · \".join([\n\t\t\t_projected(\"친한 친구\", locale), _projected(\"가족\", locale), \"Alice\"]))\n\telif mode == \"empty\":\n\t\t# Outside selected translation scope; preserve the existing literal caller template.\n\t\texpected.append(LocaleManager.ui(\n\t\t\t\"VIP 모임의 낯선 얼굴들 사이에서 먼저 인사를 건넸다. 떠날 때 한 사람이 다음 약속을 물었다.\",\n\t\t\t\"Among unfamiliar faces at the VIP gathering, I introduced myself first. As I left, one person asked about meeting again.\"))\n\t_game.call(\"_ap_vip_network\")\n\tawait _frames(1)\n\tvar same: bool = before == _state()\n\tif mode != \"no_ap\":\n\t\tvar expected_relations: Array = before[\"relationships\"].duplicate(true)\n\t\tfor rel in expected_relations:\n\t\t\trel[\"affection\"] = 55\n\t\t\trel[\"trust\"] = 38\n\t\tvar expected_state := before.duplicate(true)\n\t\texpected_state[\"relationships\"] = expected_relations\n\t\texpected_state[\"action_points\"] = 0\n\t\texpected_state[\"social_skill\"] = 23\n\t\texpected_state[\"reputation\"] = 22\n\t\texpected_state[\"tendency\"] = {\"career\": 4, \"invest\": 0, \"found\": 0}\n\t\texpected_state[\"action_axis_this_week\"] = {\"money\": 1, \"human\": 0}\n\t\texpected_state[\"action_places_this_week\"] = {\"city\": {\"count\": 1, \"money\": 1, \"human\": 0}}\n\t\texpected_state[\"recent_action_places\"] = [\"city\"]\n\t\texpected_state[\"action_records_this_week\"] = [{\"id\": \"vip_network\", \"axis\": \"money\",\n\t\t\t\"place\": \"city\", \"subject\": \"\", \"families\": [\"social\", \"network\", \"career\"]}]\n\t\texpected_state[\"action_log\"] = GameState.action_log.duplicate(true)\n\t\tsame = _state() == expected_state and _old_logs_exact(before)\n\t_record(locale, \"vip_\" + mode, _messages_since(before), expected, same,\n\t\t{\"actual_caller\": \"_ap_vip_network\", \"names_limit\": 3, \"empty_prose_translation_out_of_scope\": mode == \"empty\"})\n\nfunc _ended(locale: String) -> void:\n\t_reset()\n\tvar rel := _rel(\"친한 친구\", \"close_friend\")\n\trel[\"affection\"] = 1\n\trel[\"trust\"] = 1\n\tGameState.relationships = [rel]\n\tvar before := _state()\n\t_system.call(\"process_monthly_relationships\")\n\tvar same: bool = GameState.relationships.is_empty() and _old_logs_exact(before) \\\n\t\tand _unchanged_except(before, [\"relationships\", \"action_log\"])\n\t_record(locale, \"ended\", _messages_since(before), [_text(14, locale) % _projected(\"친한 친구\", locale)], same)\n\nfunc _passive(locale: String, kind: String) -> void:\n\t_reset()\n\tvar name_by_kind := {\"romantic\": \"썸 상대\", \"mentor\": \"인생 멘토\", \"business\": \"사업 파트너\", \"family\": \"가족\"}\n\tvar index_by_kind := {\"romantic\": 15, \"mentor\": 16, \"business\": 17, \"family\": 18}\n\tvar reward_by_kind := {\"romantic\": 100000.0, \"mentor\": 200000.0, \"business\": 150000.0, \"family\": 300000.0}\n\tvar rel := _rel(name_by_kind[kind], \"passive_\" + kind, kind)\n\trel[\"affection\"] = 90\n\trel[\"trust\"] = 80\n\tGameState.relationships = [rel]\n\tvar before := _state()\n\tseed(_reward_seed)\n\t_system.call(\"_apply_passive\", GameState.relationships[0])\n\tvar expected_state := before.duplicate(true)\n\texpected_state[\"money\"] = 400000.0 + reward_by_kind[kind]\n\tmatch kind:\n\t\t\"romantic\": expected_state[\"mental\"] = 36\n\t\t\"mentor\":\n\t\t\texpected_state[\"investment_skill\"] = 21\n\t\t\texpected_state[\"intelligence\"] = 21\n\t\t\"business\": expected_state[\"reputation\"] = 22\n\t\t\"family\": expected_state[\"mental\"] = 34\n\tvar after := _state()\n\texpected_state[\"action_log\"] = after[\"action_log\"]\n\tvar same: bool = after == expected_state and _old_logs_exact(before)\n\t_record(locale, \"passive_\" + kind, _messages_since(before),\n\t\t[_text(index_by_kind[kind], locale) % _projected(name_by_kind[kind], locale)], same,\n\t\t{\"actual_caller\": \"_apply_passive\", \"seed\": _reward_seed, \"first_roll\": _reward_roll})\n\nfunc _frames(count: int) -> void:\n\tfor _index in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _shutdown() -> void:\n\tif is_instance_valid(_game):\n\t\t_game.queue_free()\n\t\tawait _frames(4)\n\tfor value in get_tree().get_processed_tweens():\n\t\tif value is Tween and value.is_valid():\n\t\t\tvalue.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n"

