[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_gift_caption"]
script/source = "extends Node\n# ORDER-262 frozen10 plan: 6c942aa32636e06f8d874cb80610ae03ee66aae85d61020798b6d6877b0a64ce.\n# Existing260 literals; no runtime output or translation API supplies expected text.\nconst FIXTURE_APPROVED := true\nconst MAIN := preload(\"res://scenes/MainGame.tscn\")\nconst LOCALES := [\"ko\", \"en\", \"ja\", \"zh-CN\", \"zh-TW\"]\nconst GIFT := [\"선물\", \"Gift\", \"贈り物\", \"礼物\", \"禮物\"]\nconst USE := [\"사용 AP 1\", \"Use AP 1\", \"消費AP 1\", \"使用 AP 1\", \"使用 AP 1\"]\nconst QUANTITY := [\"%s · %d개\", \"%s · %d held\", \"%s · %d個所持\", \"%s · %d个\", \"%s · %d個\"]\nconst GIFTS := [\n\t{\"id\": \"gift_can_coffee\", \"names\": [\"캔커피 세트\", \"Canned Coffee Set\", \"缶コーヒーセット\", \"罐装咖啡套装\", \"罐裝咖啡組\"]},\n\t{\"id\": \"gift_socks\", \"names\": [\"양말 세트\", \"Sock Set\", \"靴下セット\", \"袜子套装\", \"襪子組\"]},\n\t{\"id\": \"gift_essay_book\", \"names\": [\"에세이집\", \"Essay Collection\", \"エッセイ集\", \"随笔集\", \"散文集\"]},\n\t{\"id\": \"gift_exhibit_catalog\", \"names\": [\"전시 도록\", \"Exhibition Catalogue\", \"展示図録\", \"展览图录\", \"展覽圖錄\"]},\n\t{\"id\": \"gift_scarf\", \"names\": [\"목도리\", \"Wool Scarf\", \"マフラー\", \"围巾\", \"圍巾\"]},\n\t{\"id\": \"gift_perfume\", \"names\": [\"향수\", \"Perfume\", \"香水\", \"香水\", \"香水\"]},\n\t{\"id\": \"gift_wallet\", \"names\": [\"브랜드 지갑\", \"Designer Wallet\", \"ブランド財布\", \"品牌钱包\", \"名牌皮夾\"]},\n\t{\"id\": \"gift_necklace\", \"names\": [\"목걸이\", \"Necklace\", \"ネックレス\", \"项链\", \"項鍊\"]},\n]\nconst UNKNOWN_ID := \"qa_caption_unknown_gift\"\nconst EFFECT_ID := \"qa_caption_effectful_gift\"\n\nvar _game: Control\nvar _panel: Node\nvar _panel_id: int = 0\nvar _failures: Array = []\nvar _ids: Array = []\nvar _io_errors: Array = []\nvar _connections: Array = []\n\nfunc _ready() -> void:\n\tcall_deferred(\"_run\")\n\nfunc _frames(count: int) -> void:\n\tfor _i in range(count):\n\t\tawait get_tree().process_frame\n\nfunc _exact(a: Variant, b: Variant) -> bool:\n\tif typeof(a) != typeof(b):\n\t\treturn false\n\tif a is Dictionary:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor key in a:\n\t\t\tif not b.has(key) or not _exact(a[key], b[key]):\n\t\t\t\treturn false\n\t\treturn true\n\tif a is Array:\n\t\tif a.size() != b.size():\n\t\t\treturn false\n\t\tfor i in range(a.size()):\n\t\t\tif not _exact(a[i], b[i]):\n\t\t\t\treturn false\n\t\treturn true\n\treturn a == b\n\nfunc _isolation() -> bool:\n\tvar boot: Script = get_tree().get_script()\n\tvar name: String = str(ProjectSettings.get_setting(\"application/config/custom_user_dir_name\", \"\"))\n\tvar pattern := RegEx.new()\n\tpattern.compile(\"^GangnamDream_StoryNameplateQA_[0-9a-f]{32}$\")\n\tvar ok: bool = boot != null and boot.resource_path == \"res://tools/StoryNameplateBootstrap.gd\" \\\n\t\tand bool(ProjectSettings.get_setting(\"application/config/use_custom_user_dir\", false)) \\\n\t\tand pattern.search(name) != null and OS.get_user_data_dir().get_file() == name\n\tif ok:\n\t\tprint(\"STORY_NAMEPLATE_QA_USER_DIR=\" + OS.get_user_data_dir())\n\treturn ok\n\nfunc _files(path: String = \"user://\") -> Dictionary:\n\t# Every user file, INCLUDING settings, is compared as original bytes.\n\tvar found: Dictionary = {}\n\tvar directory: DirAccess = DirAccess.open(path)\n\tif directory == null:\n\t\t_io_errors.append(\"directory unreadable: \" + path)\n\t\treturn found\n\tfor filename in directory.get_files():\n\t\tvar item_path: String = path.path_join(filename)\n\t\tvar handle: FileAccess = FileAccess.open(item_path, FileAccess.READ)\n\t\tif handle == null:\n\t\t\t_io_errors.append(\"file unreadable: \" + item_path)\n\t\t\tcontinue\n\t\tvar length: int = handle.get_length()\n\t\tvar raw: PackedByteArray = handle.get_buffer(length)\n\t\thandle.close()\n\t\tif raw.size() != length:\n\t\t\t_io_errors.append(\"short read: \" + item_path)\n\t\tfound[item_path] = raw.hex_encode()\n\tfor child in directory.get_directories():\n\t\tfound.merge(_files(path.path_join(child)))\n\treturn found\n\nfunc _snapshot() -> Dictionary:\n\tvar builtin: Array = LocaleManager._builtin_ui_tables.keys()\n\tvar community: Array = LocaleManager._community_ui_tables.keys()\n\tbuiltin.sort()\n\tcommunity.sort()\n\treturn {\n\t\t\"game\": GameState.serialize().duplicate(true),\n\t\t\"inventory\": GameState.inventory.duplicate(true), \"player\": GameState.player_name,\n\t\t\"meta\": MetaProgression.data.duplicate(true),\n\t\t\"new_this_run\": MetaProgression._new_this_run.duplicate(true),\n\t\t\"turn_log\": _game.get(\"turn_action_log\").duplicate(true),\n\t\t\"registry\": DataRegistry.items.duplicate(true),\n\t\t\"registry_index\": DataRegistry.items_by_id.duplicate(true),\n\t\t\"registry_revision\": DataRegistry.content_revision,\n\t\t\"language\": LocaleManager.language, \"locale_revision\": LocaleManager.content_revision,\n\t\t\"locale_cache_keys\": {\"builtin\": builtin, \"community\": community},\n\t\t\"settings\": (SaveManager.get(\"_settings\") as Dictionary).duplicate(true),\n\t\t\"files\": _files(),\n\t}\n\nfunc _inventory_input() -> Array:\n\tvar rows: Array = []\n\tfor gift in GIFTS:\n\t\trows.append({\"id\": gift[\"id\"], \"name\": \"Stored gift custom\", \"category\": \"gift\",\n\t\t\t\"quantity\": 2, \"effects\": {}})\n\trows.append({\"id\": UNKNOWN_ID, \"name\": \"My Unknown Gift\", \"category\": \"gift\",\n\t\t\"quantity\": 3, \"effects\": {}})\n\trows.append({\"id\": EFFECT_ID, \"name\": \"My Effectful Gift\", \"category\": \"gift\",\n\t\t\"quantity\": 4, \"effects\": {\"health\": 1}})\n\treturn rows\n\nfunc _card_observed(card: Node, index: int) -> Dictionary:\n\tif not card is PanelContainer or card.get_child_count() != 1:\n\t\treturn {\"structure_error\": \"card\", \"index\": index, \"class\": card.get_class()}\n\tvar box: Node = card.get_child(0)\n\tif not box is VBoxContainer or box.get_child_count() != 1:\n\t\treturn {\"structure_error\": \"box\", \"index\": index}\n\tvar row: Node = box.get_child(0)\n\tif not row is HBoxContainer or row.get_child_count() < 1:\n\t\treturn {\"structure_error\": \"row\", \"index\": index}\n\tvar content: Node = row.get_children().back()\n\tif not content is VBoxContainer or content.get_child_count() != 2:\n\t\treturn {\"structure_error\": \"content\", \"index\": index, \"children\": content.get_child_count()}\n\tvar title: Node = content.get_child(0)\n\tvar detail: Node = content.get_child(1)\n\tif not title is Label or (not detail is Label and not detail is Button):\n\t\treturn {\"structure_error\": \"title/detail\", \"index\": index}\n\tvar button_count: int = 0\n\tvar label_count: int = 0\n\tfor child in content.get_children():\n\t\tif child is Button:\n\t\t\tbutton_count += 1\n\t\tif child is Label:\n\t\t\tlabel_count += 1\n\tvar result: Dictionary = {\"title\": str(title.get(\"text\")), \"detail_class\": detail.get_class(),\n\t\t\"detail\": str(detail.get(\"text\")), \"children\": content.get_child_count(),\n\t\t\"buttons\": button_count, \"labels\": label_count, \"disabled\": null,\n\t\t\"pressed_count\": 0, \"use_connections\": [], \"forbidden_connections\": 0}\n\tif detail is Button:\n\t\tresult[\"disabled\"] = detail.disabled\n\t\tvar use_connections: Array = []\n\t\tvar forbidden: int = 0\n\t\tvar raw_connections: Array = []\n\t\tfor connection in detail.pressed.get_connections():\n\t\t\tvar callback: Callable = connection[\"callable\"]\n\t\t\tvar target: Object = callback.get_object()\n\t\t\tvar method: String = str(callback.get_method())\n\t\t\tvar evidence: Dictionary = {\"target_id\": target.get_instance_id() if is_instance_valid(target) else 0,\n\t\t\t\t\"method\": method, \"bound_arguments\": callback.get_bound_arguments(),\n\t\t\t\t\"flags\": int(connection[\"flags\"])}\n\t\t\traw_connections.append(evidence)\n\t\t\tif method == \"_on_use_item\":\n\t\t\t\tuse_connections.append(evidence.duplicate(true))\n\t\t\tif method in [\"_open_cat_people\", \"_open_gift_picker\", \"_ap_give_gift\"]:\n\t\t\t\tforbidden += 1\n\t\tresult[\"pressed_count\"] = raw_connections.size()\n\t\tresult[\"use_connections\"] = use_connections\n\t\tresult[\"forbidden_connections\"] = forbidden\n\t\t# _small_button also connects an existing audio lambda. Capture it raw;\n\t\t# do not invent its generated method name or emit any pressed signal.\n\t\t_connections.append({\"card_index\": index, \"pressed\": raw_connections})\n\treturn result\n\nfunc _observed() -> Dictionary:\n\tvar live: Array = _panel.get_children().filter(func(child: Node): return not child.is_queued_for_deletion())\n\tvar cards: Array = []\n\tfor i in range(1, live.size()):\n\t\tcards.append(_card_observed(live[i], i - 1))\n\treturn {\"panel_id\": _game.get(\"inventory_box\").get_instance_id(),\n\t\t\"header_class\": live[0].get_class() if not live.is_empty() else \"<missing>\",\n\t\t\"live_children\": live.size(), \"cards\": cards}\n\nfunc _expected(locale_index: int, ap: int) -> Dictionary:\n\tvar cards: Array = []\n\tfor i in range(10):\n\t\tvar name: String = str(GIFTS[i][\"names\"][locale_index]) if i < 8 else str(GIFT[locale_index])\n\t\tvar quantity: int = 2 if i < 8 else (3 if i == 8 else 4)\n\t\tvar effectful: bool = i == 9\n\t\tcards.append({\"title\": str(QUANTITY[locale_index]) % [name, quantity],\n\t\t\t\"detail_class\": \"Button\" if effectful else \"Label\",\n\t\t\t\"detail\": USE[locale_index] if effectful else GIFT[locale_index],\n\t\t\t\"children\": 2, \"buttons\": 1 if effectful else 0, \"labels\": 1 if effectful else 2,\n\t\t\t\"disabled\": ap <= 0 if effectful else null,\n\t\t\t\"pressed_count\": 2 if effectful else 0,\n\t\t\t\"use_connections\": [{\"target_id\": _game.get_instance_id(), \"method\": \"_on_use_item\",\n\t\t\t\t\"bound_arguments\": [EFFECT_ID], \"flags\": 0}] if effectful else [],\n\t\t\t\"forbidden_connections\": 0})\n\treturn {\"panel_id\": _panel_id, \"header_class\": \"Label\", \"live_children\": 11, \"cards\": cards}\n\nfunc _case(locale_index: int, ap: int) -> void:\n\tGameState.inventory = _inventory_input()\n\tGameState.action_points = ap\n\t_connections.clear()\n\tvar before: Dictionary = _snapshot()\n\tvar expected_state: Dictionary = before.duplicate(true)\n\tvar expected: Dictionary = _expected(locale_index, ap)\n\t_game.call(\"_render_sidebars\")\n\tvar actual: Dictionary = _observed()\n\tvar after: Dictionary = _snapshot()\n\tvar state_ok: bool = _exact(after, expected_state)\n\tvar display_ok: bool = _exact(actual, expected)\n\tvar id: String = str(LOCALES[locale_index]) + \"/ap\" + str(ap)\n\tvar ok: bool = state_ok and display_ok and _io_errors.is_empty()\n\t_ids.append(id)\n\tif not ok:\n\t\t_failures.append(id)\n\tprint(\"GIFT_CAPTION_CASE \" + JSON.stringify({\"id\": id, \"pass\": ok, \"state_ok\": state_ok,\n\t\t\"display_ok\": display_ok, \"typed_state_exact\": state_ok,\n\t\t\"actual\": actual, \"expected\": expected, \"connections_raw\": _connections,\n\t\t\"state\": {\"before\": before, \"expected\": expected_state, \"after\": after},\n\t\t\"io_errors\": _io_errors.duplicate(),\n\t\t\"boundary\": \"locale/setup completed before snapshot; one manual render, no button press or signal-immediacy claim\"}))\n\nfunc _detach_audio(node: Node) -> void:\n\tif node is AudioStreamPlayer or node is AudioStreamPlayer2D:\n\t\tnode.stop()\n\t\tnode.stream = null\n\tfor child in node.get_children():\n\t\t_detach_audio(child)\n\nfunc _shutdown() -> void:\n\t_game.queue_free()\n\tawait _frames(4)\n\tfor value in get_tree().get_processed_tweens():\n\t\tif value is Tween and value.is_valid():\n\t\t\tvalue.kill()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tfor player in AudioManager._pool:\n\t\tif player is AudioStreamPlayer:\n\t\t\tplayer.stop()\n\t\t\tplayer.stream = null\n\tAudioManager._sounds.clear()\n\tawait AudioManager.drain_pending_timers_for_exit()\n\tBGMPlayer.stop()\n\t_detach_audio(get_tree().root)\n\tawait _frames(8)\n\nfunc _run() -> void:\n\tif not FIXTURE_APPROVED or not _isolation():\n\t\tpush_error(\"GIFT_CAPTION_CHECK_FAIL unapproved fixture or isolation\")\n\t\tget_tree().quit(1)\n\t\treturn\n\tawait _frames(3)\n\tGameState.start_new_game(\"QA Custom Player\", \"지방_상경\", \"none\", \"알바\", \"성실런\", \"현실\")\n\tGameState.flags[\"prologue_done\"] = true\n\tGameState.flags[\"story_flashforward_seen\"] = true\n\tGameState.flags[\"tutorial_shown\"] = true\n\tGameState.pending_story_queue.clear()\n\tEventManager.current_event = {}\n\t_game = MAIN.instantiate()\n\t_game.set_meta(\"_screenshot_qa_static_surface\", true)\n\tadd_child(_game)\n\tawait _frames(5)\n\t_panel = _game.get(\"inventory_box\")\n\t_panel_id = _panel.get_instance_id()\n\tfor gift in GIFTS:\n\t\tvar catalog: Dictionary = DataRegistry.get_item(str(gift[\"id\"]))\n\t\tif catalog.is_empty() or str(catalog.get(\"category\", \"\")) != \"gift\" or not catalog.get(\"effects\", {}).is_empty():\n\t\t\t_failures.append(\"builtin gift precondition: \" + str(gift[\"id\"]))\n\tfor id in [UNKNOWN_ID, EFFECT_ID]:\n\t\tif not DataRegistry.get_item(id).is_empty() or not ImageRegistry.get_item_art(id).is_empty():\n\t\t\t_failures.append(\"custom ID precondition: \" + str(id))\n\tprint(\"GIFT_CAPTION_SETUP \" + JSON.stringify({\"precondition_errors\": _failures.duplicate(),\n\t\t\"panel_id\": _panel_id, \"builtin_ids\": GIFTS.map(func(row: Dictionary): return row[\"id\"]),\n\t\t\"unknown_ids\": [UNKNOWN_ID, EFFECT_ID], \"input_inventory\": _inventory_input()}))\n\tfor locale_index in range(LOCALES.size()):\n\t\t# This real API/setup happens OUTSIDE each measured render. It may write\n\t\t# settings, emit refresh and reload data. Do not count it as unchanged.\n\t\tLocaleManager.set_language(str(LOCALES[locale_index]))\n\t\tawait _frames(1)\n\t\tfor ap in [1, 0]:\n\t\t\t_case(locale_index, ap)\n\t\t\tawait _frames(1)\n\tawait _shutdown()\n\tfor failure in _failures:\n\t\tpush_error(\"GIFT_CAPTION_CHECK_FAIL \" + str(failure))\n\tif not _failures.is_empty() or not _io_errors.is_empty():\n\t\tget_tree().quit(1)\n\t\treturn\n\tprint(\"GIFT_CAPTION_CHECK_OK groups=10 locales=5 cards=100 captions=90 use_buttons=10 same_panel=1 isolation=preautoload rendered=0\")\n\tget_tree().quit(0)\n"

[node name="GiftCaptionLocaleCheck" type="Node"]
script = SubResource("GDScript_gift_caption")
