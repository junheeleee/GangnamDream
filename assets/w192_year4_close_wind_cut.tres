metadata/arc_year4_close = {
"ko": "옥상 문을 닫자 바람 소리가 끊겼다.",
"en": "The wind stopped when the rooftop door closed.",
"ja": "屋上のドアを閉めると、風の音が途切れた。",
"zh-CN": "关上天台门，风声断了。",
"zh-TW": "關上屋頂的門，風聲便斷了。"
}
